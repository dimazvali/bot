doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0, maximum-scale=1.0')
    title Список гостей — #{article.title_ru || article.title_en || 'Событие'}
    style.
      * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
      body { font-family: Georgia, 'Times New Roman', serif; color: #1C2E4A; margin: 0; padding: 1.5rem; }
      .toolbar { margin-bottom: 1.25rem; display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
      .toolbar button {
        font-family: system-ui, sans-serif; font-size: 0.85rem; padding: 0.6rem 1.25rem;
        background: #1C2E4A; color: #fff; border: none; border-radius: 4px; cursor: pointer;
      }
      .toolbar .count {
        font-family: system-ui, sans-serif; font-size: 0.85rem; color: #555; margin-left: auto;
      }
      h1 { font-size: 1.4rem; margin: 0 0 0.25rem; }
      .meta { font-size: 0.9rem; color: #555; margin-bottom: 1.5rem; }
      table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
      th, td { border: 1px solid #ccc; padding: 0.5rem 0.6rem; text-align: left; vertical-align: middle; }
      th { background: #f3ece0; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
      td.num { width: 2.5rem; color: #999; }
      td.check { width: 3.5rem; text-align: center; padding: 0; }
      tr.reg-row { cursor: pointer; }
      tr.reg-row:active { background: #f3ece0; }
      tr.reg-row.checked-in { background: #eaf3ea; }
      tr.reg-row.checked-in td { color: #5a8a5a; }
      tr.reg-row.checked-in .status { color: inherit; }
      .check-box {
        display: flex; align-items: center; justify-content: center;
        width: 100%; height: 44px;
      }
      .check-box::before {
        content: ''; display: inline-block; width: 22px; height: 22px;
        border: 1.5px solid #1C2E4A; border-radius: 3px; background: #fff;
      }
      .checked-in .check-box::before {
        content: '✓'; color: #fff; background: #4a8a4a; border-color: #4a8a4a;
        display: flex; align-items: center; justify-content: center; font-size: 15px; line-height: 1;
      }
      .status { font-size: 0.78rem; }
      .status-declined { color: #B25B3C; text-decoration: line-through; }
      .empty { color: #999; font-style: italic; }
      @media (max-width: 600px) {
        body { padding: 0.75rem; font-size: 0.9rem; }
        h1 { font-size: 1.15rem; }
        .meta { font-size: 0.8rem; margin-bottom: 1rem; }
        table { font-size: 0.85rem; }
        th, td { padding: 0.5rem 0.4rem; }
        th:nth-child(4), td:nth-child(4) { display: none; }
        td.num { width: 1.8rem; }
        td.check { width: 3rem; }
      }
      @media print {
        body { padding: 0.5cm; }
        .toolbar { display: none; }
        table { font-size: 0.9rem; }
        tr.reg-row.checked-in { background: none; }
        tr.reg-row.checked-in td { color: inherit; }
        .checked-in .check-box::before { content: ''; background: #fff; color: inherit; border-color: #1C2E4A; }
      }
  body
    .toolbar
      button(type='button' onclick='window.print()') Печать
      span.count#checkin-count
    h1 #{article.title_ru || article.title_en || 'Событие'}
    - var totalGuests = registrations.reduce(function(sum, r){ return r.status !== 'declined' ? sum + (r.guests || 1) : sum; }, 0)
    .meta
      if article.event_date
        | #{new Date(article.event_date.toDate ? article.event_date.toDate() : article.event_date).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })} ·
      |  Записей: #{registrations.length} · Гостей: #{totalGuests}
      if article.capacity
        |  из #{article.capacity}

    if !registrations.length
      p.empty Регистраций пока нет.
    else
      table
        thead
          tr
            th #
            th Имя
            th Гостей
            th Контакт
            th Статус
            th Пришли
        tbody
          each r, i in registrations
            tr.reg-row(class=r.checked_in ? 'checked-in' : '' data-id=r.id)
              td.num #{i + 1}
              td #{r.name}
              td(style='text-align:center') #{r.guests || 1}
              td
                div #{r.email}
                if r.phone
                  div #{r.phone}
              td
                span.status(class=r.status === 'declined' ? 'status-declined' : '')
                  case r.status
                    when 'confirmed'
                      | Подтверждена
                    when 'declined'
                      | Отклонена
                    default
                      | Новая
              td.check
                span.check-box

    script.
      (function () {
        var rows = document.querySelectorAll('tr.reg-row');
        var countEl = document.getElementById('checkin-count');

        function updateCount() {
          var total = rows.length;
          var checked = document.querySelectorAll('tr.reg-row.checked-in').length;
          if (countEl) countEl.textContent = 'Отмечено: ' + checked + ' из ' + total;
        }

        rows.forEach(function (row) {
          row.addEventListener('click', function () {
            var id = row.getAttribute('data-id');
            var next = !row.classList.contains('checked-in');
            row.classList.toggle('checked-in', next);
            updateCount();
            fetch('/admin/registrations/' + id + '/checkin', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ checked_in: next }),
            }).then(function (res) {
              if (!res.ok) throw new Error('bad status');
            }).catch(function () {
              row.classList.toggle('checked-in', !next);
              updateCount();
              alert('Не удалось сохранить отметку. Проверьте соединение и попробуйте снова.');
            });
          });
        });

        updateCount();
      })();
