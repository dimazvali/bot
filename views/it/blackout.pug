doctype html
html(lang=ui.htmlLang)
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1, maximum-scale=1')
    title= ui.title
    meta(name='description' content=ui.description)
    meta(property='og:title' content=ui.ogTitle)
    meta(property='og:description' content=ui.ogDescription)
    link(rel='canonical' href='https://it.dimazvali.com/blackout?lang=' + lang)
    link(rel='alternate' hreflang='ru' href='https://it.dimazvali.com/blackout?lang=ru')
    link(rel='alternate' hreflang='en' href='https://it.dimazvali.com/blackout?lang=en')
    link(rel='alternate' hreflang='x-default' href='https://it.dimazvali.com/blackout')
    link(rel='icon' type='image/x-icon' href='/images/dimazvali/favicon.ico')
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Noto+Sans+Georgian:wght@800&family=Lora:ital,wght@1,500;1,600&family=JetBrains+Mono:wght@400;700&display=swap' rel='stylesheet')
    script(async src='https://www.googletagmanager.com/gtag/js?id=G-LDMN4XFB42')
    script.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LDMN4XFB42');
    style.
      :root {
        --paper: #f4f1ea; --ink: #15120f; --muted: #56514a; --faint: #9a948b; --line: #c8c3b8;
        --land: #ebe3cf; --land-hover: #e0d6bd;
        --light: #15120f; --light-glow: #f2c230; --light-ico: #e3a300;
        --water: #3f7fd6; --gas: #e2632b; --bad: #c9302c;
        --topo: #9a8a6c; --topo-ink: #6f604a; --river: #8fb3d6; --river-ink: #4f7aa6; --lake: #c4d8ea;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; }
      body { background: var(--paper); color: var(--ink); font-family: 'JetBrains Mono', monospace; overflow: hidden;
        display: flex; flex-direction: column; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
      a { color: inherit; text-decoration: none; }
      header { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 14px 16px 0; }
      .logo { font-family: Oswald, sans-serif; font-weight: 700; font-size: 17px; }
      .back { font-size: 12px; letter-spacing: .08em; color: var(--muted); }
      .hud { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 22px; padding: 10px 16px; font-size: 12px; letter-spacing: .08em; color: var(--muted); text-transform: uppercase; }
      .hud b { font-family: Oswald, sans-serif; font-size: 26px; color: var(--ink); letter-spacing: 0; margin-left: 6px; vertical-align: -3px; font-variant-numeric: tabular-nums; }
      .lives { display: inline-flex; gap: 4px; margin-left: 6px; vertical-align: -2px; }
      .lives i { width: 12px; height: 12px; border-radius: 50%; background: var(--ink); transition: background .2s, transform .2s; }
      .lives i.off { background: var(--line); transform: scale(.7); }
      .combo { color: var(--gas); font-weight: 700; min-width: 4ch; }
      main { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; padding: 0 8px; }
      svg.map { width: 100%; height: 100%; max-width: 1100px; display: block; overflow: visible; }
      .district { fill: var(--land); stroke: var(--paper); stroke-width: 3; stroke-linejoin: round; cursor: pointer; transition: fill .25s; }
      .district:hover { fill: var(--land-hover); }
      .district.light { fill: var(--light); }
      .district.water { fill: var(--water); }
      .district.gas { fill: var(--gas); }
      .district.missed { animation: missed .6s; }
      @keyframes missed { 0%, 100% { filter: none; } 30% { fill: var(--bad); } }
      .district.fixed { animation: fixed .45s; }
      @keyframes fixed { 0% { fill: #fff; } }
      .label { font-family: 'JetBrains Mono', monospace; font-size: 15px; font-weight: 700; fill: var(--ink); text-anchor: middle; pointer-events: none;
        letter-spacing: .14em; text-transform: uppercase; paint-order: stroke; stroke: var(--land); stroke-width: 4px; stroke-linejoin: round; transition: fill .25s, stroke .25s; }
      .label.on { fill: var(--paper); stroke: var(--ink); }
      /* topography: old-map style, never intercepts taps */
      .topo, .topo-labels, .furniture { pointer-events: none; }
      .lake { fill: var(--lake); stroke: var(--river-ink); stroke-width: 1.5; }
      .river-bank { fill: none; stroke: var(--land); stroke-linecap: round; stroke-linejoin: round; opacity: .85; }
      .river { fill: none; stroke: var(--river); stroke-linecap: round; stroke-linejoin: round; }
      .relief use { fill: none; stroke: var(--topo); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
      .relief use.landmark { stroke: var(--topo-ink); stroke-width: 1.8; fill: var(--land); }
      .water-label, .relief-label { font-family: Lora, Georgia, serif; font-style: italic; font-weight: 500;
        paint-order: stroke; stroke: var(--land); stroke-width: 3px; stroke-linejoin: round; }
      .water-label { fill: var(--river-ink); font-size: 15px; letter-spacing: .06em; }
      .water-label.big { font-size: 19px; }
      .river-label { font-size: 21px; letter-spacing: .3em; }
      .relief-label { fill: var(--topo-ink); font-size: 14px; }
      .frame { fill: none; stroke: var(--topo-ink); stroke-width: 2; }
      .frame.inner { stroke-width: .8; }
      .compass circle { fill: none; stroke: var(--topo); stroke-width: 1; }
      .compass .star { fill: var(--paper); stroke: var(--topo-ink); stroke-width: 1.2; stroke-linejoin: round; }
      .compass .star-dark { fill: var(--topo-ink); }
      .compass text { font-family: Lora, Georgia, serif; font-style: italic; font-weight: 600; font-size: 18px; fill: var(--topo-ink); text-anchor: middle; }
      .badge { pointer-events: none; }
      .badge .bg { fill: var(--paper); }
      .badge .ring { fill: none; stroke-width: 5; stroke-linecap: round; transform: rotate(-90deg); }
      .badge.light .ring { stroke: var(--light-glow); } .badge.water .ring { stroke: var(--water); } .badge.gas .ring { stroke: var(--gas); }
      .badge .ico { fill: var(--ink); }
      .badge.light .ico, .tool[data-type='light'] svg { fill: var(--light-ico); }
      .badge.water .ico, .tool[data-type='water'] svg { fill: var(--water); }
      .badge.gas .ico, .tool[data-type='gas'] svg { fill: var(--gas); }
      .badge .pop { animation: pop .25s ease-out; transform-box: fill-box; transform-origin: center; }
      @keyframes pop { from { transform: scale(0); } }
      .float { font-family: Oswald, sans-serif; font-size: 26px; font-weight: 700; text-anchor: middle; pointer-events: none; animation: float .8s ease-out forwards; }
      @keyframes float { to { transform: translateY(-40px); opacity: 0; } }
      .tools { display: flex; justify-content: center; gap: 8px; padding: 10px 16px calc(14px + env(safe-area-inset-bottom)); }
      .tool { display: flex; align-items: center; gap: 8px; border: 2px solid var(--ink); background: transparent; color: var(--ink); font: inherit; font-size: 13px;
        padding: 10px 14px; cursor: pointer; border-radius: 0; transition: background .15s, color .15s, opacity .2s; }
      .tool svg { width: 20px; height: 20px; fill: currentColor; }
      .tool kbd { font: inherit; font-size: 11px; color: var(--faint); }
      .tool.active { background: var(--ink); color: var(--paper); }
      .tool.active kbd { color: var(--line); }
      .tool[hidden] { display: none; }
      .tool.new { animation: blink .5s 4; }
      @keyframes blink { 50% { background: var(--light-glow); color: var(--ink); } }
      .overlay { position: absolute; inset: 0; display: flex; justify-content: center; background: rgba(244, 241, 234, .92); padding: 16px; z-index: 5; overflow-y: auto; }
      .overlay[hidden] { display: none; }
      .card { max-width: 520px; width: 100%; text-align: center; margin: auto; }
      .scores { margin: 28px auto 0; max-width: 360px; text-align: left; }
      .scores h2 { font-family: Oswald, sans-serif; font-weight: 500; font-size: 14px; letter-spacing: .2em; text-transform: uppercase; color: var(--faint); margin: 0 0 8px; text-align: center; }
      .scores ol { list-style: none; margin: 0; padding: 0; font-size: 13px; }
      .scores li { display: grid; grid-template-columns: 2.2em 1fr auto; gap: 8px; padding: 6px 8px; border-bottom: 1px solid var(--line); }
      .scores li .n { color: var(--faint); }
      .scores li .nick { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .scores li .s { font-weight: 700; font-variant-numeric: tabular-nums; }
      .scores li.me { background: var(--ink); color: var(--paper); }
      .scores li.me .n { color: var(--line); }
      .scores .empty { font-size: 12px; color: var(--faint); text-align: center; padding: 8px 0; }
      .nickform { margin: 22px auto 0; max-width: 360px; }
      .nickform[hidden] { display: none; }
      .nickform label { display: block; font-size: 13px; color: var(--ink); margin-bottom: 10px; }
      .nickform .row { display: flex; }
      .nickform input { flex: 1; min-width: 0; border: 2px solid var(--ink); background: #fff; font: inherit; font-size: 16px; padding: 10px 12px; border-radius: 0; color: var(--ink); -webkit-user-select: text; user-select: text; }
      .nickform button { border: 0; background: var(--gas); color: #fff; font: inherit; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; padding: 0 16px; cursor: pointer; }
      .nickform button:disabled { opacity: .5; cursor: default; }
      .nickform .err { font-size: 12px; color: var(--bad); margin-top: 6px; min-height: 1em; }
      .card h1 { font-family: Oswald, sans-serif; font-weight: 700; text-transform: uppercase; font-size: clamp(40px, 9vw, 76px); line-height: .92; margin: 0; }
      .card p { font-size: 14px; line-height: 1.6; color: var(--muted); margin: 18px 0 0; }
      .legend { display: flex; justify-content: center; gap: 16px; margin-top: 18px; font-size: 12px; color: var(--muted); }
      .legend span::before { content: ''; display: inline-block; width: 12px; height: 12px; margin-right: 6px; vertical-align: -1px; }
      .legend .l::before { background: var(--light); } .legend .w::before { background: var(--water); } .legend .g::before { background: var(--gas); }
      .btn { margin-top: 26px; border: 0; background: var(--ink); color: var(--paper); font: inherit; font-size: 14px; letter-spacing: .14em; text-transform: uppercase; padding: 16px 30px; cursor: pointer; }
      .btn:hover { background: #2c2722; }
      .card h1.ka { font-family: 'Noto Sans Georgian', Oswald, sans-serif; text-transform: none; font-size: clamp(24px, 5.6vw, 44px); line-height: 1.15; letter-spacing: 0; overflow-wrap: anywhere; }
      .nav { display: flex; gap: 18px; align-items: baseline; }
      .switch { font-size: 12px; letter-spacing: .08em; border-bottom: 1px solid currentColor; }
      .card p.pron { font-size: 13px; letter-spacing: .04em; color: var(--faint); margin-top: 10px; }
      .card p.pron + p.translation { margin-top: 4px; }
      .bubble { position: absolute; z-index: 3; pointer-events: none; max-width: min(300px, calc(100% - 24px)); background: #fff; color: var(--ink);
        border: 2px solid var(--ink); border-radius: 14px; padding: 9px 13px 10px; box-shadow: 4px 4px 0 var(--ink); transform-origin: 50% 100%;
        animation: bubble-in .22s cubic-bezier(.3, 1.6, .5, 1); }
      .bubble[hidden] { display: none; }
      .bubble::after { content: ''; position: absolute; left: var(--tail, 50%); bottom: -11px; width: 16px; height: 16px; background: #fff;
        border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink); transform: translateX(-50%) rotate(45deg); }
      .bubble .ka { font-family: 'Noto Sans Georgian', sans-serif; font-weight: 800; font-size: 18px; line-height: 1.2; }
      .bubble .pron { font-size: 11px; color: var(--faint); margin-top: 3px; }
      .bubble .tr { font-family: Lora, Georgia, serif; font-style: italic; font-size: 13px; color: var(--muted); }
      .bubble.out { animation: bubble-out .25s forwards; }
      @keyframes bubble-in { from { transform: scale(.3); opacity: 0; } }
      @keyframes bubble-out { to { transform: scale(.6); opacity: 0; } }
      .dark { position: fixed; inset: 0; z-index: 20; background: #000; opacity: 0; pointer-events: none; display: flex;
        align-items: center; justify-content: center; padding: 16px; transition: opacity 1.4s ease-in; }
      .dark.on { opacity: 1; pointer-events: auto; cursor: pointer; }
      .dark .bubble { position: relative; max-width: min(360px, 100%); }
      .dark .bubble .ka { font-size: 26px; }
      .dark .bubble .tr { font-size: 15px; }
      /* lights come back like fluorescent tubes: a couple of flickers, then on */
      .dark.on.relight { animation: relight 1.3s forwards; }
      @keyframes relight { 0% { opacity: 1; } 12% { opacity: .25; } 20% { opacity: .95; } 34% { opacity: .1; } 42% { opacity: .8; } 100% { opacity: 0; } }
      @media (prefers-reduced-motion: reduce) { .dark.on.relight { animation: none; opacity: 0; transition: opacity .6s; } }
      .card p.translation { font-family: Lora, Georgia, serif; font-style: italic; font-size: 18px; color: var(--muted); margin-top: 10px; }
      .big { font-family: Oswald, sans-serif; font-size: 64px; font-weight: 700; color: var(--ink); line-height: 1; margin-top: 16px; }
      .banner { position: absolute; left: 50%; top: 8px; transform: translateX(-50%); background: var(--ink); color: var(--paper); padding: 10px 16px; font-size: 13px;
        letter-spacing: .04em; max-width: calc(100% - 32px); text-align: center; z-index: 4; transition: opacity .3s; pointer-events: none; }
      .banner[hidden] { display: block; opacity: 0; }
      .hammer { position: fixed; left: 0; top: 0; width: 56px; height: 56px; pointer-events: none; z-index: 10; transform-origin: 80% 80%; display: none; }
      .hammer.hit { animation: hit .15s; }
      @keyframes hit { 50% { rotate: -40deg; } }
      @media (hover: hover) and (pointer: fine) {
        body.playing main, body.playing .district { cursor: none; }
        body.playing .hammer { display: block; }
      }
      @media (max-width: 560px) {
        .tool { padding: 10px; } .tool .name, .tool kbd { display: none; }
        .label { font-size: 22px; letter-spacing: .02em; }
        .water-label { font-size: 20px; } .water-label.big { font-size: 22px; }
        .river-label { font-size: 24px; letter-spacing: .2em; }
        .relief-label { font-size: 19px; }
        .hud { gap: 4px 14px; } .hud b { font-size: 22px; }
      }

  body
    header
      a.logo(href='/') it.dimazvali.com
      span.nav
        a.switch(href=ui.switchHref hreflang=ui.switchLabel.toLowerCase() lang=ui.switchLabel.toLowerCase())= ui.switchLabel
        a.back(href='/')= ui.back

    div.hud
      span= ui.score
        b#score 0
      span= ui.level
        b#level 1
      span= ui.patience
        span.lives#lives
          i
          i
          i
          i
          i
      span.combo#combo

    main
      - var F = 34
      - var t = map.topo
      svg.map#map(viewBox=(-F - 6) + ' ' + (-F - 6) + ' ' + (map.w + 2 * F + 12) + ' ' + (map.h + 2 * F + 12) preserveAspectRatio='xMidYMid meet')
        defs
          clipPath#frame-clip
            rect(x=-F y=-F width=map.w + 2 * F height=map.h + 2 * F)
          //- old-map glyphs: a rounded hill and a jagged mountain, both drawn from the base centre
          symbol#g-hill(viewBox='-12 -10 24 11' overflow='visible')
            path(d='M-11 0C-8-6-4-8.5 0-8.5S8-6 11 0')
            path.hatch(d='M2.5-7.2 5-1.5M5.6-5.4 7.4-1.5M8-3 9-1.2')
          symbol#g-mount(viewBox='-13 -16 26 17' overflow='visible')
            path(d='M-12 0-3.5-14l3 4 3-6L12 0')
            path.hatch(d='M2.5-15 4.5-1.5M3.8-12.5 7-1.5M5.5-10 9.4-1.5M-0.5-10 0.5-1.5')
          symbol#g-castle(viewBox='-12 -22 24 22' overflow='visible')
            path(d='M-9 0V-12h3v3h3v-3h6v3h3v-3h3V0Z')
            path(d='M-3 0v-5a3 3 0 0 1 6 0V0')
            path(d='M-2-12V-19h4V-12M-2-19h-1.5v-2.5h7V-19H2')
          symbol#g-tower(viewBox='-8 -34 16 34' overflow='visible')
            path(d='M-6 0-1.5-26h3L6 0M-4.5-8h9M-3.2-16h6.4M0-26V-33')
            circle(cx='0' cy='-21' r='2.6')
          symbol#i-light(viewBox='0 0 24 24')
            path(d='M13 2 4 14h6l-1 8 9-12h-6z')
          symbol#i-water(viewBox='0 0 24 24')
            path(d='M12 2.5c-3.6 4.7-6.5 8.6-6.5 12a6.5 6.5 0 0 0 13 0c0-3.4-2.9-7.3-6.5-12z')
          symbol#i-gas(viewBox='0 0 24 24')
            path(d='M12 2c.6 3.5 4.2 5.4 4.8 9.2.3 1.7-.2 3.3-1.1 4.4.2-1.7-.6-3.2-1.9-4.1.2 2.4-1.5 3.4-2.5 4.9-.8-1.2-1.1-2.6-.8-4C8.6 13.6 7 15.6 7.3 18c-1.4-1.3-2.2-3.1-2.1-5C5.4 8.3 11.4 6.7 12 2z')
        g#districts
          each d in map.districts
            path.district(id='d-' + d.id d=d.d data-id=d.id)
        //- topography sits above the districts but ignores the pointer, so taps still hit the district
        g.topo(clip-path='url(#frame-clip)' aria-hidden='true')
          g.lakes
            each l in t.lakes
              path.lake(d=l.d)
          g.rivers
            each r in t.rivers
              path.river-bank(d=r.d stroke-width=r.w + 4)
            each r in t.rivers
              path.river(d=r.d stroke-width=r.w)
          g.relief
            each p in t.peaks
              - var big = p.ele >= 1000
              - var sz = Math.max(22, Math.min(46, 20 + (p.ele - 550) / 30))
              use(href=big ? '#g-mount' : '#g-hill' x=p.x - sz / 2 y=p.y - sz * (big ? 0.65 : 0.46) width=sz height=sz * (big ? 0.65 : 0.46))
            - var mts = t.peaks.find(function(p) { return p.label === 'Мтацминда'; })
            if mts
              use.landmark(href='#g-tower' x=mts.x + 10 y=mts.y - 44 width='16' height='34')
            use.landmark(href='#g-castle' x=t.castle.x - 12 y=t.castle.y - 22 width='24' height='22')
        g.topo-labels(aria-hidden='true')
          each l in t.lakes
            if l.id === 'sea'
              //- the reservoir is long and thin: name it beside its east shore, in two lines
              text.water-label.big(x=l.box[2] + 4 y=(l.box[1] + l.box[3]) / 2 text-anchor='start')
                tspan= ui.sea[0]
                tspan(x=l.box[2] + 4 dy='1.2em')= ui.sea[1]
            else
              text.water-label(x=(l.box[0] + l.box[2]) / 2 y=l.box[3] + 15)= ui.place(l.name)
          each r in t.riverLabels
            text.water-label.river-label(transform='translate(' + r.x + ' ' + r.y + ') rotate(' + r.rot + ')' y='-9')= ui.place(r.text)
          each p in t.peaks
            if p.label
              text.relief-label(x=p.x - 14 y=p.y + 4 text-anchor='end')= ui.place(p.label)
          text.relief-label(x=t.castle.x + 14 y=t.castle.y + 2 text-anchor='start')= ui.place(t.castle.label)
        //- map furniture: double frame and a compass rose in the empty north-west corner
        g.furniture(aria-hidden='true')
          rect.frame(x=-F y=-F width=map.w + 2 * F height=map.h + 2 * F)
          rect.frame.inner(x=-F + 6 y=-F + 6 width=map.w + 2 * F - 12 height=map.h + 2 * F - 12)
          g.compass(transform='translate(70 70)')
            circle(r='30')
            circle(r='22')
            path.star(d='M0-40 5-5 40 0 5 5 0 40-5 5-40 0-5-5Z')
            path.star-dark(d='M0-40 5-5 0 0ZM40 0 5 5 0 0ZM0 40-5 5 0 0ZM-40 0-5-5 0 0Z')
            text(y='-46')= ui.north
        g#labels
          //- Didube is a thin strip next to Nadzaladevi: nudge both names apart
          - var nudge = { didube: [-6, -30], nadzaladevi: [18, 0] }
          each d in map.districts
            - var n = nudge[d.id] || [0, 0]
            text.label(id='l-' + d.id x=d.cx + n[0] y=d.cy + 46 + n[1] data-cx=d.cx data-cy=d.cy)= ui.place(d.name)
        g#badges
        g#fx

      div.banner#banner(hidden)

      div.overlay#start
        div.card
          h1= ui.startTitle[0]
            br
            = ui.startTitle[1]
          p= ui.startP1
          p= ui.startP2
          div.legend
            span.l= ui.legend.light
            span.w= ui.legend.water
            span.g= ui.legend.gas
          button.btn#startBtn= ui.startBtn
          div.scores
            h2= ui.scoresTitle
            ol.scoreList
            div.empty= ui.loading

      div.overlay#over(hidden)
        div.card
          h1.ka#overTitle(lang='ka')
          p.pron#overPron
          p.translation#overSub
          div.big#finalScore 0
          p#overText
          form.nickform#nickForm(hidden autocomplete='off')
            label(for='nickInput')= ui.nickLabel
            div.row
              input#nickInput(maxlength='20' placeholder=ui.nickPlaceholder required enterkeyhint='done')
              button#nickBtn(type='submit')= ui.nickBtn
            div.err#nickErr
          button.btn#againBtn= ui.againBtn
          div.scores
            h2= ui.scoresTitle
            ol.scoreList
            div.empty= ui.loading

      //- speech bubble with a Georgian outage phrase, placed over a district by the script
      div.bubble#bubble(hidden aria-live='polite')
        div.ka(lang='ka')
        div.pron
        div.tr

    div.tools#tools
      each type, i in ['light', 'water', 'gas']
        button.tool(data-type=type hidden=i > 0 class=i === 0 ? 'active' : '')
          svg: use(href='#i-' + type)
          span.name= ui.tools[type]
          kbd= i + 1

    svg.hammer#hammer(viewBox='0 0 64 64' aria-hidden='true')
