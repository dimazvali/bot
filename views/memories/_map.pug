mixin memoryMap(mapData)
  #mm-map.mm-map
  script#mm-data(type='application/json')!= mapData
  script.
    (function(){
      var el = document.getElementById('mm-map');
      var dataEl = document.getElementById('mm-data');
      if (!el || !dataEl || !window.L) return;
      var points = JSON.parse(dataEl.textContent);
      if (!points.length) return;
      var map = L.map(el, { scrollWheelZoom: false, attributionControl: false });
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
      var bounds = [];
      points.forEach(function(p) {
        var m = L.marker([p.lat, p.lng], {
          icon: L.divIcon({ className: '', html: '<div class="mm-pin"></div>', iconSize: [14, 14], iconAnchor: [7, 7] })
        }).addTo(map);
        var html = '';
        if (p.thumb) html += '<img src="' + p.thumb + '" style="width:120px;height:80px;object-fit:cover;display:block;margin-bottom:4px">';
        if (p.caption) html += '<div>' + p.caption + '</div>';
        if (html) m.bindPopup(html);
        bounds.push([p.lat, p.lng]);
      });
      if (bounds.length === 1) map.setView(bounds[0], 15);
      else map.fitBounds(bounds, { padding: [24, 24] });
      setTimeout(function(){ map.invalidateSize(); }, 0);
      window.addEventListener('load', function(){ map.invalidateSize(); });
    })();
