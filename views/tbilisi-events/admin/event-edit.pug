include _admin.pug

+adminPage({ title: title, nav: 'events' })
  a.crumb(href=base + '/admin/events') ← К списку
  .pagehead
    h1= title

  if error
    .error-bar= error

  if event.submission
    .block
      .block-t Заявка пользователя
      p.hint
        = 'От: ' + (submitter ? submitter.email : event.submission.userId)
        |  · статус: #{event.submission.status}
        if event.submission.submittedAt
          |  · #{(event.submission.submittedAt.toDate ? event.submission.submittedAt.toDate() : new Date(event.submission.submittedAt)).toLocaleDateString('ru-RU')}
      if event.submission.contactNote
        p.hint= 'Контакт: ' + event.submission.contactNote
      if event.submission.status === 'pending' || event.submission.status === 'approved'
        form(method='POST' action=`${base}/admin/events/${event.id}/reject-submission` style='margin-top:8px')
          input(type='text' name='reason' placeholder='причина отклонения (необязательно)')
          button.btn.sm.danger(type='submit') Отклонить заявку

  form(method='POST' action=`${base}/admin/events/${event.id}/edit`)
    .checks
      label
        input(type='checkbox' name='active' checked=(event.active !== false))
        | Активно (показывать)
      label
        input(type='checkbox' name='notifyAuthor')
        | Уведомить автора об изменениях
      label
        input(type='checkbox' name='editorsPick' checked=(event.editorsPick === true))
        | Выбор редакции
      label
        input(type='checkbox' name='cancelled' checked=(event.cancelled === true))
        | Отменено

    label(for='f-title') Название (каноническое — для дедупа и поиска)
    input#f-title(type='text' name='title' value=event.title)

    .row
      div
        label(for='f-title-ru') Название RU
        input#f-title-ru(type='text' name='title_ru' value=(event.titleI18n ? event.titleI18n.ru : ''))
      div
        label(for='f-title-en') Название EN
        input#f-title-en(type='text' name='title_en' value=(event.titleI18n ? event.titleI18n.en : ''))
      div
        label(for='f-title-ka') Название KA
        input#f-title-ka(type='text' name='title_ka' value=(event.titleI18n ? event.titleI18n.ka : ''))

    .row
      div
        label(for='f-date') Дата
        input#f-date(type='date' name='date' value=event.date)
      div
        label(for='f-time') Время
        input#f-time(type='time' name='time' value=event.time || '')

    label(for='f-place') Место (текст)
    input#f-place(type='text' name='place' value=event.place || '')

    label(for='f-venue') Площадка (справочник)
    select#f-venue(name='venueId')
      option(value='') — не привязана —
      each v in venues
        option(value=v.id selected=(event.venueId === v.id))= v.name

    label(for='f-type') Тип
    select#f-type(name='type')
      option(value='') —
      each slug in eventTypeSlugs
        option(value=slug selected=(event.type === slug))= eventTypeLabels[slug]

    label Язык мероприятия
    .checks
      each slug in languageSlugs
        label
          input(type='checkbox' name='language' value=slug checked=((event.language || []).indexOf(slug) !== -1))
          = languageLabels[slug]

    label(for='f-price') Стоимость (текст, напр. «от 45 ₾» или «бесплатно»)
    input#f-price(type='text' name='price' value=event.price || '')

    label(for='f-desc-ru') Описание RU
    textarea#f-desc-ru(name='desc_ru')= event.description ? event.description.ru : ''
    label(for='f-desc-en') Описание EN
    textarea#f-desc-en(name='desc_en')= event.description ? event.description.en : ''
    label(for='f-desc-ka') Описание KA
    textarea#f-desc-ka(name='desc_ka')= event.description ? event.description.ka : ''

    label(for='f-note-ru') От редакции RU
    textarea#f-note-ru(name='note_ru')= event.editorNote ? event.editorNote.ru : ''
    label(for='f-note-en') От редакции EN
    textarea#f-note-en(name='note_en')= event.editorNote ? event.editorNote.en : ''
    label(for='f-note-ka') От редакции KA
    textarea#f-note-ka(name='note_ka')= event.editorNote ? event.editorNote.ka : ''

    .toolbar
      button.btn.solid(type='submit') Сохранить

  h2.sec-lbl Картинка
  form.block(method='POST' action=`${base}/admin/events/${event.id}/fetch-image`)
    label(for='f-img-url') URL картинки
    input#f-img-url(type='text' name='url' placeholder='пусто = повторить из imageSourceUrl')
    .toolbar
      button.btn(type='submit') Подтянуть картинку
    if event.imageUrl
      img.thumb(src=event.imageUrl alt='')
