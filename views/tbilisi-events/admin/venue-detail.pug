include _admin.pug

mixin eventRows(list)
  each e in list
    tr
      td.mono= e.date || '—'
      td.mono= e.time || ''
      td
        a.link(href=`${base}/admin/events/${e.id}/edit`)= e.title || e.id
      td.dim
        if e.hidden
          | скрыто
        if e.cancelled
          |  отменено

+adminPage({ title: title, nav: 'venues', leaflet: true })
  .pagehead
    h1= venue.name
    a.link(href=base + '/admin/venues') ← Все площадки
    a.link(href=base + '/venues/' + (venue.slug || venue.id) target='_blank' rel='noopener') Публичная страница ↗

  .toolbar
    if venue.editorVerified
      span.badge ✓ проверено редактором
    else
      span.badge не проверено
    form(method='POST' action=`${base}/admin/venues/${venue.id}/verify`)
      button.btn.sm(type='submit')= venue.editorVerified ? 'Снять отметку' : 'Отметить проверенной'
    if venue.researchNote
      span.v-meta веб: #{venue.researchNote}

  h2.sec-lbl Данные площадки
  form.block(method='POST' action=`${base}/admin/venues/${venue.id}/edit`)
    label(for='v-name') Название
    input#v-name(type='text' name='name' value=venue.name)
    .row
      div
        label(for='v-city') Город
        select#v-city(name='city')
          option(value='') —
          each c in cities
            option(value=c.slug selected=(venue.city === c.slug))= c.name.ru
      div
        label(for='v-district') Район (справочник)
        select#v-district(name='district')
          option(value='') —
          each c in cities
            each d in districtsByCity[c.slug]
              option(value=d.slug data-city=c.slug selected=(venue.district === d.slug))= d.name.ru
    .row
      div
        label(for='v-area') Район (свободный текст)
        input#v-area(type='text' name='area' value=venue.area || '' placeholder='если нет в справочнике')
      div
        label(for='v-type') Тип
        select#v-type(name='type')
          option(value='') —
          each slug in venueTypeSlugs
            option(value=slug selected=(venue.type === slug))= venueTypeLabels[slug]
    label(for='v-addr') Адрес
    input#v-addr(type='text' name='address' value=venue.address || '')

    label Точка на карте
    #v-map.v-map(
      data-lat=(venue.lat != null ? venue.lat : '')
      data-lng=(venue.lng != null ? venue.lng : '')
    )
    input#v-lat(type='hidden' name='lat' value=(venue.lat != null ? venue.lat : ''))
    input#v-lng(type='hidden' name='lng' value=(venue.lng != null ? venue.lng : ''))
    .v-map-bar
      span#v-coords(data-empty='точка не задана')
        if venue.lat != null && venue.lng != null
          = venue.lat + ', ' + venue.lng
        else
          | точка не задана
      button#v-clear.btn.sm(type='button') Очистить точку
    #v-confirm.v-confirm(hidden)
      span Поставить точку сюда: #[b#v-confirm-coords]?
      button#v-confirm-ok.btn.sm.solid(type='button') Подтвердить точку
      button#v-confirm-cancel.btn.sm(type='button') Отмена
    p.hint Кликните по карте, чтобы выбрать место, затем подтвердите. Точка сохранится вместе с формой по кнопке «Сохранить».

    label(for='v-site') Сайт
    input#v-site(type='text' name='website' value=venue.website || '')
    label(for='v-d-ru') Описание RU
    textarea#v-d-ru(name='desc_ru')= venue.description ? venue.description.ru : ''
    label(for='v-d-en') Описание EN
    textarea#v-d-en(name='desc_en')= venue.description ? venue.description.en : ''
    label(for='v-d-ka') Описание KA
    textarea#v-d-ka(name='desc_ka')= venue.description ? venue.description.ka : ''
    label
      input(type='checkbox' name='editorVerified' checked=!!venue.editorVerified)
      |  Проверено редактором
    label
      input(type='checkbox' name='closed' checked=!!venue.closed)
      |  Закрыто (площадка больше не работает)
    label(for='v-closed-date') Дата закрытия (необязательно)
    input#v-closed-date(type='date' name='closedDate' value=venue.closedDate || '')
    .toolbar
      button.btn.solid(type='submit') Сохранить

  .toolbar
    form(method='POST' action=`${base}/admin/venues/${venue.id}/research`)
      button.btn.sm(type='submit') Найти данные (веб-поиск)
    form(method='POST' action=`${base}/admin/venues/${venue.id}/draft-description`)
      button.btn.sm(type='submit') Черновик описания (LLM)
    form(method='POST' action=`${base}/admin/venues/${venue.id}/image` enctype='multipart/form-data')
      input(type='file' name='image' accept='image/*')
      button.btn.sm(type='submit') Загрузить фото
    form(method='POST' action=`${base}/admin/venues/${venue.id}/delete` onsubmit='return confirm("Удалить площадку?")')
      button.btn.sm.danger(type='submit') Удалить

  if venue.imageUrl
    img.thumb(src=venue.imageUrl alt='')

  h2.sec-lbl События площадки (#{totalCount})
  if !upcoming.length && !(showPast && past.length)
    p.hint #{totalCount ? 'Все события этой площадки — в прошлом.' : 'К этой площадке пока не привязано ни одного события.'}

  if upcoming.length
    h3.sub Предстоящие (#{upcoming.length})
    .tbl-scroll
      table.tbl
        thead
          tr
            th Дата
            th Время
            th Название
            th
        tbody
          +eventRows(upcoming)

  if showPast
    if past.length
      h3.sub Прошедшие (#{past.length})
      .tbl-scroll
        table.tbl
          thead
            tr
              th Дата
              th Время
              th Название
              th
          tbody
            +eventRows(past)
    p.hint
      a.link(href=`${base}/admin/venues/${venue.id}`) Скрыть прошедшие
  else if past.length
    p.hint
      a.link(href=`${base}/admin/venues/${venue.id}?past=1`) Показать прошедшие (#{past.length})

  script.
    (function () {
      var city = document.getElementById('v-city');
      var district = document.getElementById('v-district');
      if (!city || !district) return;
      function sync() {
        var c = city.value;
        for (var i = 0; i < district.options.length; i++) {
          var o = district.options[i];
          if (!o.value) continue;
          var show = o.getAttribute('data-city') === c;
          o.hidden = !show;
          if (!show && o.selected) district.value = '';
        }
      }
      city.addEventListener('change', sync);
      sync();
    })();

    // ---- point picker: click to choose, separate confirm before it sticks ----
    (function () {
      var el = document.getElementById('v-map');
      if (!el || !window.L) return;
      var latInput = document.getElementById('v-lat');
      var lngInput = document.getElementById('v-lng');
      var coordsEl = document.getElementById('v-coords');
      var clearBtn = document.getElementById('v-clear');
      var box = document.getElementById('v-confirm');
      var boxCoords = document.getElementById('v-confirm-coords');
      var okBtn = document.getElementById('v-confirm-ok');
      var cancelBtn = document.getElementById('v-confirm-cancel');
      var TBILISI = [41.7151, 44.8271];

      function num(v) { var n = parseFloat(v); return isNaN(n) ? null : n; }
      var lat0 = num(el.getAttribute('data-lat'));
      var lng0 = num(el.getAttribute('data-lng'));

      var map = L.map(el, { scrollWheelZoom: true, attributionControl: false })
        .setView(lat0 != null && lng0 != null ? [lat0, lng0] : TBILISI, lat0 != null ? 16 : 12);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);

      function icon(extra) {
        return L.divIcon({ className: '', html: '<div class="v-pin' + extra + '"></div>', iconSize: [16, 16], iconAnchor: [8, 8] });
      }
      var committed = null, provisional = null, pending = null;

      function fmt(a, b) { return a.toFixed(6) + ', ' + b.toFixed(6); }
      function setCommitted(lat, lng) {
        if (committed) map.removeLayer(committed);
        committed = L.marker([lat, lng], { icon: icon('') }).addTo(map);
        latInput.value = lat;
        lngInput.value = lng;
        coordsEl.textContent = fmt(lat, lng);
      }
      function clearCommitted() {
        if (committed) { map.removeLayer(committed); committed = null; }
        latInput.value = '';
        lngInput.value = '';
        coordsEl.textContent = coordsEl.getAttribute('data-empty') || '—';
      }
      function closeConfirm() {
        box.hidden = true;
        if (provisional) { map.removeLayer(provisional); provisional = null; }
        pending = null;
      }

      if (lat0 != null && lng0 != null) setCommitted(lat0, lng0);

      map.on('click', function (e) {
        pending = [e.latlng.lat, e.latlng.lng];
        if (provisional) map.removeLayer(provisional);
        provisional = L.marker(pending, { icon: icon(' provisional') }).addTo(map);
        boxCoords.textContent = fmt(pending[0], pending[1]);
        box.hidden = false;
      });
      okBtn.addEventListener('click', function () {
        if (pending) setCommitted(pending[0], pending[1]);
        closeConfirm();
      });
      cancelBtn.addEventListener('click', closeConfirm);
      clearBtn.addEventListener('click', function () { closeConfirm(); clearCommitted(); });

      setTimeout(function () { map.invalidateSize(); }, 0);
      window.addEventListener('load', function () { map.invalidateSize(); });
    })();
