include _admin.pug

+adminPage({ title: title, nav: 'admins' })
  .pagehead
    h1 Админы
    span.count всего #[b= admins.length]

  if saved
    .notice Сохранено.
  .notice
    | Пароль из #[code TBILISI_EVENTS_ADMIN_PASS] всегда работает и даёт права суперадмина — это запасной вход, в списке его нет.

  h2.sec-lbl Добавить админа
  if adminError
    p.error= adminError
  form.block(method='POST' action=base + '/admin/admins')
    .row
      div
        label(for='a-name') Имя
        input#a-name(type='text' name='name' required)
      div
        label(for='a-pass') Пароль
        input#a-pass(type='text' name='password' required)
    .checks
      label
        input(type='checkbox' name='superadmin')
        | Суперадмин — может управлять админами
    .toolbar
      button.btn(type='submit') Добавить админа

  h2.sec-lbl Все админы
  if !admins.length
    p.hint Пока только запасной вход по паролю из окружения.
  each a in admins
    .block
      .block-t
        = a.name
        if a.superadmin
          span.badge суперадмин
        if a.id === currentAdminId
          span.badge вы
      form(method='POST' action=`${base}/admin/admins/${a.id}`)
        .row
          div
            label(for=`a-${a.id}-pass`) Новый пароль
            input(id=`a-${a.id}-pass` type='text' name='password' placeholder='пусто — не менять')
          div
            label Роль
            .checks
              label
                input(type='checkbox' name='superadmin' checked=a.superadmin)
                | Суперадмин
        .toolbar
          button.btn.solid(type='submit') Сохранить
          if a.id !== currentAdminId
            button.btn.sm.danger(type='submit' formaction=`${base}/admin/admins/${a.id}/delete` formnovalidate onclick=`return confirm('Удалить админа ${a.name}?')`) Удалить
