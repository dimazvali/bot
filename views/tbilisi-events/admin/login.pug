include _admin.pug

+adminPage({ title: title, bare: true })
  form.login-card(method='POST' action='/tbilisi-events/admin/login')
    h1
      | Tbiliseli #[span.acc Events]
    p.sub admin
    if error
      .error-bar= error
    label(for='pass') Пароль
    input#pass(type='password' name='pass' autofocus required)
    button.btn.solid(type='submit') Войти
