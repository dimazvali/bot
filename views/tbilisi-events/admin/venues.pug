include _admin.pug

+adminPage({ title: title, nav: 'venues' })
  .pagehead
    h1 Площадки
    span.count всего #[b= venues.length]

  if error
    .error-bar= error
  if researchStarted
    .notice Авто-заполнение запущено в фоне. Результат придёт в Telegram, поля обновятся по мере готовности — обновите страницу через пару минут.

  h2.sec-lbl Авто-заполнение
  p.hint Веб-поиск через Claude + геокодирование адреса. Заполняет только пустые поля, ручные правки не трогает.
  .toolbar
    form(method='POST' action=base + '/admin/venues/research-missing')
      button.btn(type='submit') Заполнить недостающие данные

  h2.sec-lbl Добавить площадку
  form.block(method='POST' action=base + '/admin/venues')
    label(for='v-name') Название
    input#v-name(type='text' name='name' placeholder='Название площадки' required)
    .toolbar
      button.btn(type='submit') Добавить

  h2.sec-lbl Слить площадки
  form.block(method='POST' action=base + '/admin/venues/merge')
    .row
      div
        label(for='v-from') Из (будет удалена)
        select#v-from(name='fromId' required)
          option(value='') —
          each v in venues
            option(value=v.id)= v.name + ' (' + (v.eventCount || 0) + ')'
      div
        label(for='v-to') В (события перепривяжутся сюда)
        select#v-to(name='toId' required)
          option(value='') —
          each v in venues
            option(value=v.id)= v.name + ' (' + (v.eventCount || 0) + ')'
    .toolbar
      button.btn.danger(type='submit' onclick='return confirm("Слить? Первую удалит, события перепривяжет ко второй.")') Слить

  h2.sec-lbl Все площадки
  .tbl-scroll
    table.tbl
      thead
        tr
          th Название
          th Район
          th Тип
          th Событий
          th Проверено
      tbody
        each v in venues
          tr
            td
              a.link(href=`${base}/admin/venues/${v.id}`)= v.name
            td= v.area || '—'
            td= v.type ? venueTypeLabels[v.type] : '—'
            td= v.eventCount || 0
            td
              if v.editorVerified
                span.badge ✓
              else
                span.dim —
