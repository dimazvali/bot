doctype html
html
  head
    title= title
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1')
    style.
      body { font-family: sans-serif; margin: 2rem; max-width: 900px; }
      a.back { color: #1C2E4A; text-decoration: none; font-size: 0.9rem; }
      details.v { border: 1px solid #ddd; border-radius: 6px; margin: 0.5rem 0; padding: 0.5rem 0.8rem; }
      details.v summary { cursor: pointer; font-weight: bold; }
      details.v .meta { font-weight: normal; color: #557; font-size: 0.8rem; }
      label { display: block; margin: 0.6rem 0 0.15rem; font-size: 0.8rem; font-weight: bold; }
      input[type=text], select, textarea { width: 100%; padding: 0.4rem; box-sizing: border-box; font-size: 0.88rem; }
      textarea { min-height: 3.5rem; }
      .row { display: flex; gap: 1rem; }
      .row > div { flex: 1; }
      .inline { display: inline; }
      .bar { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.6rem; }
      .bar button { font-size: 0.8rem; padding: 0.3rem 0.6rem; }
      form.add, form.merge { border: 1px solid #ccc; border-radius: 6px; padding: 0.8rem; margin: 1rem 0; }
      form.add input, form.merge select { margin-right: 0.5rem; }
  body
    p
      a.back(href='/tbilisi-events/admin/') ← Дашборд
    h1= title

    form.add(method='POST' action='/tbilisi-events/admin/venues')
      strong Добавить площадку вручную:
      input(type='text' name='name' placeholder='Название' required)
      button(type='submit') Добавить

    form.merge(method='POST' action='/tbilisi-events/admin/venues/merge')
      strong Слить площадки:
      select(name='fromId' required)
        option(value='') — из —
        each v in venues
          option(value=v.id)= v.name + ' (' + (v.eventCount || 0) + ')'
      select(name='toId' required)
        option(value='') — в —
        each v in venues
          option(value=v.id)= v.name + ' (' + (v.eventCount || 0) + ')'
      button(type='submit' onclick='return confirm("Слить? Первую удалит, события перепривяжет ко второй.")') Слить

    p Всего: #{venues.length}
    each v in venues
      details.v
        summary
          = v.name
          span.meta  — #{v.eventCount || 0} соб. · #{v.origin}
        form(method='POST' action=`/tbilisi-events/admin/venues/${v.id}/edit`)
          label Название
          input(type='text' name='name' value=v.name)
          .row
            div
              label Район
              input(type='text' name='area' value=v.area || '')
            div
              label Тип
              select(name='type')
                option(value='') —
                each slug in venueTypeSlugs
                  option(value=slug selected=(v.type === slug))= venueTypeLabels[slug]
          label Адрес
          input(type='text' name='address' value=v.address || '')
          .row
            div
              label Широта (lat)
              input(type='text' name='lat' value=(v.lat != null ? v.lat : ''))
            div
              label Долгота (lng)
              input(type='text' name='lng' value=(v.lng != null ? v.lng : ''))
          label Сайт
          input(type='text' name='website' value=v.website || '')
          label Описание (RU)
          textarea(name='desc_ru')= v.description ? v.description.ru : ''
          label Описание (EN)
          textarea(name='desc_en')= v.description ? v.description.en : ''
          label Описание (KA)
          textarea(name='desc_ka')= v.description ? v.description.ka : ''
          .bar
            button(type='submit') Сохранить
        .bar
          form.inline(method='POST' action=`/tbilisi-events/admin/venues/${v.id}/draft-description`)
            button(type='submit') Черновик описания (LLM)
          form.inline(method='POST' action=`/tbilisi-events/admin/venues/${v.id}/image` enctype='multipart/form-data')
            input(type='file' name='image' accept='image/*')
            button(type='submit') Загрузить фото
          form.inline(method='POST' action=`/tbilisi-events/admin/venues/${v.id}/delete` onsubmit='return confirm("Удалить площадку?")')
            button(type='submit') Удалить
        if v.imageUrl
          p
            img(src=v.imageUrl style='max-width:220px')
