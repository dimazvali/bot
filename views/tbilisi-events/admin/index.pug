include _admin.pug

+adminPage({ title: title, nav: 'dashboard' })
  .pagehead
    h1 Дашборд

  h2.sec-lbl Сбор событий
  .toolbar
    form(method='POST' action=base + '/admin/collect')
      button.btn.solid(type='submit') Собрать события
  if error
    p.error= error
  if started
    .notice Сбор запущен. Результат придёт в Telegram и появится в логе ниже.

  #collect-progress.progress(style='display:none')
    .p-t Прогресс сбора
    #collect-status.p-status
    ul#collect-log

  h2.sec-lbl Лог парсинга
  if !logs.length
    p.hint Пока нет записей.
  else
    .tbl-scroll
      table.tbl
        thead
          tr
            th Дата
            th Источников
            th Пропущено
            th Найдено
            th Новых
            th Объединено
            th Ошибок
        tbody
          each log in logs
            - var logDate = log.createdAt && log.createdAt.toDate ? log.createdAt.toDate() : new Date(log.createdAt)
            tr
              td.mono= logDate.toLocaleString('ru-RU')
              td= log.sourcesProcessed
              td.dim= log.itemsSkipped || 0
              td= log.eventsFound
              td= log.eventsNew
              td= log.eventsMerged
              - var errCount = (log.sourceErrors || []).length
              td(class=errCount ? 'mk' : 'dim' title=(log.sourceErrors || []).map(function(e){ return e.source + ': ' + e.error; }).join('\n'))
                = errCount

  script.
    (function () {
      var box = document.getElementById('collect-progress');
      var statusEl = document.getElementById('collect-status');
      var logEl = document.getElementById('collect-log');
      var itemLi = null;

      function show() { box.style.display = 'block'; }
      function add(text) {
        var li = document.createElement('li');
        li.textContent = text;
        logEl.appendChild(li);
        logEl.scrollTop = logEl.scrollHeight;
        return li;
      }
      function reset(msg) { logEl.innerHTML = ''; itemLi = null; statusEl.textContent = msg; }

      function handle(ev) {
        if (ev.phase === 'idle') return;
        show();
        if (ev.phase === 'accepted') {
          reset('Запущено' + (ev.scope === 'single' ? ' (один источник)' : '') + '…');
        } else if (ev.phase === 'snapshot') {
          reset(ev.done ? 'Последний сбор завершён' : 'Идёт сбор…');
        } else if (ev.phase === 'start') {
          add('Источников: ' + ev.totalSources);
        } else if (ev.phase === 'source') {
          itemLi = null;
          if (ev.status === 'start') add('▶ ' + ev.index + '/' + ev.total + ' ' + ev.label + ' (' + ev.type + ')');
          else if (ev.status === 'collected') add('   постов собрано: ' + ev.items);
          else if (ev.status === 'error') add('   ✖ ' + ev.error);
          else if (ev.status === 'done') add('   ✓ найдено ' + ev.eventsFound + ', новых ' + ev.eventsNew + ', объединено ' + ev.eventsMerged + ', пропущено ' + (ev.itemsSkipped || 0));
        } else if (ev.phase === 'item') {
          var t = '   пост ' + ev.index + '/' + ev.total + (ev.skipped ? ' — без изменений, пропущен' : '');
          if (itemLi) itemLi.textContent = t;
          else itemLi = add(t);
        } else if (ev.phase === 'error') {
          add('✖ ' + ev.error);
        } else if (ev.phase === 'finished') {
          var s = ev.summary || {};
          statusEl.textContent = ev.error ? ('Завершено с ошибкой: ' + ev.error) : 'Готово';
          add('— итог: источников ' + (s.sourcesProcessed || 0) + ', пропущено ' + (s.itemsSkipped || 0) + ', найдено ' + (s.eventsFound || 0) + ', новых ' + (s.eventsNew || 0) + ', объединено ' + (s.eventsMerged || 0) + ((s.sourceErrors && s.sourceErrors.length) ? (', ошибок ' + s.sourceErrors.length) : ''));
        }
      }

      try {
        var es = new EventSource('#{base}/admin/collect/stream');
        es.onmessage = function (e) { try { handle(JSON.parse(e.data)); } catch (err) {} };
      } catch (err) {}

      document.querySelectorAll('form[action$="/collect"]').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          show();
          statusEl.textContent = 'Отправка запроса…';
          fetch(form.action, { method: 'POST', body: new FormData(form), headers: { 'X-Requested-With': 'fetch' } })
            .catch(function () { statusEl.textContent = 'Не удалось запустить сбор'; });
        });
      });
    })();
