doctype html
include ../_card.pug
include ../_map.pug
include ../_crumbs.pug
html(lang=lang)
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1')
    title= title
    include ../_analytics.pug
    include ../_seo.pug
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Oswald:wght@500;600&family=Noto+Sans+Georgian:wght@400;500;600&display=swap')
    link(rel='stylesheet' href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css' integrity='sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H' crossorigin='anonymous')
    script(src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js' integrity='sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH' crossorigin='anonymous')
    style.
      :root{
        --bg:#e6ded1; --paper:#faf6f0; --paper2:#fffdf9; --ink:#14110e; --acc:#e2402a;
        --muted:#6f665c; --muted2:#8b8175; --line:#ded4c4; --line2:#d6cdbe; --shadow:#cfc4b3;
        --dark:#14110e; --dark-fg:#f4eee4; --dark-muted:#a49a8d; --panel:#f2ebe0;
        --sans:'Manrope','Noto Sans Georgian',system-ui,sans-serif;
        --disp:'Oswald','Noto Sans Georgian',sans-serif;
        --mono:'Courier New',ui-monospace,monospace;
      }
      *{box-sizing:border-box;margin:0;padding:0}
      body{background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;font-size:15px;line-height:1.5}
      a{color:inherit;text-decoration:none}
      img{max-width:100%;display:block}
      ::selection{background:var(--acc);color:var(--paper)}
      .scr{scrollbar-width:none}
      .scr::-webkit-scrollbar{display:none}

      .wrap{max-width:480px;margin:0 auto;background:var(--paper);min-height:100vh}
      @media(min-width:520px){.wrap{border-left:1px solid var(--ink);border-right:1px solid var(--ink);margin:28px auto 60px;min-height:0;box-shadow:12px 12px 0 var(--shadow)}}

      .hdr{background:var(--dark);color:var(--dark-fg);display:flex;align-items:center;gap:12px;padding:12px 16px}
      .hdr .back{color:var(--dark-fg);font-weight:700;font-size:14px}
      .brand{font-family:var(--disp);font-size:18px;font-weight:600;text-transform:uppercase}
      .brand .acc{color:var(--acc)}
      .langs{margin-left:auto;display:flex;gap:3px}
      .lang{font-size:11px;font-weight:800;letter-spacing:.08em;padding:4px 7px;border-radius:2px;color:var(--dark-muted)}
      .lang.on{background:var(--acc);color:#fffdf9}

      .hero{position:relative;aspect-ratio:4/3;border-bottom:1px solid var(--ink);overflow:hidden}
      .hero img{width:100%;height:100%;object-fit:cover}
      .ph{width:100%;height:100%;background-image:repeating-linear-gradient(135deg,#e5ddce 0 8px,#efe8dc 8px 16px)}
      .hero .tag{position:absolute;top:0;left:0;background:var(--ink);color:#fffdf9;font-family:var(--disp);text-transform:uppercase;font-size:11px;letter-spacing:.14em;padding:6px 11px}

      .body{padding:20px 16px 24px;border-bottom:8px solid var(--ink)}
      .kicker{font-family:var(--disp);text-transform:uppercase;font-size:11px;letter-spacing:.14em;color:var(--acc);margin-bottom:9px}
      h1.t{font-family:var(--disp);font-size:36px;font-weight:600;line-height:1.02;margin-bottom:12px;text-wrap:pretty}
      .closed-note{display:inline-block;font-family:var(--disp);text-transform:uppercase;font-size:12px;letter-spacing:.08em;font-weight:600;color:var(--acc);border:1px solid var(--acc);padding:3px 8px;margin-bottom:12px}
      p.lead{font-size:16px;line-height:1.55;color:#4a423a;margin-bottom:16px;text-wrap:pretty}
      .stats{display:flex;gap:20px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:14px 0;margin-bottom:16px}
      .stats .n{font-family:var(--disp);font-size:22px;font-weight:600;line-height:1.1;color:var(--acc)}
      .stats .l{font-size:11px;color:var(--muted2);text-transform:uppercase;letter-spacing:.07em;margin-top:3px}
      dl.facts{display:grid;grid-template-columns:auto 1fr;gap:8px 14px;font-size:14px}
      dl.facts dt{color:var(--muted2)}
      dl.facts dd{font-weight:600;text-wrap:pretty}
      dl.facts dd a{border-bottom:1px solid var(--acc);word-break:break-all}
      .actions{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap}
      .org-row{margin-top:14px}
      .org-btn{display:inline-block;font-weight:700;font-size:13px;padding:9px 13px;border:1px solid var(--ink);color:var(--ink);text-decoration:none}
      .org-btn:hover{background:var(--ink);color:var(--paper)}
      .org-ok{color:var(--acc);font-weight:700;font-size:13px}
      .org-pending{color:var(--muted);font-size:13px}
      .btn{display:inline-block;text-align:center;font-weight:700;font-size:14px;padding:13px 16px;border-radius:2px;border:1px solid var(--ink);color:var(--ink)}
      .btn.solid{background:var(--ink);color:#fffdf9;flex:1}
      .btn.solid:hover{background:var(--acc)}
      .btn.ghost:hover{background:var(--ink);color:var(--paper)}

      .sec{padding:20px 16px 24px}
      .sec-head{display:flex;align-items:baseline;gap:9px;margin-bottom:14px}
      .sec-head h2{font-family:var(--disp);font-size:25px;font-weight:600;text-transform:uppercase}
      .sec-head .c{font-size:13px;color:var(--muted)}
      .sec-lbl{font-family:var(--disp);text-transform:uppercase;font-size:12px;letter-spacing:.14em;font-weight:600;margin-bottom:12px}

      .more{display:block;text-align:center;margin-top:16px;border:1px solid var(--ink);font-weight:700;font-size:14px;padding:13px}

      .map{border:1px solid var(--ink);aspect-ratio:3/2;background-image:repeating-linear-gradient(45deg,#e8e0d2 0 10px,#f0e9de 10px 20px);display:flex;align-items:flex-end;padding:9px}
      .map span{font-family:var(--mono);font-size:11px;color:#857b6f;background:var(--paper);padding:3px 7px}
      .te-map{width:100%;aspect-ratio:3/2;border:1px solid var(--ink);background:#efe8dc}
      .te-map .leaflet-tile-pane{filter:grayscale(1) contrast(.82) brightness(1.06) sepia(.28)}
      .te-map .leaflet-container{font-family:var(--sans)}
      .te-pin{width:12px;height:12px;background:var(--acc);border:2px solid var(--ink)}
      .map-btn{display:block;text-align:center;border:1px solid var(--ink);border-top:none;color:var(--ink);font-weight:700;font-size:14px;padding:13px}
      .map-btn:hover{background:var(--ink);color:var(--paper)}

      .mini-list{display:flex;flex-direction:column;gap:1px;background:var(--ink);border:1px solid var(--ink)}
      .mini{display:flex;gap:12px;align-items:center;background:var(--paper2);padding:13px 12px;color:var(--ink)}
      .mini:hover{background:var(--panel)}
      .mini .th{flex:0 0 52px;aspect-ratio:1/1;border:1px solid var(--line);position:relative;overflow:hidden}
      .mini .th img{width:100%;height:100%;object-fit:cover}
      .mini .th .ph{position:absolute;inset:0}
      .mini .mt{font-family:var(--disp);font-size:18px;font-weight:500;line-height:1.15}
      .mini .mm{font-size:12px;color:var(--muted);margin-top:3px}

      .ftr{border-top:1px solid var(--ink);background:var(--panel);padding:20px 16px 24px;font-family:var(--mono);font-size:12px}
      .ftr a{color:#4a423a}
      .ftr a:hover{color:var(--acc)}

      .admin-edit{position:fixed;right:16px;bottom:16px;z-index:60;background:var(--ink);color:#fffdf9;font-family:var(--disp);text-transform:uppercase;font-size:12px;letter-spacing:.1em;font-weight:600;padding:11px 16px;border:1px solid var(--ink);box-shadow:4px 4px 0 var(--shadow)}
      .admin-edit:hover{background:var(--acc);border-color:var(--acc)}

      @media(min-width:1000px){
        .wrap{max-width:1200px}
        .hdr{gap:22px;padding:16px 40px}
        .brand{font-size:24px}
        .hero-row{display:grid;grid-template-columns:1fr 1fr;border-bottom:8px solid var(--ink)}
        .hero{aspect-ratio:16/11;border-bottom:none;border-right:1px solid var(--ink)}
        .body{border-bottom:none;padding:38px 36px 34px;display:flex;flex-direction:column}
        h1.t{font-size:52px;line-height:1}
        p.lead{font-size:17px}
        .split{display:grid;grid-template-columns:1fr 400px}
        .split > .main{padding:36px 36px 44px 40px;border-right:1px solid var(--line)}
        .split > .aside{padding:36px 32px 44px;display:flex;flex-direction:column;gap:30px}
        .split > .aside .sec{padding:0}
        .sec-head h2{font-size:30px}
        .ftr{padding:24px 36px 28px}
      }
    style
      include ../_card.css
  body
    .wrap
      header.hdr
        a.back(href=backHref) ←
        .brand
          | Tbiliseli #[span.acc Events]
        .langs
          each l in langLinks
            a(href=l.href class=l.active ? 'lang on' : 'lang')= l.code

      +crumbs(crumbs)

      .hero-row
        .hero
          if venue.imageUrl
            img(src=venue.imageUrl alt=venue.name)
          else
            .ph
          span.tag= t.venues
        .body
          .kicker= [venue.area, venueTypeLabel].filter(Boolean).join(' · ')
          h1.t= venue.name
          if venueClosedLabel
            .closed-note= venueClosedLabel
          if venueDesc
            p.lead= venueDesc
          .stats
            div
              .n= upcoming.length
              .l= t.upcoming
            div
              .n= totalHere
              .l #{t.eventsWord}
          if facts.length
            dl.facts
              each f in facts
                dt= f.k
                dd= f.v
              if website
                dt= t.website
                dd
                  a(href=website target='_blank' rel='noopener noreferrer')= website.replace(/^https?:\/\//, '')
          .actions
            a.btn.solid(href=mapHref target='_blank' rel='noopener noreferrer')= t.routeMap
          .org-row
            if organizerState === 'approved'
              span.org-ok= t.orgYouAre
            else if organizerState === 'new'
              span.org-pending= t.orgPending
            else if user
              a.org-btn(href=organizerHref)= t.orgClaim
            else
              a.org-btn(href=loginHref)= t.orgClaim

      .split
        .main
          .sec
            .sec-head
              h2= t.venuePoster
              if totalHere
                span.c #{upcomingShown.length} #{t.ofWord} #{totalHere}
            if upcomingShown.length === 0
              p(style='color:var(--muted);font-size:14px')= t.nothingHere
            else
              .cards.grid2
                each e in upcomingShown
                  +eventCard(e)
              if upcoming.length > upcomingShown.length
                a.more(href=backHref)= t.showAllUpcoming

        .aside
          .sec
            .sec-lbl= t.routeMap
            if venue.lat != null && venue.lng != null
              +cityMap(venue.lat, venue.lng, venue.name)
            else
              a.map(href=mapHref target='_blank' rel='noopener noreferrer')
                span= venue.name
            a.map-btn(href=mapHref target='_blank' rel='noopener noreferrer')= t.routeMap
          if other.length
            .sec
              .sec-lbl= t.otherVenues
              .mini-list
                each o in other
                  a.mini(href=o.href)
                    .th
                      if o.imageUrl
                        img(src=o.imageUrl alt=o.name)
                      else
                        .ph
                    div
                      .mt= o.name
                      if o.meta
                        .mm= o.meta

      footer.ftr
        a(href=backHref)= t.backToAfisha

    if isAdmin
      a.admin-edit(href=editHref) ✎ Редактировать
