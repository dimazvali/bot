doctype html
html(lang=lang)
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1')
    title= title
    include _analytics.pug
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Oswald:wght@600&display=swap')
    style.
      :root{--bg:#e6ded1;--paper2:#fffdf9;--ink:#14110e;--acc:#e2402a;--line:#ded4c4;--muted:#6f665c;--sans:'Manrope',system-ui,sans-serif;--disp:'Oswald',sans-serif}
      *{box-sizing:border-box;margin:0;padding:0}
      body{background:var(--bg);color:var(--ink);font-family:var(--sans);min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:24px}
      .card{width:min(420px,92vw);border:1px solid var(--ink);background:var(--paper2);padding:28px 24px;text-align:center}
      h1{font-family:var(--disp);text-transform:uppercase;font-size:20px;margin-bottom:10px}
      p{font-size:14px;color:var(--muted);line-height:1.55;margin-bottom:14px}
      a.btn{display:inline-block;font:inherit;font-weight:700;font-size:13px;padding:10px 16px;border:1px solid var(--ink);background:var(--ink);color:var(--paper2);text-decoration:none}
      a.btn:hover{background:var(--acc);border-color:var(--acc)}
      a.plain{color:var(--muted);font-size:13px;text-decoration:none;display:inline-block;margin-top:14px}
  body
    .card
      h1 Thank you
      p We got your event and the editors will review it. You'll be notified when it's published.
      if tgDeepLink
        p Connect Telegram to get that notification instantly:
        p
          a.btn(href=tgDeepLink target='_blank' rel='noopener') Link Telegram
      p
        a.plain(href=base + '/') ← Back to the listing
