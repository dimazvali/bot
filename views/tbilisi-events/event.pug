doctype html
include ./_card.pug
include ./_map.pug
include ./_crumbs.pug
html(lang=lang)
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1')
    title= title
    include _analytics.pug
    include _seo.pug
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Oswald:wght@500;600&family=Noto+Sans+Georgian:wght@400;500;600&display=swap')
    link(rel='stylesheet' href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css' integrity='sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H' crossorigin='anonymous')
    script(src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js' integrity='sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH' crossorigin='anonymous')
    style.
      :root{
        --bg:#e6ded1; --paper:#faf6f0; --paper2:#fffdf9; --ink:#14110e; --acc:#e2402a;
        --muted:#6f665c; --muted2:#8b8175; --line:#ded4c4; --line2:#d6cdbe; --shadow:#cfc4b3;
        --dark:#14110e; --dark-fg:#f4eee4; --dark-muted:#a49a8d; --dark-line:#302a23; --panel:#f2ebe0;
        --sans:'Manrope','Noto Sans Georgian',system-ui,sans-serif;
        --disp:'Oswald','Noto Sans Georgian',sans-serif;
        --mono:'Courier New',ui-monospace,monospace;
      }
      *{box-sizing:border-box;margin:0;padding:0}
      body{background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;font-size:15px;line-height:1.5}
      a{color:inherit;text-decoration:none}
      img{max-width:100%;display:block}
      ::selection{background:var(--acc);color:var(--paper)}
      .scr{scrollbar-width:none}
      .scr::-webkit-scrollbar{display:none}

      .wrap{max-width:480px;margin:0 auto;background:var(--paper);min-height:100vh}
      @media(min-width:520px){.wrap{border-left:1px solid var(--ink);border-right:1px solid var(--ink);margin:28px auto 60px;min-height:0;box-shadow:12px 12px 0 var(--shadow)}}

      .hdr{background:var(--dark);color:var(--dark-fg);display:flex;align-items:center;gap:12px;padding:12px 16px}
      .hdr .back{color:var(--dark-fg);font-weight:700;font-size:14px}
      .brand{font-family:var(--disp);font-size:18px;font-weight:600;text-transform:uppercase}
      .brand .acc{color:var(--acc)}
      .langs{margin-left:auto;display:flex;gap:3px}
      .lang{font-size:11px;font-weight:800;letter-spacing:.08em;padding:4px 7px;border-radius:2px;color:var(--dark-muted)}
      .lang.on{background:var(--acc);color:#fffdf9}

      .crumbs{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:10px 16px;border-bottom:1px solid var(--line);background:var(--panel);font-size:12px;color:var(--muted)}
      .crumbs a:hover{color:var(--acc)}
      .crumbs .sl{color:#c0b5a4}

      .hero{position:relative;border-bottom:1px solid var(--ink);aspect-ratio:4/5;overflow:hidden}
      .hero img{width:100%;height:100%;object-fit:cover}
      .ph{width:100%;height:100%;background-image:repeating-linear-gradient(135deg,#e5ddce 0 8px,#efe8dc 8px 16px)}
      .hero .cat{position:absolute;top:0;left:0;background:var(--acc);color:#fffdf9;font-family:var(--disp);text-transform:uppercase;font-size:11px;letter-spacing:.14em;padding:6px 11px}
      .hero .pick{position:absolute;top:0;right:0;background:var(--ink);color:#fffdf9;font-family:var(--disp);text-transform:uppercase;font-size:10px;letter-spacing:.12em;padding:6px 10px}
      .cancel-bar{background:var(--acc);color:#fffdf9;font-family:var(--disp);text-transform:uppercase;letter-spacing:.16em;font-weight:600;font-size:13px;text-align:center;padding:10px 12px}
      h1.t.struck{text-decoration:line-through;text-decoration-thickness:3px;opacity:.7}

      .body{padding:20px 16px 24px;border-bottom:8px solid var(--ink)}
      .kicker{font-family:var(--disp);text-transform:uppercase;font-size:11px;letter-spacing:.14em;color:var(--acc);margin-bottom:9px}
      h1.t{font-family:var(--disp);font-size:34px;font-weight:600;line-height:1.03;margin-bottom:12px;text-wrap:pretty}
      p.lead{font-size:16px;line-height:1.55;color:#4a423a;margin-bottom:18px;text-wrap:pretty}
      dl.facts{display:grid;grid-template-columns:auto 1fr;gap:8px 14px;font-size:14px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:14px 0}
      dl.facts dt{color:var(--muted2)}
      dl.facts dd{font-weight:600}
      dl.facts dd a{border-bottom:1px solid var(--acc)}
      .closed-note{margin-left:8px;color:var(--acc);font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap}
      .actions{display:flex;flex-direction:column;gap:8px;margin-top:18px}
      .org-row{margin-top:14px}
      .org-btn{display:inline-block;font-weight:700;font-size:13px;padding:9px 13px;border:1px solid var(--ink);color:var(--ink);text-decoration:none}
      .org-btn:hover{background:var(--ink);color:var(--paper)}
      .org-ok{color:var(--acc);font-weight:700;font-size:13px}
      .org-pending{color:var(--muted);font-size:13px}
      .btn{display:block;text-align:center;font-weight:700;font-size:14px;padding:13px 14px;border-radius:2px;border:1px solid var(--ink);color:var(--ink)}
      .btn.solid{background:var(--ink);color:#fffdf9}
      .btn.solid:hover{background:var(--acc)}
      .btn.ghost:hover{background:var(--ink);color:var(--paper)}
      .srcs{display:flex;flex-wrap:wrap;gap:6px 10px;margin-top:10px;font-family:var(--mono);font-size:12px}
      .srcs a{color:var(--muted)}
      .srcs a:hover{color:var(--acc)}

      .sec{padding:22px 16px 24px}
      .sec-lbl{font-family:var(--disp);text-transform:uppercase;font-size:12px;letter-spacing:.14em;font-weight:600;margin-bottom:12px}
      .editor p{font-size:15px;line-height:1.62;color:#2b2521;text-wrap:pretty}
      .from-src{font-family:var(--mono);font-size:11px;color:var(--muted2);margin-top:8px}

      .map{border:1px solid var(--ink);aspect-ratio:3/2;background-image:repeating-linear-gradient(45deg,#e8e0d2 0 10px,#f0e9de 10px 20px);display:flex;align-items:flex-end;padding:9px}
      .map span{font-family:var(--mono);font-size:11px;color:#857b6f;background:var(--paper);padding:3px 7px}
      .te-map{width:100%;aspect-ratio:3/2;border:1px solid var(--ink);background:#efe8dc}
      .te-map .leaflet-tile-pane{filter:grayscale(1) contrast(.82) brightness(1.06) sepia(.28)}
      .te-map .leaflet-container{font-family:var(--sans)}
      .te-pin{width:12px;height:12px;background:var(--acc);border:2px solid var(--ink)}
      .vcard{display:flex;gap:12px;align-items:center;border:1px solid var(--ink);border-top:none;padding:13px 12px;background:var(--paper2)}
      .vcard:hover{background:var(--panel)}
      .vcard .th{flex:0 0 48px;aspect-ratio:1/1;border:1px solid var(--line);position:relative;overflow:hidden}
      .vcard .th img{width:100%;height:100%;object-fit:cover}
      .vcard .th .ph{position:absolute;inset:0}
      .vcard .vn{font-family:var(--disp);font-size:17px;font-weight:500;line-height:1.15}
      .vcard .vm{font-size:12px;color:var(--muted);margin-top:3px}

      .mini-list{display:flex;flex-direction:column;gap:1px;background:var(--ink);border:1px solid var(--ink)}
      .mini{display:flex;gap:12px;align-items:center;background:var(--paper2);padding:13px 12px;color:var(--ink)}
      .mini:hover{background:var(--panel)}
      .mini .th{flex:0 0 56px;aspect-ratio:1/1;border:1px solid var(--line);position:relative;overflow:hidden}
      .mini .th img{width:100%;height:100%;object-fit:cover}
      .mini .th .ph{position:absolute;inset:0}
      .mini .tm{font-size:11px;font-weight:800;letter-spacing:.08em;color:var(--acc);margin-bottom:4px}
      .mini .mt{font-family:var(--disp);font-size:17px;font-weight:500;line-height:1.15}
      .mini .mv{font-size:12px;color:var(--muted);margin-top:3px}

      .admin-edit{position:fixed;right:16px;bottom:16px;z-index:60;background:var(--ink);color:#fffdf9;font-family:var(--disp);text-transform:uppercase;font-size:12px;letter-spacing:.1em;font-weight:600;padding:11px 16px;border:1px solid var(--ink);box-shadow:4px 4px 0 var(--shadow)}
      .admin-edit:hover{background:var(--acc);border-color:var(--acc)}
      .related{border-top:1px solid var(--ink);padding:24px 16px 30px}
      .related .rh{display:flex;align-items:baseline;gap:12px;margin-bottom:18px}
      .related h2{font-family:var(--disp);font-size:24px;font-weight:600;text-transform:uppercase}
      .related .rl{color:var(--acc);font-size:13px;font-weight:700;white-space:nowrap}
      .related .rule{height:1px;background:var(--line);flex:1}

      @media(min-width:1000px){
        .wrap{max-width:1200px}
        .hdr{gap:22px;padding:16px 40px}
        .brand{font-size:24px}
        .crumbs{padding:12px 40px}
        .hero{aspect-ratio:auto;height:440px}
        .split{display:grid;grid-template-columns:1fr 400px}
        .split > .main{padding:40px 40px 44px;border-right:1px solid var(--line);border-bottom:none}
        .split > .aside{padding:36px 32px 44px;display:flex;flex-direction:column;gap:28px}
        .split > .aside .sec{padding:0}
        h1.t{font-size:52px;line-height:1;margin-bottom:16px}
        p.lead{font-size:19px;max-width:680px}
        .body{border-bottom:none;padding:0}
        .editor{border-top:8px solid var(--ink);padding-top:24px;max-width:680px}
        .card-box{border:1px solid var(--ink);background:var(--paper2);padding:22px 20px}
        .related{padding:32px 40px 44px}
      }
    style
      include ./_card.css
  body
    .wrap
      header.hdr
        a.back(href=backHref) ←
        .brand
          | Tbiliseli #[span.acc Events]
        .langs
          each l in langLinks
            a(href=l.href class=l.active ? 'lang on' : 'lang')= l.code

      +crumbs(crumbs)

      if ev.cancelled
        .cancel-bar= t.cancelled

      .hero
        if ev.imageUrl
          img(src=ev.imageUrl alt=ev.displayTitle)
        else
          .ph
        if ev.typeLabel
          span.cat= ev.typeLabel
        if ev.editorsPick
          span.pick= t.heroKicker + ' · ' + t.heroSub

      .split
        .main
          .body
            .kicker= dateLong + (ev.time ? ' · ' + ev.time : '')
            h1.t(class=ev.cancelled ? 'struck' : '')= ev.displayTitle
            if ev.desc
              p.lead= ev.desc
            dl.facts
              dt= t.when
              dd= dateLong + (ev.time ? ', ' + ev.time : '')
              if ev.venueName || ev.place
                dt= t.where
                if venue && ev.venueName
                  dd
                    a(href=venueHref)= ev.venueName
                    if venueClosedLabel
                      span.closed-note= venueClosedLabel
                else
                  dd= ev.place
              if ev.langLabel
                dt= t.language
                dd= ev.langLabel
              if ev.typeLabel
                dt= t.category
                dd= ev.typeLabel
              if ev.price
                dt= t.price
                dd= ev.price
            .actions
              if ev.primaryUrl
                a.btn.solid(href=ev.primaryUrl target='_blank' rel='noopener noreferrer')= t.onSite
              if (ev.sources || []).length
                .srcs
                  span= t.sourcesLabel + ':'
                  each s in ev.sources
                    if s.safe
                      a(href=s.url target='_blank' rel='noopener noreferrer')= s.label
                    else
                      span= s.label
            .org-row
              if organizerState === 'approved'
                span.org-ok= t.orgYouAre
              else if organizerState === 'new'
                span.org-pending= t.orgPending
              else if user
                a.org-btn(href=organizerHref)= t.orgClaim
              else
                a.org-btn(href=loginHref)= t.orgClaim

          if ev.editorNoteText
            .sec.editor
              .sec-lbl= t.fromEditor
              each para in ev.editorNoteText.split(/\n\n+/)
                p= para
          else if ev.rawExcerpt
            .sec.editor
              .sec-lbl= t.fromEditor
              p= ev.rawExcerpt
              .from-src= t.sourcesLabel + ': ' + (ev.sources && ev.sources[0] ? ev.sources[0].label : '')

        .aside
          if venue
            .sec
              .sec-lbl Как добраться
              if venue.lat != null && venue.lng != null
                +cityMap(venue.lat, venue.lng, venue.name)
              else
                a.map(href=mapHref target='_blank' rel='noopener noreferrer')
                  span= venue.name
              a.vcard(href=venueHref)
                .th
                  if venue.imageUrl
                    img(src=venue.imageUrl alt=venue.name)
                  else
                    .ph
                div
                  .vn= venue.name
                  .vm= [venue.area, venueEventsCount ? venueEventsCount + '+' : null].filter(Boolean).join(' · ')

          if sameDay.length
            .sec
              .sec-lbl В этот же день
              .mini-list
                each s in sameDay
                  a.mini(href=s.href)
                    .th
                      if s.imageUrl
                        img(src=s.imageUrl alt=s.title)
                      else
                        .ph
                    div
                      if s.time
                        .tm= s.time
                      .mt= s.displayTitle
                      if s.venueName || s.place
                        .mv= s.venueName || s.place

      if related.length
        .related
          .rh
            h2= (ev.typeLabel || '') + ' ' + t.upcoming
            .rule
            if relatedHref
              a.rl(href=relatedHref) →
          .cards.grid3
            each r in related
              +eventCard(r)

    if isAdmin
      a.admin-edit(href=editHref) ✎ Редактировать
