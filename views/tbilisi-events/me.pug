doctype html
html(lang=lang)
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1')
    title= title
    include _analytics.pug
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Oswald:wght@600&display=swap')
    style.
      :root{--bg:#e6ded1;--paper2:#fffdf9;--ink:#14110e;--acc:#e2402a;--line:#ded4c4;--muted:#6f665c;--panel:#f2ebe0;--sans:'Manrope',system-ui,sans-serif;--disp:'Oswald',sans-serif}
      *{box-sizing:border-box;margin:0;padding:0}
      body{background:var(--bg);color:var(--ink);font-family:var(--sans);padding:32px 16px}
      .wrap{max-width:560px;margin:0 auto}
      h1{font-family:var(--disp);text-transform:uppercase;font-size:26px;border-bottom:8px solid var(--ink);padding-bottom:10px;margin-bottom:20px}
      .row{border:1px solid var(--line);background:var(--paper2);padding:14px 16px;margin-bottom:12px}
      .k{font-family:var(--disp);text-transform:uppercase;font-size:11px;letter-spacing:.1em;color:var(--muted);margin-bottom:4px}
      .v{font-size:14px}
      a.btn,button.btn{display:inline-block;font:inherit;font-weight:700;font-size:13px;padding:10px 15px;border:1px solid var(--ink);background:var(--ink);color:var(--paper2);text-decoration:none;cursor:pointer}
      a.btn:hover,button.btn:hover{background:var(--acc);border-color:var(--acc)}
      button.link{font:inherit;font-size:12px;background:none;border:none;color:var(--muted);text-decoration:underline;cursor:pointer;padding:0;margin-top:8px}
      .ok{color:var(--acc);font-weight:700}
      .warn{background:var(--acc);color:var(--paper2);font-size:12px;padding:6px 10px;margin-top:8px;display:inline-block}
      form{display:inline}
  body
    .wrap
      h1 Your account
      .row
        .k Email
        .v= user.email
      .row
        .k Telegram
        if tgLinked
          .v #[span.ok Linked ✓]
          if tgBlocked
            .warn The bot is blocked — unblock it in Telegram to get notifications
          form(method='POST' action=base + '/me/telegram/unlink')
            button.link(type='submit') Unlink
        else
          .v Link Telegram to get updates about your events here.
          if tgDeepLink
            p(style='margin-top:10px')
              a.btn(href=tgDeepLink target='_blank' rel='noopener') Link Telegram
          else
            p(style='margin-top:10px;color:var(--muted);font-size:13px') Reload to get a link.
      p(style='margin-top:20px')
        a(href=base + '/' style='color:var(--muted);font-size:13px') ← Back to the listing
        span(style='color:var(--muted)')  ·
        form(method='POST' action=base + '/auth/logout')
          button.link(type='submit') Sign out
