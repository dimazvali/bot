doctype html
html(lang=lang)
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1')
    title= title
    include _analytics.pug
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Oswald:wght@600&display=swap')
    style.
      :root{--bg:#e6ded1;--paper2:#fffdf9;--ink:#14110e;--acc:#e2402a;--line:#ded4c4;--muted:#6f665c;--sans:'Manrope',system-ui,sans-serif;--disp:'Oswald',sans-serif}
      *{box-sizing:border-box;margin:0;padding:0}
      body{background:var(--bg);color:var(--ink);font-family:var(--sans);min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:24px}
      .card{width:min(360px,92vw);border:1px solid var(--ink);background:var(--paper2);padding:28px 24px;text-align:center}
      h1{font-family:var(--disp);text-transform:uppercase;font-size:20px;margin-bottom:10px}
      p{font-size:14px;color:var(--muted);margin-bottom:18px}
      button.btn{font:inherit;font-weight:700;font-size:14px;padding:11px 20px;border:1px solid var(--ink);background:var(--ink);color:var(--paper2);cursor:pointer}
      button.btn:hover{background:var(--acc);border-color:var(--acc)}
  body
    .card
      h1 Confirm sign-in
      p Click to finish signing in to events.tbiliseli.com.
      form(method='POST' action=base + '/auth/magic')
        input(type='hidden' name='token' value=token)
        input(type='hidden' name='lang' value=lang)
        button.btn(type='submit') Sign in
