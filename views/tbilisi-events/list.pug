doctype html
include _card.pug
include _suggest-link.pug
html(lang=lang)
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1')
    title= title
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Oswald:wght@500;600&family=Noto+Sans+Georgian:wght@400;500;600&display=swap')
    style.
      :root{
        --bg:#e6ded1; --paper:#faf6f0; --paper2:#fffdf9; --ink:#14110e; --acc:#e2402a;
        --muted:#6f665c; --muted2:#8b8175; --line:#ded4c4; --shadow:#cfc4b3;
        --dark:#14110e; --dark-fg:#f4eee4; --dark-muted:#a49a8d; --dark-line:#302a23;
        --sans:'Manrope','Noto Sans Georgian',system-ui,sans-serif;
        --disp:'Oswald','Noto Sans Georgian',sans-serif;
        --mono:'Courier New',ui-monospace,monospace;
      }
      *{box-sizing:border-box;margin:0;padding:0}
      body{background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;font-size:15px;line-height:1.5}
      a{color:inherit;text-decoration:none}
      img{max-width:100%;display:block}
      ::selection{background:var(--acc);color:var(--paper)}
      .scr::-webkit-scrollbar{display:none}
      .scr{scrollbar-width:none}

      .wrap{max-width:480px;margin:0 auto;background:var(--paper);min-height:100vh;display:flex;flex-direction:column}
      @media(min-width:520px){.wrap{border-left:1px solid var(--ink);border-right:1px solid var(--ink);margin-top:28px;margin-bottom:60px;min-height:0;box-shadow:12px 12px 0 var(--shadow)}}

      .hdr{background:var(--dark);color:var(--dark-fg);display:flex;align-items:center;gap:12px;padding:12px 16px}
      .brand{font-family:var(--disp);font-size:19px;font-weight:600;text-transform:uppercase;letter-spacing:.01em}
      .brand .acc{color:var(--acc)}
      .menu{display:none}
      .langs{margin-left:auto;display:flex;gap:3px}
      .lang{font-size:11px;font-weight:800;letter-spacing:.08em;padding:4px 7px;border-radius:2px;color:var(--dark-muted)}
      .lang.on{background:var(--acc);color:#fffdf9}

      .nav{display:flex;gap:16px;padding:12px 16px;border-bottom:1px solid var(--ink);font-size:13px;font-weight:700;overflow-x:auto;white-space:nowrap}
      .chip{color:var(--ink);border-bottom:2px solid transparent;padding-bottom:2px}
      .chip.on{color:var(--acc);border-color:var(--acc)}

      .datehead{padding:18px 16px 6px}
      .datehead .back{font-size:12px;font-weight:700;color:var(--acc)}
      .datehead .dh{font-family:var(--disp);font-size:26px;font-weight:600;text-transform:uppercase;margin-top:6px}

      .hero{border-bottom:8px solid var(--ink)}
      .hero-media,.card-media{position:relative;border:1px solid var(--line);overflow:hidden;display:block}
      .hero-media{aspect-ratio:4/3;border:none;border-bottom:1px solid var(--ink)}
      .hero-media img,.card-media img{width:100%;height:100%;object-fit:cover}
      .ph{width:100%;height:100%;background-image:repeating-linear-gradient(135deg,#e5ddce 0 7px,#efe8dc 7px 14px)}
      .hero-media .ph,.card-media .ph{position:absolute;inset:0}
      .cat{position:absolute;top:0;left:0;background:var(--ink);color:#fffdf9;font-family:var(--disp);font-size:11px;letter-spacing:.1em;text-transform:uppercase;padding:4px 9px}
      .hero-flag{position:absolute;top:0;right:0;background:var(--acc);color:#fffdf9;font-family:var(--disp);text-transform:uppercase;font-size:10px;letter-spacing:.12em;padding:5px 9px}
      .hero-body{padding:18px 16px 22px}
      .hero-cat{font-family:var(--disp);text-transform:uppercase;font-size:11px;letter-spacing:.14em;color:var(--acc);margin-bottom:8px}
      .hero-title{display:block;font-family:var(--disp);font-weight:600;font-size:31px;line-height:1.05;margin-bottom:10px;letter-spacing:-.005em;text-wrap:pretty;color:var(--ink)}
      .hero-title:hover{color:var(--acc)}
      .hero-lead{font-size:15px;color:#4a423a;margin-bottom:14px;text-wrap:pretty}
      dl.meta{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:14px;border-top:1px solid var(--line);padding-top:12px}
      dl.meta dt{color:var(--muted2)}
      dl.meta dd{font-weight:600}
      dl.meta dd a{border-bottom:1px solid var(--acc)}
      .hero-actions{display:flex;gap:8px;margin-top:16px}
      .btn{display:inline-block;text-align:center;font-weight:700;font-size:14px;padding:13px 16px;border-radius:2px;border:1px solid var(--ink);color:var(--ink)}
      .btn.solid{background:var(--ink);color:#fffdf9;flex:1}
      .btn.solid:hover{background:var(--acc)}
      .btn.ghost:hover{background:var(--ink);color:var(--paper)}

      .dates{padding:16px 0 8px}
      .dates-head{display:flex;align-items:center;gap:10px;padding:0 16px 12px}
      .dates-head .lbl{font-family:var(--disp);text-transform:uppercase;font-size:12px;letter-spacing:.14em;font-weight:600}
      .dates-head .rule{height:1px;background:var(--line);flex:1}
      .strip{display:flex;gap:6px;padding:0 16px 4px;overflow-x:auto}
      .day{flex:0 0 auto;border:1px solid #d6cdbe;border-radius:2px;padding:8px 12px;min-width:62px;color:var(--ink)}
      .day.has{border-color:var(--ink)}
      .day.on{background:var(--ink);color:var(--paper);border-color:var(--ink)}
      .day .wd{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.1em;opacity:.7}
      .day .dm{display:block;font-family:var(--disp);font-size:19px;font-weight:500;line-height:1.2}
      .day .cnt{display:block;font-size:10px;color:var(--acc);font-weight:700}
      .day.on .cnt{color:#f4b7ac}
      details.cal{margin:8px 16px 0;border:1px solid var(--line)}
      details.cal summary{cursor:pointer;list-style:none;padding:8px 12px;font-family:var(--disp);text-transform:uppercase;font-size:11px;letter-spacing:.12em;font-weight:600}
      details.cal summary::-webkit-details-marker{display:none}
      .cal-nav{display:flex;align-items:center;gap:8px;padding:6px 12px}
      .cal-nav a{font-size:16px;color:var(--acc);padding:0 6px}
      .cal-nav strong{font-family:var(--disp);text-transform:uppercase;font-size:13px}
      table.calgrid{width:100%;border-collapse:collapse;font-size:12px}
      table.calgrid th{color:var(--muted2);font-weight:600;padding:4px;text-transform:uppercase}
      table.calgrid td{height:34px;text-align:center;border:1px solid #efe8dc}
      table.calgrid td.empty{border:none}
      table.calgrid td.has{background:#f0e7d8}
      table.calgrid td.today{outline:2px solid var(--acc);outline-offset:-2px}
      table.calgrid td.sel{background:var(--ink);color:var(--paper)}
      table.calgrid td .n{display:block;line-height:1}
      table.calgrid td .c{display:block;font-size:9px;color:var(--acc)}
      table.calgrid td.sel .c{color:#f4b7ac}

      .list{padding:20px 16px 26px}
      .list-head{display:flex;align-items:baseline;gap:9px;margin-bottom:16px}
      .list-head h2{font-family:var(--disp);font-size:26px;font-weight:600;text-transform:uppercase}
      .list-head .cnt{font-size:13px;color:var(--muted)}
      .empty{color:var(--muted);font-size:14px}
      .more{display:block;text-align:center;margin-top:24px;border:1px solid var(--ink);font-weight:700;font-size:14px;padding:13px}

      .weekend{background:var(--dark);color:var(--dark-fg);padding:26px 16px 28px}
      .weekend h2{font-family:var(--disp);font-size:26px;font-weight:600;text-transform:uppercase;margin-bottom:16px;text-wrap:pretty}
      .wk-list{display:flex;flex-direction:column;gap:1px;background:var(--dark-line)}
      .wk{display:block;background:var(--dark);padding:16px 14px;color:var(--dark-fg)}
      .wk-wd{font-family:var(--disp);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);margin-bottom:8px}
      .wk-t{font-family:var(--disp);font-size:19px;font-weight:500;line-height:1.15;margin-bottom:6px;text-wrap:pretty}
      .wk-meta{font-size:13px;color:var(--dark-muted)}

      .rubrics{padding:24px 16px 28px}
      .rub-head{display:flex;align-items:center;gap:10px;margin-bottom:14px}
      .rub-head .lbl{font-family:var(--disp);text-transform:uppercase;font-size:12px;letter-spacing:.14em;font-weight:600}
      .rub-head .rule{height:1px;background:var(--line);flex:1}
      .rub-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
      .rub{display:flex;flex-direction:column;gap:6px;border:1px solid var(--ink);padding:13px 12px;background:var(--paper2)}
      .rub:hover{background:var(--ink);color:var(--paper)}
      .rub-name{font-family:var(--disp);font-size:17px;font-weight:500;text-transform:uppercase;line-height:1.1}
      .rub-cnt{font-family:var(--mono);font-size:12px;opacity:.6}

      .picks .pk-list{display:flex;flex-direction:column;gap:12px;margin-bottom:12px}
      .pk{display:flex;gap:12px;align-items:center}
      .pk-ava{width:46px;height:46px;flex:none;border:1px solid var(--ink);border-radius:50%;overflow:hidden;background-image:repeating-linear-gradient(135deg,#e5ddce 0 6px,#efe8dc 6px 12px)}
      .pk-ava img{width:100%;height:100%;object-fit:cover}
      .pk-t{font-family:var(--disp);font-size:17px;font-weight:500;text-transform:uppercase;line-height:1.1}
      .pk-h{font-size:12px;color:var(--muted2)}
      .pk:hover .pk-t{color:var(--acc)}

      .ftr{border-top:1px solid var(--ink);background:#f2ebe0;padding:22px 16px 26px}
      .ftr .note{font-size:13px;color:var(--muted);margin-bottom:14px;text-wrap:pretty}
      .ftr .flinks{display:flex;flex-wrap:wrap;gap:10px 16px;font-family:var(--mono);font-size:12px}
      .ftr .flinks a{color:#4a423a}
      .ftr .flinks a:hover{color:var(--acc)}

      @media(min-width:1000px){
        .wrap{max-width:1200px}
        .hdr{gap:26px;padding:16px 40px;order:1;position:relative;z-index:20}
        .brand{font-size:26px}
        .nav{display:none}
        .menu{display:block;position:relative;margin-left:auto}
        .menu summary{list-style:none;cursor:pointer;width:36px;height:36px;border:1px solid #3a332b;display:flex;align-items:center;justify-content:center;color:var(--dark-fg)}
        .menu summary::-webkit-details-marker{display:none}
        .menu summary::before{content:"\2630";font-size:18px}
        .menu[open] summary::before{content:"\00d7";font-size:22px}
        .menu-panel{position:absolute;right:0;top:calc(100% + 8px);background:var(--dark);border:1px solid #3a332b;min-width:230px;display:flex;flex-direction:column}
        .menu-panel a{padding:12px 16px;font-size:14px;font-weight:700;color:var(--dark-fg);border-bottom:1px solid #241f1a}
        .menu-panel a:last-child{border-bottom:none}
        .menu-panel a.on,.menu-panel a:hover{color:var(--acc)}
        .langs{margin-left:14px}
        .lang{font-size:12px;padding:6px 9px}

        .dates{order:2;padding:14px 0;background:var(--panel);border-bottom:1px solid var(--ink)}
        .dates-head{padding:0 40px 10px}
        .strip{padding:0 40px 2px}
        .strip .day{flex:1;min-width:78px}
        details.cal{margin:8px 40px 0}

        .datehead{order:3;padding:24px 40px 6px}
        .hero{order:3;display:grid;grid-template-columns:1fr 380px;border-bottom:8px solid var(--ink)}
        .hero-media{aspect-ratio:auto;min-height:360px;border-bottom:none;border-right:1px solid var(--ink)}
        .hero-body{padding:34px 32px 32px;display:flex;flex-direction:column}
        .hero-title{font-size:44px}
        .hero-lead{font-size:17px}
        .hero-actions{margin-top:auto;padding-top:18px}

        .dash{order:4;display:grid;grid-template-columns:minmax(0,1fr) 380px}
        .dash > .list{padding:32px 32px 40px 40px;border-right:1px solid var(--line);min-width:0}
        .list-head h2{font-size:34px}
        .dash-side{display:flex;flex-direction:column}
        .dash-side .weekend{padding:30px 28px 32px}
        .dash-side .rubrics{padding:28px 28px 34px}
        .rub-grid{display:flex;flex-direction:column;gap:1px;background:var(--ink);border:1px solid var(--ink)}
        .rub{flex-direction:row;align-items:baseline;justify-content:space-between;border:none;padding:14px 14px}

        .ftr{order:5;padding:26px 40px 30px;display:flex;gap:40px;align-items:baseline}
        .ftr .note{margin-bottom:0;max-width:520px}
        .ftr .flinks{margin-left:auto}
      }
    style
      include _card.css
  body
    .wrap
      header.hdr
        .brand
          | Tbiliseli #[span.acc= t.brandTail]
        details.menu
          summary
          .menu-panel
            each n in navLinks
              a(href=n.href class=n.active ? 'on' : '')= n.label
        .langs
          each l in langLinks
            a(href=l.href class=l.active ? 'lang on' : 'lang')= l.code

      nav.nav.scr
        each n in navLinks
          a(href=n.href class=n.active ? 'chip on' : 'chip')= n.label

      if dateParam
        .datehead
          a.back(href=allUpcomingHref)= t.allUpcoming
          .dh= dateHeading
      else if hero
        section.hero
          a.hero-media(href=hero.href)
            if hero.imageUrl
              img(src=hero.imageUrl alt=hero.displayTitle loading='lazy')
            else
              .ph
            span.hero-flag= t.heroKicker + ' · ' + t.heroSub
            if hero.typeLabel
              span.cat= hero.typeLabel
          .hero-body
            .hero-cat= heroDate + (hero.time ? ' · ' + hero.time : '')
            a.hero-title(href=hero.href)= hero.displayTitle
            if hero.desc
              p.hero-lead= hero.desc
            dl.meta
              dt= t.when
              dd= heroDate + (hero.time ? ', ' + hero.time : '')
              if hero.venueName || hero.place
                dt= t.where
                if hero.venueId && hero.venueName
                  dd
                    a(href=base + '/venues/' + hero.venueId + (lang !== 'ru' ? '?lang=' + lang : ''))= hero.venueName
                else
                  dd= hero.place
              if hero.langLabel
                dt= t.language
                dd= hero.langLabel
              if hero.typeLabel
                dt= t.category
                dd= hero.typeLabel
            .hero-actions
              a.btn.solid(href=hero.href)= t.readMore
              if hero.primaryUrl
                a.btn.ghost(href=hero.primaryUrl target='_blank' rel='noopener noreferrer')= t.onSite

      section.dates
        .dates-head
          span.lbl= t.pickDate
          span.rule
        .strip.scr
          each d in dayStrip
            a(href=d.href class=d.active ? 'day on' : (d.count ? 'day has' : 'day'))
              span.wd= d.wd
              span.dm= d.dm
              if d.count
                span.cnt= d.count
        details.cal
          summary= t.calendar
          .cal-nav
            a(href=calendar.prevHref) ‹
            strong= calendar.monthLabel
            a(href=calendar.nextHref) ›
          table.calgrid
            thead
              tr
                each w in calWeekdays
                  th= w
            tbody
              each week in calendar.weeks
                tr
                  each cell in week
                    if !cell
                      td.empty
                    else
                      td(class=[cell.isSelected && 'sel', !cell.isSelected && cell.count && 'has', cell.isToday && 'today'].filter(Boolean).join(' '))
                        if cell.count
                          a(href=dateLinkFor(cell.date))
                            span.n= cell.day
                            span.c= cell.count
                        else
                          span.n= cell.day

      .dash
        section.list
          .list-head
            h2= dateParam ? t.onDate : (showAll ? t.upcoming : t.today)
            span.cnt= countLabel
          if !hero && !listEvents.length
            p.empty= dateParam ? t.nothing : t.nothingUpcoming
          .cards.grid3
            each e in listEvents
              +eventCard(e)
          if listTruncated
            a.more(href=showAllHref)= t.showAllUpcoming
          else if showAll
            a.more(href=allUpcomingHref)= t.allUpcoming
          else if !dateParam
            a.more(href=showPastHref)= t.showPast

        .dash-side
          if weekend.length
            section.weekend
              h2= t.weekendHeading
              .wk-list
                each w in weekend
                  if w.href
                    a.wk(href=w.href target='_blank' rel='noopener noreferrer')
                      .wk-wd= w.wd
                      .wk-t= w.title
                      .wk-meta= w.meta
                  else
                    .wk
                      .wk-wd= w.wd
                      .wk-t= w.title
                      .wk-meta= w.meta

          if rubrics.length
            section.rubrics
              .rub-head
                span.lbl= t.rubrics
                span.rule
              .rub-grid
                each r in rubrics
                  a.rub(href=r.href)
                    span.rub-name= r.label
                    span.rub-cnt= r.count

          if curated && curated.length
            section.rubrics.picks
              .rub-head
                span.lbl= t.collectionsTitle
                span.rule
              .pk-list
                each c in curated
                  a.pk(href=c.href)
                    .pk-ava
                      if c.heroImage
                        img(src=c.heroImage alt=c.heroName loading='lazy')
                    div
                      .pk-t= c.title
                      if c.heroName
                        .pk-h #{t.curatedBy} #{c.heroName}

      footer.ftr
        p.note= t.footer
        p.flinks
          a(href=venuesHref)= t.venues
          +suggestLink(base, user)
          each l in langLinks
            a(href=l.href)= l.code
