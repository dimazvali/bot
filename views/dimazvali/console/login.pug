include _console.pug
+consolePage({ title: 'Вход', bare: true })
  .login-card
    h1 Консоль
      span.acc  бота
    p.sub Вход через Telegram — для админов @#{botUsername}
    if error
      p.error= error
    #tg-login
      script(async src='https://telegram.org/js/telegram-widget.js?22' data-telegram-login=botUsername data-size='large' data-onauth='onTelegramAuth(user)' data-request-access='write')
    p#tg-error.error(style='display:none')
  script.
    function onTelegramAuth(user) {
      var err = document.getElementById('tg-error');
      fetch(!{JSON.stringify(authUrl)}, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(user)
      }).then(function(r) {
        if (r.ok) { location.href = !{JSON.stringify(base + '/')}; return; }
        err.textContent = r.status === 403 ? 'Этот аккаунт — не админ бота' : 'Не получилось войти (' + r.status + ')';
        err.style.display = 'block';
      }).catch(function(e) { err.textContent = e.message; err.style.display = 'block'; });
    }
