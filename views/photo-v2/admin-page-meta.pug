extends ../photo/admin/layout
block vars
  - var nav = 'page-meta'
block breadcrumbs
  span Метатеги
block actions
  a.admin-btn(href='/' target='_blank' rel='noopener') сайт ↗
block content
  p.admin-hint
    | Title и description основных страниц (они же og:title / og:description). В полях — то, что сейчас на сайте.
    | Очищенное поле возвращает значение по умолчанию (оно показано серым).
  if saved
    .admin-notice.admin-notice--ok ✓ Сохранено

  form(method='POST' action='/admin/page-meta')
    each lang in ['ru', 'en']
      .admin-section
        h2.admin-title= lang === 'ru' ? 'РУССКИЙ' : 'ENGLISH'
        each p in pages
          - var base = lang + '_' + p.key + '_'
          - var href = (lang === 'en' ? '/en' : '') + p.path
          p.admin-subtitle
            = p.label + ' '
            a(href=href target='_blank' rel='noopener')= href
          input.admin-input(type='text' name=base + 'title' value=values[lang][p.key].title placeholder=defaults[lang][p.key].title maxlength=max.title)
          textarea.admin-input(name=base + 'desc' rows='2' placeholder=defaults[lang][p.key].desc maxlength=max.desc)= values[lang][p.key].desc
    button.admin-btn(type='submit') СОХРАНИТЬ
