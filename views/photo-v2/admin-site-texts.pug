extends ../photo/admin/layout
block vars
  - var nav = 'site-texts'
block breadcrumbs
  span Тексты сайта
block actions
  a.admin-btn(href='/' target='_blank' rel='noopener') сайт ↗
block content
  p.admin-hint Пустое поле — используется текст по умолчанию (он показан серым в подсказке). Перенос строки сохраняется.
  if saved
    .admin-notice.admin-notice--ok ✓ Сохранено

  form(method='POST' action='/admin/site-texts')
    each lang in ['ru', 'en']
      .admin-section
        h2.admin-title= lang === 'ru' ? 'РУССКИЙ' : 'ENGLISH'
        p.admin-subtitle Надзаголовок (над именем)
        input.admin-input(type='text' name=`${lang}_homeKicker` value=values[lang].homeKicker || '' placeholder=defaults[lang].homeKicker maxlength=max)
        p.admin-subtitle Текст справа от имени
        textarea.admin-input(name=`${lang}_homeLead` rows='4' placeholder=defaults[lang].homeLead maxlength=max)= values[lang].homeLead || ''
    button.admin-btn(type='submit') СОХРАНИТЬ
