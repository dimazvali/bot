extends layout

block content
  - var LP = lang === 'en' ? '/en' : ''
  .about-page
    .about-head
      .kicker= t.about
      h1.hero-title
        | #{t.heroName[0]}#{' '}
        br
        | #{t.heroName[1]}
    .about-grid
      img.about-photo(src='https://storage.googleapis.com/photo-dimazvalimisc/images/ks-05065-1780908582473-800.webp' alt='Дмитрий Шестаков — фотограф и разработчик из Тбилиси' title='Дмитрий Шестаков')
      .about-copy
        if lang === 'en'
          p.about-text.
            გამარჯობა!
            My name is Dmitry Shestakov. I'm a journalist from Saint Petersburg by training. But mostly — a developer based in Tbilisi. Or a photographer. Or a cyclist. Depends on the day.
        else
          p.about-text.
            გამარჯობა!
            Меня зовут Дмитрий Шестаков. И вообще-то я журналист из Петербурга. Но в частности — разработчик из Тбилиси. Или фотограф. Или велосипедист. По обстоятельствам.
        .about-contact
          span.about-label= ui.contactLabel
          a.about-link(href='mailto:dimazvali@gmail.com') email
          a.about-link(href='https://telegram.me/dimazvali') telegram
          a.about-link(href='https://www.instagram.com/dimazvali2') instagram

        if sent === 'contact'
          p.about-sent= ui.sentContact
        if sent === 'review'
          p.about-sent= ui.sentReview

        .about-accordion#write
          button.about-accordion-btn(type='button' aria-expanded='false' data-target='#about-contact-form')= ui.writeToMe
          .about-accordion-body#about-contact-form
            form.about-form(method='POST' action=`${LP}/contact`)
              input.about-input(type='email' name='email' placeholder=ui.emailPlaceholder)
              textarea.about-input(name='message' rows='4' placeholder=ui.messagePlaceholder required)
              button.btn.btn--ink.about-submit(type='submit')= ui.submit

        .about-accordion
          button.about-accordion-btn(type='button' aria-expanded='false' data-target='#about-review-form')= ui.leaveReview
          .about-accordion-body#about-review-form
            form.about-form(method='POST' action=`${LP}/review`)
              input.about-input(type='text' name='name' placeholder=ui.namePlaceholder)
              textarea.about-input(name='text' rows='4' placeholder=ui.reviewPlaceholder required)
              button.btn.btn--ink.about-submit(type='submit')= ui.submit

  script.
    document.querySelectorAll('.about-accordion-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        var body = document.querySelector(btn.dataset.target);
        body.style.maxHeight = expanded ? '0' : body.scrollHeight + 'px';
      });
    });
    // /about#write (the "prints & licences" button on the home page) opens the contact form right away
    if (location.hash === '#write') {
      var wb = document.querySelector('#write .about-accordion-btn');
      if (wb) wb.click();
    }
