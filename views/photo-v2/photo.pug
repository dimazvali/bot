        }
      }, { passive: true });

      // Fills the caption from the same title/description block that is shown under the photo.
      // Collapsed: title + one line of the description; opens (scrollable) on tap, wheel or an upward swipe.
      // The reader's choice (expanded or not) is remembered: it survives switching frames and page reloads,
      // so it doesn't have to be re-opened on every photo.
      var LB_INFO_KEY = 'photoLbInfoOpen';
      var lbInfoWanted = false;
      try { lbInfoWanted = localStorage.getItem(LB_INFO_KEY) === '1'; } catch (e) {}
      function refreshLbInfo() {
        var t = document.querySelector('.photo-page-title');
        // camera file names (IMG_1234…) aren't titles — don't show them in the caption
        if (t && /^img_/i.test(t.textContent.trim())) t = null;
        var d = document.querySelector('.photo-page-desc');
        lbInfo.textContent = '';
        lbInfo.classList.remove('is-open', 'has-more');
        if (!t && !d) { lbInfo.style.display = 'none'; return; }
        lbInfo.style.display = '';
        var cap = document.createElement('div');
        cap.className = 'lb-info-inner';
        if (t) { var h = document.createElement('h2'); h.className = 'lb-info-title'; h.textContent = t.textContent; cap.appendChild(h); }
        if (d) { var pd = document.createElement('p'); pd.className = 'lb-info-desc'; pd.textContent = d.textContent; cap.appendChild(pd); }
        lbInfo.appendChild(cap);
        // expandable only when the description doesn't fit on its single collapsed line (measured collapsed, in place)
        var pd2 = lbInfo.querySelector('.lb-info-desc');
        if (pd2 && pd2.scrollHeight > pd2.clientHeight + 1) {
          lbInfo.classList.add('has-more');
          if (lbInfoWanted) lbInfo.classList.add('is-open');
        }
      }
      function setLbInfoOpen(open) {
        if (!lbInfo.classList.contains('has-more')) return; // short/no description: nothing to expand, keep the remembered choice
        if (lbInfo.classList.contains('is-open') === open) return;
        lbInfo.classList.toggle('is-open', open);
        lbInfoWanted = open;
        window.photoTrack && window.photoTrack('lightbox_caption_toggle', { open: open });
        try { localStorage.setItem(LB_INFO_KEY, open ? '1' : '0'); } catch (e) {}
        if (!open) lbInfo.scrollTop = 0;
      }
      lbInfo.addEventListener('click', function(e) {
        e.stopPropagation(); // the layer must not close the lightbox
        setLbInfoOpen(!lbInfo.classList.contains('is-open'));
      });
      lbInfo.addEventListener('wheel', function() { setLbInfoOpen(true); }, { passive: true });
      var infoTouchY = null;
      lbInfo.addEventListener('touchstart', function(e) { infoTouchY = e.touches[0].clientY; }, { passive: true });
      lbInfo.addEventListener('touchmove', function(e) {
        if (infoTouchY !== null && infoTouchY - e.touches[0].clientY > 12) setLbInfoOpen(true);
      }, { passive: true });

      // (re)points the lightbox at whatever photo is currently shown in the main view —
      // called on open, and again after a swipe/soft-nav while the lightbox stays open.
      function refreshLbImage() {
        var pageImg = document.querySelector('.photo-page-image .photo-image-wrap img');
        if (!pageImg) return;
        var isPano = pageImg.dataset.panorama === '1';
        lb.classList.toggle('lb-pan', isPano);
        panState.active = isPano;
        panState.scale = 1; panState.tx = 0; panState.ty = 0; panState.maxScale = 1;
        lbImg.style.transition = '';
        applyPanTransform();
        if (isPano) {
          lbImg.removeAttribute('srcset'); lbImg.removeAttribute('sizes');
          lbImg.src = pageImg.dataset.panoSrc || pageImg.src;
        } else {
          var pageSrcset = pageImg.getAttribute('srcset');
          if (pageSrcset) { lbImg.sizes = PAGE_SIZES; lbImg.srcset = pageSrcset; } else { lbImg.removeAttribute('srcset'); lbImg.removeAttribute('sizes'); }
          lbImg.src = pageImg.src;
        }
        refreshLbInfo();
        function onLoaded() {
          addLbAnnots();
          if (isPano) panState.maxScale = Math.max(2, Math.min(10, lbImg.naturalWidth / (lbImg.offsetWidth || 1)));
        }
        if (lbImg.complete && lbImg.naturalWidth) onLoaded();
        else lbImg.addEventListener('load', onLoaded, { once: true });
      }
      function openLb() {
        var pageImg = document.querySelector('.photo-page-image .photo-image-wrap img');
        if (!pageImg) return;
        var popup = document.getElementById('annot-popup');
        if (popup) popup.style.display = 'none';
        lb.classList.add('lb-open');
        document.body.style.overflow = 'hidden';
