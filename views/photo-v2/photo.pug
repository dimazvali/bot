        if (panState.active) return;
        closeLb();
      });
      lbClose.addEventListener('click', function(e) { e.stopPropagation(); closeLb(); });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && lb.classList.contains('lb-open')) closeLb();
      });

      document.addEventListener('click', function(e) {
        var link = e.target.closest && e.target.closest('.nav-btn[href]');
        if (link && main.contains(link)) {
          e.preventDefault();
          navigate(link.getAttribute('href'));
          return;
        }

        var pageImgEl = e.target.closest && e.target.closest('.photo-page-image .photo-image-wrap img');
        if (pageImgEl) { openLb(); return; }

        var annotBtn = e.target.closest && e.target.closest('.photo-annot');
        var popup = document.getElementById('annot-popup');
        if (annotBtn && popup) {
          document.getElementById('annot-popup-text').textContent = annotBtn.dataset.author ? (window.PhotoI18n.t.pointAuthorPrefix + ' ' + annotBtn.dataset.author + '\n' + annotBtn.dataset.text) : annotBtn.dataset.text;
          var rect = annotBtn.getBoundingClientRect();
          var popW = 240;
          var top = rect.bottom + 10;
          var left = rect.left + rect.width / 2 - popW / 2;
          left = Math.max(10, Math.min(window.innerWidth - popW - 10, left));
          if (top + 120 > window.innerHeight) top = rect.top - 130;
          if (top < 10) top = 10;
          popup.style.top = top + 'px';
          popup.style.left = left + 'px';
          popup.style.display = 'block';
          return;
        }
        if (popup && popup.style.display === 'block' && !popup.contains(e.target)) {
          popup.style.display = 'none';
        }

        // v2 (admin, shoot photo): add to / remove from the author's pick via the existing admin endpoint
        var pickBtn = e.target.closest && e.target.closest('[data-curator-toggle]');
        if (pickBtn) {
          if (pickBtn.disabled) return;
          var wasPicked = pickBtn.dataset.picked === '1';
          pickBtn.disabled = true;
          fetch('/admin/shoots/' + encodeURIComponent(pickBtn.dataset.slug) + '/photos/bulk-curator-pick', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: [pickBtn.dataset.photoId], value: !wasPicked }),
          })
            .then(function(r) { return r.json(); })
            .then(function(res) {
              pickBtn.disabled = false;
              if (!res.ok) throw new Error('not ok');
              pickBtn.dataset.picked = wasPicked ? '0' : '1';
              pickBtn.classList.toggle('is-picked', !wasPicked);
              pickBtn.textContent = wasPicked ? pickBtn.dataset.labelAdd : pickBtn.dataset.labelRemove;
            })
            .catch(function() {
              pickBtn.disabled = false;
              var orig = pickBtn.textContent;
              pickBtn.textContent = pickBtn.dataset.error || 'Error';
              setTimeout(function() { pickBtn.textContent = orig; }, 2000);
            });
          return;
        }

        // v2: the mobile "buy a print" button jumps straight to the inquiry tab
        var gotoBtn = e.target.closest && e.target.closest('[data-goto-tab]');
        var tabBtn = gotoBtn
          ? document.querySelector('.inquiry-tab[data-tab="' + gotoBtn.dataset.gotoTab + '"]')
          : (e.target.closest && e.target.closest('.inquiry-tab'));
        if (tabBtn) {
          var tab = tabBtn.dataset.tab;
          if (gotoBtn) tabBtn.scrollIntoView({ behavior: 'smooth', block: 'start' });
          document.querySelectorAll('.inquiry-tab').forEach(function(b) {
            b.classList.toggle('is-active', b.dataset.tab === tab);
          });
          document.querySelectorAll('.inquiry-tab-panel').forEach(function(p) {
            p.style.display = p.dataset.panel === tab ? '' : 'none';
          });
