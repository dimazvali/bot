        var popup = document.getElementById('annot-popup');
        if (popup) popup.style.display = 'none';
        panState.active = false;
        mouseDrag = null;
        touchState = null;
      }
      // fullscreen lightbox: the same deck, full-screen cards over the black backdrop. Panoramas keep their own
      // pan/zoom drag; the caption layer is hidden while a card is in flight.
      makeDeckSwipe({
        root: lb,
        start: function(e) {
          if (!lb.classList.contains('lb-open') || lb.classList.contains('lb-pan')) return null;
          if (e.target.closest && e.target.closest('.lb-info, .lb-close')) return null;
          return { holder: lb, wrap: lbWrap };
        },
        width: function() { return window.innerWidth; },
        sizeCard: function() {},                                 // .lb .deck-card is full-screen in CSS
        insertUnder: function(st, c) { lb.insertBefore(c, lbWrap); },
        insertOver: function(st, c) { lb.appendChild(c); },
        onDrag: function() { lbInfo.style.transition = 'opacity .12s'; lbInfo.style.opacity = '0'; },
        onEnd: function() { lbInfo.style.opacity = ''; lbInfo.style.transition = ''; },
        commit: function(target, st, done) {
          // the swap re-points #lb at the new frame (refreshLbImage); once that image is showing, drop the cards
          afterSwap.push(function() {
            var settle = function() { setTimeout(done, 60); };
            if (lbImg.complete && lbImg.naturalWidth) settle();
            else { lbImg.addEventListener('load', settle, { once: true }); lbImg.addEventListener('error', settle, { once: true }); }
          });
          navigate(target.url, false, 'swipe');
        },
      });
      lb.addEventListener('click', function(e) {
        var annotBtn = e.target.closest && e.target.closest('.lb-annot');
        if (annotBtn) {
          e.stopPropagation();
          var popup = document.getElementById('annot-popup');
          var popupText = document.getElementById('annot-popup-text');
          if (popup && popupText) {
            popupText.textContent = annotBtn.dataset.author ? (window.PhotoI18n.t.pointAuthorPrefix + ' ' + annotBtn.dataset.author + '\n' + annotBtn.dataset.text) : annotBtn.dataset.text;
            var rect = annotBtn.getBoundingClientRect();
            var popW = 240;
            var top = rect.bottom + 10;
            var left = rect.left + rect.width / 2 - popW / 2;
            left = Math.max(10, Math.min(window.innerWidth - popW - 10, left));
            if (top + 120 > window.innerHeight) top = rect.top - 130;
            if (top < 10) top = 10;
            popup.style.top = top + 'px';
            popup.style.left = left + 'px';
            popup.style.display = 'block';
          }
          return;
        }
