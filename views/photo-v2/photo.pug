extends layout
include mixins

block head
  if !isShoot
    -
      var _lp = lang === 'en' ? '/en' : ''
      var _imgUrl = photo.urls ? (photo.urls.full || photo.urls.preview) : null
      var _ld = {
        '@context': 'https://schema.org',
        '@type': 'ImageObject',
        name: photo.title,
        contentUrl: _imgUrl,
        thumbnailUrl: photo.urls ? photo.urls.preview : null,
        url: 'https://photo.dimazvali.com' + _lp + '/' + countryKey + '/' + seriesKey + '/' + photo.id,
        creator: { '@type': 'Person', name: 'Dmitry Shestakov', url: 'https://photo.dimazvali.com' + _lp + '/about' },
        copyrightHolder: { '@type': 'Person', name: 'Dmitry Shestakov' },
        copyrightYear: photo.date ? photo.date.match(/\d{4}/) && photo.date.match(/\d{4}/)[0] : null,
        copyrightNotice: '© Dmitry Shestakov. All rights reserved.',
        creditText: 'Dmitry Shestakov / photo.dimazvali.com',
        license: 'https://photo.dimazvali.com' + _lp + '/about',
        acquireLicensePage: 'https://photo.dimazvali.com' + _lp + '/' + countryKey + '/' + seriesKey + '/' + photo.id + '?inquiry=license',
      }
      if (photo.desc) _ld.description = photo.desc
      if (photo.coords) _ld.locationCreated = { '@type': 'Place', geo: { '@type': 'GeoCoordinates', latitude: photo.coords.lat, longitude: photo.coords.lng }, name: countryLabel }
      if (photo.altitude) _ld.altitude = photo.altitude
      if (photo.tags && photo.tags.length) _ld.keywords = photo.tags.map(function(t){ return allTags[t] ? allTags[t].label : t }).join(', ')
      Object.keys(_ld).forEach(function(k){ if (_ld[k] == null) delete _ld[k] })
    script#ld-photo(type='application/ld+json')!= JSON.stringify(_ld)

block content
  - var LP = lang === 'en' ? '/en' : ''
  - var _backHref = isShoot ? `${LP}/shoot/${shootSlug}` : `${LP}/${countryKey}/${seriesKey}`
  - var _backLabel = isShoot ? (backLabel || '') : seriesLabel
  -
    // "3 / 34" position within the series (not known for shoots — the route only hands us prev/next)
    var _pos = null, _total = null
    if (!isShoot && data && data[countryKey] && data[countryKey].series[seriesKey]) {
      var _list = data[countryKey].series[seriesKey].photos || []
      var _ix = _list.findIndex(function(p) { return p.id === photo.id })
      if (_ix !== -1) { _pos = _ix + 1; _total = _list.length }
    }
  //- Responsive frame: the browser picks 800w (preview) or 2400w (full) from the real layout width × device
  //- pixel ratio, so a retina phone still gets the sharp one. The preloader below asks for the SAME candidate.
  - var PAGE_SIZES = '(max-width: 768px) 100vw, 1200px'
  - var _srcsetOf = function(p) { return (p && p.urls && p.urls.preview && p.urls.full && p.urls.preview !== p.urls.full) ? (p.urls.preview + ' 800w, ' + p.urls.full + ' 2400w') : null }
  - var _srcOf = function(p) { return p.urls ? (p.urls.full || p.urls.preview) : ('/images/photo/' + countryKey + '/' + seriesKey + '/' + p.file) }
  -
    // frames within two steps of this one (nearest first) — preloaded quietly once this one has loaded
    var _near = []
    var _nl = isShoot ? (nearList || []) : ((data && data[countryKey] && data[countryKey].series[seriesKey]) ? (data[countryKey].series[seriesKey].photos || []) : [])
    var _ni = _nl.findIndex(function(p) { return p.id === photo.id })
    if (_ni !== -1) [-1, 1, -2, 2].forEach(function(d) { var p = _nl[_ni + d]; if (p) _near.push({ d: Math.abs(d), src: _srcOf(p), srcset: _srcsetOf(p) }) })
  script#photo-near(type='application/json')!= JSON.stringify(_near).replace(/</g, '\\u003c')
  .photo-page
    .pp-top
      a.pp-back(href=_backHref) ← #{_backLabel.toUpperCase()}
      .pp-top-right
        if isAdmin
          .admin-bar
            if isShoot
              //- shoot frames have their own editor in the admin (the live template never linked to it)
              a.admin-bar-btn(href=`/admin/shoots/${shootSlug}/photos/${photo.id}/edit`)= ui.editBtn
              a.admin-bar-btn(href=`/admin/shoots/${shootSlug}/edit`) ✎ съёмка
            else
              a.admin-bar-btn(href=`/admin/${countryKey}/${seriesKey}/${photo.id}/edit`)= ui.editBtn
              a.admin-bar-btn(href=`/admin/${countryKey}/${seriesKey}/upload`)= ui.addPhoto
        if isShoot
          button.fb-btn.fb-btn--icon(type='button' onclick='toggleFocusTheme()' title=ui.theme aria-label=ui.theme) ◐
        .photo-page-nav
          if prev
            a.nav-btn(
              href=isShoot ? `${LP}/shoot/${shootSlug}/${prev.id}` : `${LP}/${countryKey}/${seriesKey}/${prev.id}`
              data-dir='prev'
              data-preload-src=_srcOf(prev)
              data-preload-srcset=_srcsetOf(prev)
            )= ui.prev
          else
            span.nav-btn.is-off= ui.prev
          if _pos
            span.pp-count #{_pos} / #{_total}
          if next
            a.nav-btn(
              href=isShoot ? `${LP}/shoot/${shootSlug}/${next.id}` : `${LP}/${countryKey}/${seriesKey}/${next.id}`
              data-dir='next'
              data-preload-src=_srcOf(next)
              data-preload-srcset=_srcsetOf(next)
            )= ui.next
          else
            span.nav-btn.is-off= ui.next
    .photo-page-image
      .photo-page-bg(style=`background-image: url(${photo.urls ? (photo.urls.preview || photo.urls.full) : '/images/photo/' + countryKey + '/' + seriesKey + '/' + photo.file})`)
      .photo-image-wrap
        .photo-badges
          .photo-type-badge(title=photo.type||'copter')
            +typeIcon(photo.type||'copter')
          if photo.panorama
            .photo-panorama-badge(title=ui.panorama)
              svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round')
                rect(x='2' y='6' width='20' height='12' rx='1')
                path(d='M2 15l5-5 4 4 4-6 7 7')
        if photo.annotations && photo.annotations.length
          each a, idx in photo.annotations
            button.photo-annot(class=a.source==='client' ? 'photo-annot--client' : '' type='button' data-x=a.x data-y=a.y data-text=a.text data-author=a.authorName||undefined)= idx + 1
        img(
          src=photo.urls ? photo.urls.full : `/images/photo/${countryKey}/${seriesKey}/${photo.file}`
          srcset=_srcsetOf(photo)
          sizes=_srcsetOf(photo) ? PAGE_SIZES : undefined
          alt=photo.title
          title=photo.desc||photo.title
          width=photo.width||undefined
          height=photo.height||undefined
          data-panorama=photo.panorama ? '1' : undefined
          data-pano-src=photo.panorama ? (photo.urls && (photo.urls.pano || photo.urls.full)) : undefined
          onerror="this.style.background='#1e1e1e';this.removeAttribute('src')"
        )
    .pp-body
      .pp-main
        .photo-page-loc
          if isShoot
            | #{(backLabel || '').toUpperCase()}#{photo.date ? ' · ' + photo.date : ''}
          else
            | #{countryLabel.toUpperCase()} · #{seriesLabel.toUpperCase()}#{photo.date ? ' · ' + photo.date : ''}
        h1.photo-page-title= photo.title
        if photo.desc
          p.photo-page-desc= photo.desc
        if !isShoot && photo.tags && photo.tags.length
          .photo-tags
            each tag in photo.tags
              a.photo-tag(href=`${LP}/tag/${tag}`)= allTags[tag] ? allTags[tag].label : tag
        if photo.annotations && photo.annotations.length
          .photo-annot-list
            each a, i in photo.annotations
              .photo-annot-item(class=a.source==='client' ? 'photo-annot-item--client' : '')
                span.photo-annot-num= i + 1
                span.photo-annot-item-text
                  = a.text
                  if a.source === 'client' && a.authorName
                    |
                    span.photo-annot-item-author= ui.pointAuthorPrefix + ' ' + a.authorName
        .photo-actions
          button.action-btn(type='button' onclick='sharePhoto()')= ui.share
          if photo.instagram
            a.action-btn(href=photo.instagram target='_blank' rel='noopener') #{ui.instagram} ↗
          if !isShoot
            button.action-btn.action-btn--ink.only-mobile(type='button' data-goto-tab='inquiry')= t.buyPrint
          if isShoot
            if photo.urls && photo.urls.instagram
              a.action-btn(href=`${LP}/shoot/${shootSlug}/${photo.id}/download-instagram`)= ui.downloadInstagram
            button.action-btn#add-point-btn(type='button' data-slug=shootSlug data-photo-id=photo.id)= ui.addPoint
            if isAdmin
              button.action-btn.action-btn--pick(type='button' data-curator-toggle data-slug=shootSlug data-photo-id=photo.id data-picked=photo.curatorPick ? '1' : '0' data-label-add=t.curatorAdd data-label-remove=t.curatorRemove data-error=ui.saveError class=photo.curatorPick ? 'is-picked' : '')= photo.curatorPick ? t.curatorRemove : t.curatorAdd
        if !isShoot && sourceShootUrl
          a.photo-source-shoot(href=sourceShootUrl) #{ui.fromShoot} #{sourceShootLabel.toUpperCase()} →
        if isAdmin && photoViews != null
          .photo-page-views(title='видно только админам') 👁 #{photoViews}
      .pp-side
        if !isShoot
          .photo-inquiry
            - var showInquiry = !!inquiryStatus
            .inquiry-tabs
              button.inquiry-tab(type='button' data-tab='comments' class=showInquiry ? '' : 'is-active')= ui.commentsTab
              button.inquiry-tab(type='button' data-tab='inquiry' class=showInquiry ? 'is-active' : '')= ui.inquiryTab
            .inquiry-tab-panel(data-panel='comments' style=showInquiry ? 'display:none' : '')
              - var photoUserStr = photoUser ? JSON.stringify(photoUser) : ''
              .photo-comments-section(
                data-country=countryKey
                data-series=seriesKey
                data-photo-id=photo.id
                data-is-admin=isAdmin ? '1' : '0'
                data-google-client-id=googleClientId
                data-user=photoUserStr
              )
                p.comments-loading= ui.loadingComments
            .inquiry-tab-panel(data-panel='inquiry' style=showInquiry ? '' : 'display:none')
              if inquiryStatus === 'ok'
                p.inquiry-success= ui.inquirySuccess
              else
                p.inquiry-hint= t.inquiryHint
                if inquiryStatus === 'err'
                  p.inquiry-error= ui.inquiryError
                form.inquiry-form(method='POST' action=`${LP}/${countryKey}/${seriesKey}/${photo.id}/inquiry`)
                  .inquiry-type
                    each opt in [['print',ui.print],['license',ui.license],['other',ui.other]]
                      label.inquiry-radio
                        input(type='radio' name='type' value=opt[0] checked=(inquiryStatus === 'license' ? opt[0]==='license' : opt[0]==='print'))
                        span= opt[1]
                  .inquiry-row
                    input.inquiry-input(type='text' name='name' placeholder=ui.nameCaps required autocomplete='name')
                    input.inquiry-input(type='email' name='email' placeholder=ui.emailCaps required autocomplete='email')
                  textarea.inquiry-input.inquiry-textarea(name='message' placeholder=t.inquiryMessage rows='3')
                  .inquiry-foot
                    span.inquiry-note= t.inquiryNote
                    button.btn.btn--ink.inquiry-submit(type='submit')= ui.submitArrow
        else
          .photo-inquiry
            .inquiry-tabs
              span.inquiry-tab.is-active(style='cursor:default;')= ui.commentsTab
            .inquiry-tab-panel(data-panel='comments')
              - var photoUserStrShoot = photoUser ? JSON.stringify(photoUser) : ''
              .photo-comments-section(
                data-country='shoot'
                data-series=shootSlug
                data-photo-id=photo.id
                data-is-admin=isAdmin ? '1' : '0'
                data-google-client-id=googleClientId
                data-user=photoUserStrShoot
              )
                p.comments-loading= ui.loadingComments

    .annot-popup#annot-popup
      button.annot-popup-close#annot-popup-close ×
      p.annot-popup-text#annot-popup-text

    if isShoot
      .selection-popup#point-popup
        .selection-popup-inner
          span.selection-popup-title= ui.pointPopupTitle
          textarea.point-popup-input#point-popup-input(rows='3' placeholder=ui.pointPlaceholder maxlength='500')
          p.point-popup-msg#point-popup-msg
          .selection-popup-actions
            button#point-popup-cancel(type='button')= ui.cancel
            button.btn.btn--ink#point-popup-save(type='button')= ui.save

      .selection-popup#point-signin-popup
        .selection-popup-inner
          span.selection-popup-title= ui.pointSignInTitle
          div#point-signin-btn
          .selection-popup-actions
            button#point-signin-cancel(type='button')= ui.cancel

    if !isShoot && related && related.length
      .related
        .related-label #{ui.relatedFrom} #{countryLabel.toUpperCase()}
        .related-strip
          each r in related
            a.related-thumb(href=`${LP}/${r.countryKey}/${r.seriesKey}/${r.id}` title=r.title)
              img(src=r.urls.preview alt=r.title title=r.title loading='lazy' onerror="this.closest('.related-thumb').style.display='none'")

  script.
    (function() {
      // ── soft (SPA-like) navigation between photos: swaps <main> + <head> via fetch
      // instead of a full page reload; falls back to a real navigation on any failure ──
      var main = document.querySelector('main.main');

      function repositionAnnots() {
        var pageImg = document.querySelector('.photo-image-wrap img');
        var annots = document.querySelectorAll('.photo-image-wrap .photo-annot');
        if (!pageImg || !pageImg.naturalWidth || !annots.length) return;
        var W = pageImg.clientWidth, H = pageImg.clientHeight;
        var scale = Math.min(W / pageImg.naturalWidth, H / pageImg.naturalHeight);
        var rW = pageImg.naturalWidth * scale, rH = pageImg.naturalHeight * scale;
        var rL = (W - rW) / 2, rT = (H - rH) / 2;
        annots.forEach(function(btn) {
          btn.style.left = (rL + rW * parseFloat(btn.dataset.x) / 100) + 'px';
          btn.style.top  = (rT + rH * parseFloat(btn.dataset.y) / 100) + 'px';
        });
      }

      // turns off the shimmer skeleton on .photo-page-image once the current image is ready
      function markPageImageLoaded() {
        var pageImg = document.querySelector('.photo-page-image .photo-image-wrap img');
        var container = pageImg && pageImg.closest('.photo-page-image');
        if (container) container.classList.add('loaded');
      }

      // Warms the cache for the frames around this one (±1 right away, ±2 when the browser is idle) so the
      // deck swipe and ПРЕД./СЛЕД. feel instant. Each preload uses the SAME srcset/sizes as the page image,
      // so the browser fetches exactly the candidate the page will show (preview vs full, retina-aware) and
      // the later real load is a cache hit. Skipped entirely on Save-Data / 2G connections.
      var PAGE_SIZES = '(max-width: 768px) 100vw, 1200px'; // keep in sync with the <img sizes> above
      var preloadedKeys = {};
      function preloadNeighbors() {
        var conn = navigator.connection || {};
        if (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || '')) return;
        var el = document.getElementById('photo-near');
        var list = [];
        try { list = el ? JSON.parse(el.textContent) : []; } catch (e) { return; }
        list.forEach(function(n) {
          var key = (n.srcset || '') + '|' + n.src;
          if (preloadedKeys[key]) return;
          preloadedKeys[key] = true;
          function go() {
            var im = new Image();
            im.decoding = 'async';
            try { im.fetchPriority = 'low'; } catch (e) {}
            im.sizes = PAGE_SIZES;
            if (n.srcset) im.srcset = n.srcset;
            im.src = n.src;
          }
          if (n.d === 1) go();
          else if (window.requestIdleCallback) requestIdleCallback(go, { timeout: 3000 });
          else setTimeout(go, 1500);
        });
      }

      function onPageImageReady() {
        repositionAnnots();
        markPageImageLoaded();
        preloadNeighbors();
      }

      // load/error don't bubble, so catch them in the capture phase to survive DOM swaps
      document.addEventListener('load', function(e) {
        if (e.target.matches && e.target.matches('.photo-page-image .photo-image-wrap img') && !e.target.closest('.deck-card')) onPageImageReady();
      }, true);
      document.addEventListener('error', function(e) {
        if (e.target.matches && e.target.matches('.photo-page-image .photo-image-wrap img')) markPageImageLoaded();
      }, true);
      window.addEventListener('resize', repositionAnnots);

      function checkPageImageAlreadyLoaded() {
        var pageImg = document.querySelector('.photo-page-image .photo-image-wrap img');
        if (pageImg && pageImg.complete && pageImg.naturalWidth) onPageImageReady();
      }
      checkPageImageAlreadyLoaded();

      function loadComments() {
        var old = document.getElementById('comments-script');
        if (old) old.remove();
        if (!document.querySelector('.photo-comments-section')) return;
        var s = document.createElement('script');
        s.id = 'comments-script';
        s.src = '/javascripts/photo-v2/comments.js';
        document.body.appendChild(s);
      }

      function updateHead(doc) {
        document.title = doc.title;
        var newDesc = doc.querySelector('meta[name="description"]');
        var curDesc = document.querySelector('meta[name="description"]');
        if (newDesc && curDesc) curDesc.setAttribute('content', newDesc.getAttribute('content') || '');

        ['og:title', 'og:description', 'og:image', 'og:url'].forEach(function(prop) {
          var n = doc.querySelector('meta[property="' + prop + '"]');
          var cur = document.querySelector('meta[property="' + prop + '"]');
          if (n) {
            if (!cur) { cur = document.createElement('meta'); cur.setAttribute('property', prop); document.head.appendChild(cur); }
            cur.setAttribute('content', n.getAttribute('content') || '');
          } else if (cur) {
            cur.remove();
          }
        });

        var newCanon = doc.querySelector('link[rel="canonical"]');
        var curCanon = document.querySelector('link[rel="canonical"]');
        if (newCanon && curCanon) curCanon.setAttribute('href', newCanon.getAttribute('href'));

        var oldLd = document.getElementById('ld-photo');
        if (oldLd) oldLd.remove();
        var newLd = doc.getElementById('ld-photo');
        if (newLd) document.head.appendChild(newLd.cloneNode(true));
      }

      function swap(html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var newMain = doc.querySelector('main.main');
        if (!newMain) return false;
        updateHead(doc);
        main.innerHTML = newMain.innerHTML;
        window.scrollTo(0, 0);
        checkPageImageAlreadyLoaded();
        loadComments();
        if (lb.classList.contains('lb-open')) refreshLbImage();
        return true;
      }

      // GA doesn't see soft-nav'd URL changes on its own — gtag('config',...) in <head>
      // only auto-fires a page_view for the real (first) page load, so send one by hand
      // per swap. The internal Firestore view counter (trackView, routes/photo.js) needs
      // no such fix — it runs server-side on every fetch(), same as a normal navigation.
      function trackPageView() {
        if (typeof gtag === 'function') {
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: location.href,
            page_path: location.pathname + location.search,
          });
        }
      }

      var navigating = false;
      var afterSwap = []; // one-shot callbacks, run right after the next successful soft-nav swap
      function navigate(url, isPop, method) {
        if (navigating) return;
        navigating = true;
        fetch(url)
          .then(function(r) { if (!r.ok) throw new Error('nav failed'); return r.text(); })
          .then(function(html) {
            navigating = false;
            if (!swap(html)) { location.href = url; return; }
            afterSwap.splice(0).forEach(function(fn) { try { fn(); } catch (e) {} });
            if (!isPop) history.pushState({ photoNav: true }, '', url);
            trackPageView();
            window.photoTrack && window.photoTrack('photo_navigate', { method: method || 'click' });
          })
          .catch(function() {
            navigating = false;
            location.href = url;
          });
      }

      // ── swipe navigation (mobile): swipe left = next photo, swipe right = prev ──
      var SWIPE_MIN_DX = 50; // px — below this it's a tap, not a swipe
      var SWIPE_MAX_DY = 80; // px — above this it's a vertical scroll, not a swipe

      function getNavUrl(dir) {
        var link = document.querySelector('.nav-btn[data-dir="' + dir + '"]');
        return link ? link.getAttribute('href') : null;
      }
      function swipeNext() { var url = getNavUrl('next'); if (url) navigate(url, false, 'swipe'); }
      function swipePrev() { var url = getNavUrl('prev'); if (url) navigate(url, false, 'swipe'); }

      // el must be a stable element that survives soft-nav swaps (main itself, or the
      // lightbox — both live outside the innerHTML that gets replaced on navigation).
      // filterSelector, if given, restricts which touchstart targets count (delegation);
      // pass null when el itself is already the exact area to track (the lightbox).
      function bindSwipe(el, filterSelector) {
        var startX = 0, startY = 0, tracking = false;
        el.addEventListener('touchstart', function(e) {
          // panorama pan/zoom mode repurposes drag for panning, not swipe-navigation
          if (lb.classList.contains('lb-pan')) { tracking = false; return; }
          tracking = e.touches.length === 1 && (!filterSelector || (e.target.closest && e.target.closest(filterSelector)));
          if (tracking) { startX = e.touches[0].clientX; startY = e.touches[0].clientY; }
        }, { passive: true });
        el.addEventListener('touchend', function(e) {
          if (!tracking) return;
          tracking = false;
          // points.js arms '.photo-image-wrap.is-placing' while the visitor is placing a
          // point — don't also navigate away out from under that click.
          if (document.querySelector('.photo-image-wrap.is-placing')) return;
          var t = e.changedTouches[0];
          var dx = t.clientX - startX, dy = t.clientY - startY;
          if (Math.abs(dx) < SWIPE_MIN_DX || Math.abs(dy) > SWIPE_MAX_DY) return;
          if (dx < 0) swipeNext(); else swipePrev();
        }, { passive: true });
      }
      // ── v2 (touch): "deck of cards" swipe, used on the photo scene AND in the fullscreen lightbox. ──
      // The current frame follows the finger; dragging left slides it away and reveals the NEXT frame lying
      // underneath, dragging right pulls the PREVIOUS frame in from the left ON TOP of the current one.
      // Released far/fast enough → the deck moves on (cfg.commit does the real navigation right after the
      // animation, and the destination page shows the very same frame), else it springs back. At the first/last
      // frame the card only rubber-bands. Vertical drags are left to the browser (page scroll).
      // cfg: { root, start(e) → {holder, wrap} | null, width(st), sizeCard(card, st), insertUnder/insertOver(st, card),
      //        onDrag(st), onEnd(st), commit(target, st, done) }
      function makeDeckSwipe(cfg) {
        var st = null;
        var COMMIT_RATIO = 0.28;  // fraction of the width that commits a slow drag
        var COMMIT_SPEED = 0.45;  // px/ms — a quick flick commits even a short drag
        var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function neighbour(dir) {
          var l = document.querySelector('.nav-btn[data-dir="' + dir + '"]');
          return l ? { url: l.getAttribute('href'), src: l.getAttribute('data-preload-src'), srcset: l.getAttribute('data-preload-srcset') } : null;
        }
        function makeCard(nb, cls) {
          var c = document.createElement('div');
          c.className = 'deck-card ' + cls;
          cfg.sizeCard(c, st);
          var im = document.createElement('img');
          // same candidate the preloader fetched → already in the cache
          im.sizes = PAGE_SIZES; if (nb.srcset) im.srcset = nb.srcset;
          im.src = nb.src; im.alt = ''; im.draggable = false;
          c.appendChild(im);
          return c;
        }
        function clamp01(v) { return Math.max(0, Math.min(1, v)); }

        function render(dx) {
          var W = st.W, p = clamp01(Math.abs(dx) / W);
          if (dx < 0) {
            var eff = st.next ? dx : dx * 0.3;
            st.wrap.style.transform = 'translateX(' + eff + 'px)' + (reduceMotion ? '' : ' rotate(' + (eff / W * 5) + 'deg)');
            st.wrap.style.filter = '';
            if (st.under) {
              st.under.style.opacity = '1';
              st.under.style.transform = 'scale(' + (0.94 + 0.06 * p) + ')';
              st.under.firstChild.style.filter = 'brightness(' + (0.65 + 0.35 * p) + ')';
            }
            if (st.over) st.over.style.transform = 'translateX(-105%)';
          } else {
            if (st.under) st.under.style.opacity = '0';
            if (st.prev) {
              st.over.style.transform = 'translateX(' + (-W + dx) + 'px)';
              st.wrap.style.transform = 'scale(' + (1 - 0.05 * p) + ')';
              st.wrap.style.filter = 'brightness(' + (1 - 0.3 * p) + ')';
            } else {
              st.wrap.style.transform = 'translateX(' + (dx * 0.3) + 'px)';
              st.wrap.style.filter = '';
            }
          }
        }
        function cleanup() {
          if (!st) return;
          if (cfg.onEnd) cfg.onEnd(st);
          st.wrap.style.transition = st.wrap.style.transform = st.wrap.style.filter = '';
          if (st.under) st.under.remove();
          if (st.over) st.over.remove();
          st = null;
        }

        cfg.root.addEventListener('touchstart', function(e) {
          if (navigating || e.touches.length !== 1) { st = null; return; }
          var ctx = cfg.start(e);
          if (!ctx) { st = null; return; }
          var t = e.touches[0];
          st = { x0: t.clientX, y0: t.clientY, t0: Date.now(), dx: 0, mode: null, holder: ctx.holder, wrap: ctx.wrap };
        }, { passive: true });

        cfg.root.addEventListener('touchmove', function(e) {
          if (!st) return;
          var t = e.touches[0];
          var dx = t.clientX - st.x0, dy = t.clientY - st.y0;
          if (!st.mode) {
            if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
            if (Math.abs(dy) > Math.abs(dx)) { st = null; return; } // a vertical scroll, not our gesture
            st.mode = 'drag';
            st.W = cfg.width(st);
            st.next = neighbour('next');
            st.prev = neighbour('prev');
            if (cfg.onDrag) cfg.onDrag(st);
            if (st.next) { st.under = makeCard(st.next, 'deck-card--under'); cfg.insertUnder(st, st.under); }
            if (st.prev) { st.over = makeCard(st.prev, 'deck-card--over'); cfg.insertOver(st, st.over); }
          }
          st.dx = dx;
          render(dx);
        }, { passive: true });

        function finish(cancelled) {
          if (!st || st.mode !== 'drag') { st = null; return; }
          var s = st, dx = s.dx, W = s.W, dt = Math.max(1, Date.now() - s.t0);
          var dir = dx < 0 ? 'next' : 'prev';
          var target = dir === 'next' ? s.next : s.prev;
          var commit = !cancelled && target && (Math.abs(dx) / W > COMMIT_RATIO || (Math.abs(dx) / dt > COMMIT_SPEED && Math.abs(dx) > 30));
          s.wrap.style.transition = 'transform .22s ease-out, filter .22s ease-out';
          if (s.under) { s.under.style.transition = 'transform .22s ease-out, opacity .22s'; s.under.firstChild.style.transition = 'filter .22s ease-out'; }
          if (s.over) s.over.style.transition = 'transform .22s ease-out';
          if (commit) {
            if (dir === 'next') {
              s.wrap.style.transform = 'translateX(' + (-W * 1.15) + 'px)' + (reduceMotion ? '' : ' rotate(-6deg)');
              if (s.under) { s.under.style.transform = 'scale(1)'; s.under.firstChild.style.filter = 'brightness(1)'; }
            } else {
              s.over.style.transform = 'translateX(0)';
              s.wrap.style.transform = 'scale(.95)';
              s.wrap.style.filter = 'brightness(.7)';
            }
            setTimeout(function() {
              // the cards now show the destination frame full-size; move the page on underneath them
              cfg.commit(target, s, function done() { if (st === s) cleanup(); });
              // safety net: never leave cards lying around if the navigation stalls
              setTimeout(function() { if (st === s) cleanup(); }, 5000);
            }, reduceMotion ? 0 : 230);
          } else {
            s.wrap.style.transform = '';
            s.wrap.style.filter = '';
            if (s.under) { s.under.style.opacity = '0'; s.under.style.transform = 'scale(.94)'; }
            if (s.over) s.over.style.transform = 'translateX(-105%)';
            setTimeout(function() { if (st === s) cleanup(); }, 240);
          }
        }
        cfg.root.addEventListener('touchend', function() { finish(false); }, { passive: true });
        cfg.root.addEventListener('touchcancel', function() { finish(true); }, { passive: true });
      }

      // photo scene on the page (main survives soft-nav swaps; the cards live inside the scene and vanish with it)
      makeDeckSwipe({
        root: main,
        start: function(e) {
          var scene = e.target.closest && e.target.closest('.photo-page-image');
          // not while a point is being placed (points.js arms .is-placing) and not under the lightbox
          if (!scene || document.querySelector('.photo-image-wrap.is-placing') || lb.classList.contains('lb-open')) return null;
          return { holder: scene, wrap: scene.querySelector('.photo-image-wrap') };
        },
        width: function(st) { return st.holder.clientWidth || window.innerWidth; },
        sizeCard: function(c, st) {
          // same box as the current frame, so the neighbour lines up with it exactly
          var r = st.wrap.getBoundingClientRect(), sr = st.holder.getBoundingClientRect();
          c.style.left = (r.left - sr.left) + 'px'; c.style.top = (r.top - sr.top) + 'px';
          c.style.width = r.width + 'px'; c.style.height = r.height + 'px';
        },
        insertUnder: function(st, c) { st.holder.insertBefore(c, st.wrap); },
        insertOver: function(st, c) { st.holder.appendChild(c); },
        onDrag: function(st) { st.holder.classList.add('is-dragging'); },
        onEnd: function(st) { st.holder.classList.remove('is-dragging'); },
        commit: function(target) { navigate(target.url, false, 'swipe'); },
      });

      // ── zoom lightbox: single #lb element created once, reused across soft-nav swaps ──
      var lb = document.createElement('div');
      lb.id = 'lb';
      lb.className = 'lb';
      var lbClose = document.createElement('button');
      lbClose.className = 'lb-close';
      lbClose.textContent = '✕';
      var lbWrap = document.createElement('div');
      lbWrap.className = 'lb-wrap';
      var lbImg = document.createElement('img');
      lbImg.className = 'lb-img';
      lbImg.draggable = false; // no native image drag-ghost fighting the pan/zoom below
      lbWrap.appendChild(lbImg);
      lb.appendChild(lbClose);
      lb.appendChild(lbWrap);
      // v2: caption layer over the photo (bottom-left): title + first line of the description; scroll/tap it to read the rest
      var lbInfo = document.createElement('div');
      lbInfo.className = 'lb-info';
      lb.appendChild(lbInfo);
      document.body.appendChild(lb);

      function addLbAnnots() {
        lbWrap.querySelectorAll('.lb-annot').forEach(function(el) { el.remove(); });
        document.querySelectorAll('.photo-image-wrap .photo-annot').forEach(function(btn) {
          var marker = document.createElement('button');
          marker.type = 'button';
          marker.className = 'photo-annot lb-annot' + (btn.classList.contains('photo-annot--client') ? ' photo-annot--client' : '');
          marker.textContent = btn.textContent;
          marker.style.left = btn.dataset.x + '%';
          marker.style.top  = btn.dataset.y + '%';
          marker.dataset.text = btn.dataset.text;
          if (btn.dataset.author) marker.dataset.author = btn.dataset.author;
          lbWrap.appendChild(marker);
        });
      }
      // ── panorama pan/zoom: only active while the lightbox shows a panorama photo.
      // Non-panorama photos never touch this — panState.active stays false and every
      // handler below no-ops, so the plain fit-to-screen/click-to-close lightbox is
      // untouched for the common case. ──
      var panState = { active: false, scale: 1, tx: 0, ty: 0, minScale: 1, maxScale: 1 };

      function applyPanTransform() {
        lbImg.style.transform = 'translate(' + panState.tx + 'px,' + panState.ty + 'px) scale(' + panState.scale + ')';
      }
      function clampPan() {
        var scaledW = lbImg.offsetWidth * panState.scale;
        var scaledH = lbImg.offsetHeight * panState.scale;
        var maxTx = Math.max(0, (scaledW - window.innerWidth) / 2);
        var maxTy = Math.max(0, (scaledH - window.innerHeight) / 2);
        panState.tx = Math.max(-maxTx, Math.min(maxTx, panState.tx));
        panState.ty = Math.max(-maxTy, Math.min(maxTy, panState.ty));
      }
      // Pure: scale/pan the image around viewport point (mx,my), keeping the image
      // point under the cursor/finger visually fixed. Base state passed in explicitly
      // so both live (wheel/dblclick) and gesture-baseline (pinch) callers can use it.
      function computeZoom(baseScale, baseTx, baseTy, mx, my, newScale) {
        newScale = Math.max(panState.minScale, Math.min(panState.maxScale, newScale));
        var cx0 = window.innerWidth / 2, cy0 = window.innerHeight / 2;
        var ratio = newScale / baseScale;
        return {
          scale: newScale,
          tx: mx - cx0 - (mx - cx0 - baseTx) * ratio,
          ty: my - cy0 - (my - cy0 - baseTy) * ratio,
