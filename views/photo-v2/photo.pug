        var r = computeZoom(panState.scale, panState.tx, panState.ty, mx, my, newScale);
        panState.scale = r.scale; panState.tx = r.tx; panState.ty = r.ty;
        clampPan();
        applyPanTransform();
      }
      function animatedZoomAt(mx, my, newScale) {
        lbImg.style.transition = 'transform 0.25s ease';
        zoomAt(mx, my, newScale);
        setTimeout(function() { lbImg.style.transition = ''; }, 260);
      }
      function resetPan() {
        panState.scale = panState.minScale; panState.tx = 0; panState.ty = 0;
        applyPanTransform();
      }

      lbWrap.addEventListener('wheel', function(e) {
        if (!panState.active) return;
        e.preventDefault();
        zoomAt(e.clientX, e.clientY, panState.scale * Math.exp(-e.deltaY * 0.0015));
      }, { passive: false });

      lbWrap.addEventListener('dblclick', function(e) {
        if (!panState.active) return;
        e.preventDefault();
        if (panState.scale > panState.minScale + 0.01) resetPan();
        else animatedZoomAt(e.clientX, e.clientY, panState.maxScale);
      });

      var mouseDrag = null;
      lbWrap.addEventListener('mousedown', function(e) {
        if (!panState.active) return;
        e.preventDefault(); // stop native text/image selection from fighting the drag
        mouseDrag = { x: e.clientX, y: e.clientY, tx: panState.tx, ty: panState.ty };
        lb.classList.add('lb-dragging');
      });
      window.addEventListener('mousemove', function(e) {
        if (!mouseDrag) return;
        panState.tx = mouseDrag.tx + (e.clientX - mouseDrag.x);
        panState.ty = mouseDrag.ty + (e.clientY - mouseDrag.y);
        clampPan();
        applyPanTransform();
      });
      window.addEventListener('mouseup', function() {
        mouseDrag = null;
        lb.classList.remove('lb-dragging');
      });

      // touch: one finger pans, two fingers pinch-zoom (midpoint fixed for the gesture)
      var touchState = null;
      function touchDist(a, b) { return Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY); }
      lbWrap.addEventListener('touchstart', function(e) {
