extends layout
include mixins

block content
  section.hero.hero--compact
    .kicker= t.tagWord
    h1.hero-title= tagLabel
    if tagDesc
      p.hero-lead= tagDesc
  +filterbarFor(photos, tagLabel.toUpperCase(), { hideTags: true })
  +feedMasonry(photos)
  if tagShoots && tagShoots.length
    .related-shoots
      span.fb-label= t.tagShoots
      +shootCards(tagShoots, shootCardsLimit)
    script(src='/javascripts/photo-v2/shoot-rank.js' defer)
