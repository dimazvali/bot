doctype html
html(data-theme='dark' lang=lang || 'ru')
  head
    meta(charset='utf-8')
    title= title
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(name='robots' content='noindex,nofollow')
    link(rel='icon' href='/images/photo/ds_georgian.ico')
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;1,400;1,500;1,600&family=JetBrains+Mono:wght@400;500;600&display=swap')
    link(rel='stylesheet' href='/stylesheets/photo-v2/style.css')
    script.
      (function () {
        try { document.documentElement.setAttribute('data-focus-theme', localStorage.getItem('photo-focus-theme') === 'light' ? 'light' : 'dark'); } catch (e) {}
      }());
  body.is-focus
    .shoot-password-wrap
      .shoot-password-box
        span.kicker dimazvali · #{t.shootClosed}
        h1.shoot-password-title= label
        form.shoot-password-form(method='POST' action=`${lang === 'en' ? '/en' : ''}/shoot/${slug}/auth` class=error ? 'has-error' : '')
          input.shoot-password-input(type='password' name='password' placeholder=ui.passwordPlaceholder autofocus required autocomplete='current-password')
          button.shoot-password-btn(type='submit' aria-label='OK') →
        if error
          p.shoot-password-error= ui.wrongPassword
