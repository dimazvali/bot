doctype html
html(data-theme='dark')
  head
    title= title
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(rel='stylesheet' href='/stylesheets/photo/style.css')
  body
    .admin-wrap
      .admin-header
        a.admin-back(href='/admin') ← назад
        span.admin-logo СЪЁМКИ
      if error
        .admin-section
          p.admin-hint= error
      .admin-section
        h2.admin-title СЪЁМКИ
        if !shootEntries.length
          p.admin-hint Нет съёмок.
        else
          table.admin-table#shoots-table
            thead
              tr
                th.admin-table-sortable(data-type='text') Название
                th.admin-table-sortable(data-type='number') Фото
                th.admin-table-sortable(data-type='number') Просмотры
                th.admin-table-sortable(data-type='text') Доступ
                th.admin-table-sortable(data-type='number') Дата публикации
                th
            tbody
              each entry in shootEntries
                - var slug = entry[0]
                - var shoot = entry[1]
                - var viewsCount = stats[slug] || 0
                - var createdAt = shoot.createdAt ? new Date(shoot.createdAt) : null
                tr
                  td(data-value=shoot.label)= `${shoot.label} (${slug})`
                  td(data-value=shoot.photos.length)= shoot.photos.length
                  td(data-value=viewsCount)= `👁 ${viewsCount}`
                  td(data-value=shoot.public ? 1 : 0)
                    = shoot.public ? '🌐 публично' : '🚫 не публично'
                    if shoot.password
                      |  🔑
                  td(data-value=createdAt ? createdAt.getTime() : 0)= createdAt ? createdAt.toLocaleDateString('ru-RU') : '—'
                  td.admin-table-actions
                    a.admin-link(href=`/shoot/${slug}` target='_blank' rel='noopener') открыть
                    a.admin-link(href=`/admin/shoots/${slug}/edit`) редактировать
      .admin-section
        h2.admin-title СОЗДАТЬ СЪЁМКУ
        form.admin-form(method='POST' action='/admin/shoots')
          input.admin-input(type='text' name='slug' placeholder='ключ (eng, напр. wedding-anna-2026)' required)
          input.admin-input(type='text' name='label' placeholder='название' required)
          input.admin-input(type='text' name='password' placeholder='пароль (необязательно)')
          label.admin-tag-check
            input(type='checkbox' name='public')
            span показывать в /shoot и в сайтмапе
          button.admin-btn(type='submit') + СЪЁМКА
    script.
      document.querySelectorAll('#shoots-table .admin-table-sortable').forEach(function(th, colIndex) {
        th.addEventListener('click', function() {
          var table = document.getElementById('shoots-table');
          var tbody = table.querySelector('tbody');
          var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
          var type = th.dataset.type;
          var asc = th.dataset.dir !== 'asc';
          table.querySelectorAll('.admin-table-sortable').forEach(function(h) { delete h.dataset.dir; });
          th.dataset.dir = asc ? 'asc' : 'desc';
          rows.sort(function(a, b) {
            var av = a.children[colIndex].dataset.value || '';
            var bv = b.children[colIndex].dataset.value || '';
            if (type === 'number') return asc ? (parseFloat(av) || 0) - (parseFloat(bv) || 0) : (parseFloat(bv) || 0) - (parseFloat(av) || 0);
            av = av.toLowerCase();
            bv = bv.toLowerCase();
            if (av < bv) return asc ? -1 : 1;
            if (av > bv) return asc ? 1 : -1;
            return 0;
          });
          rows.forEach(function(r) { tbody.appendChild(r); });
        });
      });
