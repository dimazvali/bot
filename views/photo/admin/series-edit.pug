doctype html
html(data-theme='dark')
  head
    title= title
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(rel='stylesheet' href='/stylesheets/photo/style.css')
    link(rel='stylesheet' href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css' integrity='sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H' crossorigin='anonymous')
    script(src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js' integrity='sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH' crossorigin='anonymous')
    style.
      #coords-map { width: 100%; height: 260px; flex: 1 1 100%; border: 1px solid var(--border); border-radius: 6px; margin-bottom: 8px; cursor: crosshair; }
      #coords-map .leaflet-tile-pane { filter: invert(1) hue-rotate(180deg) brightness(0.92) contrast(0.9); }
      .coords-map-bar { display: flex; flex: 1 1 100%; align-items: center; gap: 10px; margin-bottom: 10px; font-size: .75rem; color: var(--text-dim); }
  body
    .admin-wrap
      .admin-header
        a.admin-back(href=`/admin/country/${countryKey}/edit`) ← назад
        span.admin-logo #{countryLabel} · #{series.label}
        a.admin-link(href=`/admin/${countryKey}/${seriesKey}/upload`) + ДОБАВИТЬ ФОТО

      .admin-section
        h2.admin-title ПЕРЕИМЕНОВАТЬ
        form.admin-form(method='POST' action=`/admin/${countryKey}/${seriesKey}/edit`)
          input.admin-input(type='text' name='label' value=series.label placeholder='название серии')
          input.admin-input(type='text' name='label_en' value=series.label_en || '' placeholder='name (EN)')
          p.admin-hint Центр карты (опционально — куда центрируется карта локации при редактировании фото этой серии; клик — поставить точку, перетаскивание — сдвинуть):
          #coords-map
          input#coords-lat(type='hidden' name='mapLat' value=(series.mapCenter ? series.mapCenter.lat : ''))
          input#coords-lng(type='hidden' name='mapLng' value=(series.mapCenter ? series.mapCenter.lng : ''))
          .coords-map-bar
            span#coords-label(data-empty='не задан')= series.mapCenter ? series.mapCenter.lat.toFixed(6) + ', ' + series.mapCenter.lng.toFixed(6) : 'не задан'
            button#coords-clear.admin-btn(type='button') Убрать точку
          button.admin-btn(type='submit') СОХРАНИТЬ

      .admin-section
        h2.admin-title ВИДИМОСТЬ
        form.admin-form(method='POST' action=`/admin/${countryKey}/${seriesKey}/archive`)
          button.admin-btn(type='submit')= series.archived ? 'РАЗАРХИВИРОВАТЬ' : 'АРХИВИРОВАТЬ'
        p.admin-hint Архивированная серия скрыта на публичном сайте, но доступна в админке.

      if series.photos.length
        .admin-section
          h2.admin-title ФОТО (#{series.photos.length})
          p.admin-hint Перетащите для изменения порядка.
          ul#photo-list.admin-sort-list(data-url=`/admin/${countryKey}/${seriesKey}/reorder-photos`)
            each photo in series.photos
              li.admin-sort-item(data-id=photo.id)
                span.admin-sort-handle ⠿
                if photo.urls
                  img.admin-thumb(src=photo.urls.preview alt=photo.title)
                .admin-photo-info
                  span.admin-photo-title= photo.title
                  span.admin-photo-id= photo.id
                  if photo.seo_desc
                    span.admin-photo-caption= photo.seo_desc
                .admin-sort-actions
                  a.admin-link(href=`/admin/${countryKey}/${seriesKey}/${photo.id}/edit`) ред.
                  form(method='POST' action=`/admin/${countryKey}/${seriesKey}/${photo.id}/delete`)
                    button.admin-btn.admin-btn--danger(type='submit') удалить

      .admin-section
        h2.admin-title УДАЛИТЬ СЕРИЮ
        p.admin-hint Все фотографии будут удалены из Firebase Storage без возможности восстановления.
        form.admin-form(method='POST' action=`/admin/${countryKey}/${seriesKey}/delete`)
          button.admin-btn.admin-btn--danger(type='submit') УДАЛИТЬ СЕРИЮ

    script(src='https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js')
    script.
      var list = document.getElementById('photo-list');
      if (list) {
        var reorderUrl = list.getAttribute('data-url');
        Sortable.create(list, {
          handle: '.admin-sort-handle',
          animation: 150,
          onEnd: function() {
            var order = Array.from(list.querySelectorAll('.admin-sort-item')).map(function(el) {
              return el.getAttribute('data-id');
            });
            fetch(reorderUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ order: order }),
            }).then(function(r) { return r.json(); }).then(function(data) {
              if (!data.ok) alert('Ошибка сохранения порядка');
            }).catch(function() { alert('Ошибка сохранения порядка'); });
          },
        });
      }

      // ── Series map-center picker: click to place, drag to adjust ──
      (function() {
        var el = document.getElementById('coords-map');
        if (!el || !window.L) return;
        var latInput = document.getElementById('coords-lat');
        var lngInput = document.getElementById('coords-lng');
        var label = document.getElementById('coords-label');
        var clearBtn = document.getElementById('coords-clear');
        var DEFAULT_CENTER = [41.7151, 44.8271];

        function num(v) { var n = parseFloat(v); return isNaN(n) ? null : n; }
        var lat0 = num(latInput.value);
        var lng0 = num(lngInput.value);

        var map = L.map(el, { scrollWheelZoom: true, attributionControl: false })
          .setView(lat0 != null && lng0 != null ? [lat0, lng0] : DEFAULT_CENTER, lat0 != null ? 11 : 6);
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);

        var marker = null;
        function fmt(lat, lng) { return lat.toFixed(6) + ', ' + lng.toFixed(6); }
        function setPoint(lat, lng) {
          latInput.value = lat;
          lngInput.value = lng;
          label.textContent = fmt(lat, lng);
          if (marker) {
            marker.setLatLng([lat, lng]);
          } else {
            marker = L.marker([lat, lng], { draggable: true }).addTo(map);
            marker.on('dragend', function() {
              var pos = marker.getLatLng();
              setPoint(pos.lat, pos.lng);
            });
          }
        }
        if (lat0 != null && lng0 != null) setPoint(lat0, lng0);

        map.on('click', function(e) { setPoint(e.latlng.lat, e.latlng.lng); });

        if (clearBtn) clearBtn.addEventListener('click', function() {
          if (marker) { map.removeLayer(marker); marker = null; }
          latInput.value = '';
          lngInput.value = '';
          label.textContent = label.getAttribute('data-empty') || '—';
        });

        setTimeout(function() { map.invalidateSize(); }, 0);
      }());
