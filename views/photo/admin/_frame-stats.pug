//- "Статистика кадра" on photo-edit.pug / shoot-photo-edit.pug — numbers from frameStats() in routes/photo-admin.js
//- (the cached 4 weeks of activity, no extra queries). Needs _heat.pug included by the page.
mixin frameStats(fs, statsUrl, opts)
  - opts = opts || {}
  .admin-section#frame-stats
    .admin-section-head
      h2.admin-title СТАТИСТИКА КАДРА
      +heatBadge(fs.heat)
    if fs.heat.score
      p.admin-hint #{fs.heat.rank}-е место по горячести из #{fs.heat.rankOf} кадров с активностью · за 7 дней #{fs.heat.week} очк., неделей раньше #{fs.heat.prevWeek}.
    .admin-grid
      each tile in [[fs.allTime, 'просмотров за всё время'], [fs.views, 'просмотров за 4 недели']].concat(opts.gallery ? [[fs.inquiries, 'заявок за 4 недели'], [fs.reviews, 'отзывов за 4 недели']] : []).concat([[fs.igClicks, 'переходов в Instagram за 4 недели'], [fs.comments, 'комментариев']])
        .admin-stat(class=tile[0] ? '' : 'is-zero')
          span.admin-stat-count= tile[0]
          span.admin-stat-label= tile[1]
    p.admin-hint(style='margin-top:12px')
      a(href=statsUrl) → график просмотров по дням
