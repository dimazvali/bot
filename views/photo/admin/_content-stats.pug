//- Fragment for the "Статистика" tabs: shoot-edit.pug (GET /admin/shoots/:slug/stats) and series-edit.pug
//- (GET /admin/:country/:series/stats). What differs between the two comes in `v` (see renderContentStats
//- in routes/photo-admin.js): labels, links to frames, the visitor-actions tiles.
include _heat.pug
- var periodTotal = s.total.page + s.total.photos
- function pct(n, of) { return of ? Math.round(n / of * 100) : 0; }
- var HEAT_PARTS = [['page', v.pageLabel], ['frames', 'просмотры кадров'], ['actions', 'Instagram, комментарии, заявки'], ['downloads', 'скачивания']]
if heat
  .admin-section
    .admin-section-head
      h2.admin-title ГОРЯЧЕСТЬ
      +heatBadge(heat)
    if heat.score
      p.admin-hint
        | #{heat.rank}-е место из #{heat.rankOf} #{v.kindPlural} с активностью.
        |  За 7 дней — #{heat.week} очк., неделей раньше — #{heat.prevWeek}.
      .admin-grid
        each part in HEAT_PARTS
          if heat.parts[part[0]] || part[0] !== 'downloads' || v.kind === 'shoot'
            .admin-stat(class=heat.parts[part[0]] ? '' : 'is-zero')
              span.admin-stat-count= heat.parts[part[0]]
              span.admin-stat-label #{part[1]} · #{pct(heat.parts[part[0]], heat.score)}%
    else
      p.admin-hint За последние 4 недели активности нет.
    p.admin-hint(style='margin-top:12px')
      | Очки: страница 1, кадр 2, переход в Instagram 4, комментарий или отзыв 5, кадр «для Instagram» 5, архив подборки 8, весь архив или заявка на печать/лицензию 10.
      |  Одно действие одного посетителя — раз в сутки, не больше 20 очков от человека в день; каждые 7 дней вес действия падает вдвое.
      |  🔥🔥🔥 — верхние 10% #{v.kindPlural}, 🔥🔥 — следующие 20%.
.admin-section
  .admin-section-head
    h2.admin-title ПРОСМОТРЫ
    .stats-period
      each d in [7, 30, 90]
        a.admin-link(href='#stats' data-stats-days=d class=days === d ? 'active' : '') #{d}Д
  .admin-grid
    .admin-stat
      span.admin-stat-count= s.total.page
      span.admin-stat-label #{v.pageLabel} · #{days} дн.
    .admin-stat
      span.admin-stat-count= s.total.photos
      span.admin-stat-label кадры · #{days} дн.
    .admin-stat
      span.admin-stat-count= s.visitors
      span.admin-stat-label уникальных посетителей (по IP)
    .admin-stat
      span.admin-stat-count= allTime.page + allTime.photos
      span.admin-stat-label за всё время (страница #{allTime.page} + кадры #{allTime.photos})
  if s.bots
    p.admin-hint(style='margin-top:12px') Боты и превью-ботов мессенджеров не учитываются: #{s.bots} за период.

  h3.admin-subtitle ПО ДНЯМ
  if !periodTotal
    p.admin-hint За #{days} дн. просмотров нет.
  else
    p.admin-hint.shoot-stats-legend
      span
        span.shoot-stats-key.shoot-stats-key--page
        |  страница
      span
        span.shoot-stats-key.shoot-stats-key--photos
        |  кадры
    //- one column per day (stacked: frames under the page), max = s.maxDay; hover shows the numbers
    .shoot-stats-cols-chart
      span.shoot-stats-max= s.maxDay
      each item in s.allDays
        .shoot-stats-col(title=`${item.day}: страница ${item.page}, кадры ${item.photos}`)
          if item.page
            .shoot-stats-seg.shoot-stats-key--page(style=`height:${item.page / s.maxDay * 100}%`)
          if item.photos
            .shoot-stats-seg.shoot-stats-key--photos(style=`height:${item.photos / s.maxDay * 100}%`)
    .shoot-stats-axis
      span= s.allDays[0].day.slice(5)
      span= s.allDays[s.allDays.length - 1].day.slice(5)

.admin-section
  h2.admin-title ОТКУДА И С ЧЕГО
  .shoot-stats-cols
    div
      h3.admin-subtitle ИСТОЧНИКИ
      if s.referers.length
        each r in s.referers
          .stats-entity-row
            span.stats-entity-label= r.key
            span.stats-entity-count= r.count
      else
        p.admin-hint Нет данных.
    div
      h3.admin-subtitle УСТРОЙСТВА
      each count, type in s.devices
        if count
          .stats-entity-row
            span.stats-entity-label= {desktop: 'компьютер', mobile: 'телефон', tablet: 'планшет', unknown: 'неизвестно'}[type]
            span.stats-entity-count #{count} · #{pct(count, periodTotal)}%
      h3.admin-subtitle ЯЗЫК ВЕРСИИ
      .stats-entity-row
        span.stats-entity-label RU
        span.stats-entity-count #{s.lang.ru} · #{pct(s.lang.ru, periodTotal)}%
      .stats-entity-row
        span.stats-entity-label EN
        span.stats-entity-count #{s.lang.en} · #{pct(s.lang.en, periodTotal)}%

.admin-section
  h2.admin-title ПОПУЛЯРНЫЕ КАДРЫ · #{days} ДН.
  if s.topPhotos.length
    each t in s.topPhotos
      - var p = photosById[t.id]
      .stats-entity-row
        if p && p.urls
          img.shoot-stats-thumb(src=p.urls.thumb || p.urls.preview alt='' loading='lazy')
        span.stats-entity-label
          a(href=v.frameEditBase + t.id + '/edit')= (p && p.title) || t.id
        span.stats-entity-count= t.count
        a.stats-entity-drill(href=`/admin/stats/entity?type=${v.frameType}&id=${encodeURIComponent(v.framePrefix + t.id)}&days=${days}`) график →
  else
    p.admin-hint Кадры за период не открывали.

.admin-section
  h2.admin-title ДЕЙСТВИЯ ПОСЕТИТЕЛЕЙ
  if v.actionsHint
    p.admin-hint= v.actionsHint
  .admin-grid
    each a in v.actions
      .admin-stat(class=a.count ? '' : 'is-zero')
        span.admin-stat-count= a.count
        span.admin-stat-label= a.label
  p.admin-hint(style='margin-top:12px')
    a(href=`/admin/stats/entity?type=${v.pageType}&id=${encodeURIComponent(v.pageId)}&days=${days}`) → график страницы
    | &nbsp;·&nbsp;
    a(href='/admin/feedback') → все комментарии и отметки
