//- Base layout of the photo admin. Pages: `extends layout` and fill the blocks.
//- block vars — page variables and mixin includes (an extending template allows only blocks at
//-   the top level): `- var nav = '<key from lib/photo-admin-nav.js>'`.
//- block head — extra <head> content; block breadcrumbs / block actions — page header;
//- block content — the page; block scripts — end of <body>.
block vars
doctype html
html(data-theme='dark' lang='ru')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(name='robots' content='noindex,nofollow')
    title= title || 'AERO Admin'
    link(rel='stylesheet' href='/stylesheets/photo/style.css')
    link(rel='stylesheet' href='/stylesheets/photo/admin.css')
    block head
  body.admin
    .adm
      aside.adm-side#adm-side
        a.adm-logo(href='/admin') AERO
          small photo.dimazvali.com
        button.adm-burger(type='button' aria-label='меню' aria-controls='adm-side' aria-expanded='false' onclick="var s=document.getElementById('adm-side');var o=s.classList.toggle('is-open');this.setAttribute('aria-expanded',o)") ☰
        nav.adm-nav(aria-label='Разделы админки')
          each g in adminNav(typeof nav === 'undefined' ? null : nav)
            .adm-nav-group
              span.adm-nav-label= g.label
              each item in g.items
                a.adm-nav-link(href=item.href class=item.active ? 'is-active' : undefined)= item.label
        .adm-side-foot
          a.adm-nav-link(href='/admin/logout') выйти
      main.adm-main
        header.adm-head
          .adm-crumbs
            block breadcrumbs
              span= title
          .adm-actions
            block actions
        block content
    block scripts
