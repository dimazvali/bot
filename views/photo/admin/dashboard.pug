extends layout
block vars
  include _heat.pug
  - var nav = 'dashboard'
  mixin viewsStat(p, label, prevLabel)
    a.admin-stat(href='/admin/stats?days=7')
      span.admin-stat-count= p.count
      span.admin-stat-label= label
      if p.deltaPct == null
        span.admin-delta нет данных за #{prevLabel}
      else
        span.admin-delta(class=p.deltaPct > 0 ? 'admin-delta--up' : p.deltaPct < 0 ? 'admin-delta--down' : undefined)
          = (p.deltaPct > 0 ? '▲ +' : p.deltaPct < 0 ? '▼ ' : '') + p.deltaPct + '%'
          span.admin-delta-base  · #{prevLabel}: #{p.prev}
block breadcrumbs
  span Дашборд
block actions
  a.admin-btn.admin-btn--primary(href='/admin/shoots#create') ＋ новая съёмка
block content
  .admin-section
    .admin-section-head
      h2.admin-title Просмотры
      a.admin-link(href='/admin/stats') статистика
    if dashboard.views
      .admin-grid
        +viewsStat(dashboard.views.today, 'сегодня', 'вчера к этому времени')
        +viewsStat(dashboard.views.week, 'за 7 дней', 'предыдущие 7 дней')
    else
      p.admin-hint Не удалось загрузить просмотры.
  .admin-section
    .admin-section-head
      h2.admin-title Горячие сейчас
      span
        a.admin-link(href='/admin/shoots?sort=heat') съёмки по горячести
        | &nbsp;
        a.admin-link(href='/admin/series') серии и страны
    if dashboard.hot == null
      p.admin-hint Не удалось посчитать горячесть.
    else if !dashboard.hot.shoots.length && !dashboard.hot.series.length && !dashboard.hot.frames.length
      p.admin-hint За последние недели активности нет.
    else
      each group in [['Съёмки', dashboard.hot.shoots], ['Серии галереи', dashboard.hot.series], ['Кадры', dashboard.hot.frames]]
        if group[1].length
          h3.admin-subtitle= group[0]
          .admin-grid(class=group[0] === 'Кадры' ? 'admin-grid--frames' : undefined)
            each s in group[1]
              a.admin-card(href=s.href)
                .admin-card-cover(style=s.cover ? `background-image:url('${s.cover}')` : undefined)
                .admin-card-body
                  span.admin-card-title= s.label
                  if s.sub
                    span.admin-card-meta= s.sub
                  +heatBadge(s)
  .admin-section
    .admin-section-head
      h2.admin-title Требует внимания
    .admin-grid
      each a in dashboard.attention
        a.admin-stat(href=a.href class=a.count ? undefined : 'is-zero')
          span.admin-stat-count= a.count == null ? '—' : a.count
          span.admin-stat-label= a.label
  .admin-section
    .admin-section-head
      h2.admin-title Последние съёмки
      a.admin-link(href='/admin/shoots') все съёмки
    if !dashboard.recentShoots.length
      p.admin-hint Съёмок пока нет.
    .admin-grid
      each s in dashboard.recentShoots
        a.admin-card(href=`/admin/shoots/${s.slug}/edit`)
          .admin-card-cover(style=s.cover ? `background-image:url('${s.cover}')` : undefined)
          .admin-card-body
            span.admin-card-title= s.label
            span.admin-card-meta
              span #{s.photoCount} фото
              span.admin-badge(class=s.public ? 'admin-badge--public' : 'admin-badge--closed')= s.public ? 'публичная' : 'закрыта'
              if s.hasPassword
                span.admin-badge 🔑
