extends layout
block vars
  - var nav = 'tags'
block breadcrumbs
  span Теги
block content
  .admin-section
    h2.admin-title ДОБАВИТЬ ТЕГ
    form.admin-form(method='POST' action='/admin/tags')
      input.admin-input(type='text' name='slug' placeholder='slug (eng, напр. sunrise)' required)
      input.admin-input(type='text' name='label' placeholder='метка (напр. Рассвет)' required)
      input.admin-input(type='text' name='label_en' placeholder='label (EN)')
      select.admin-input(name='type')
        each label, key in typeLabels
          option(value=key selected=key === 'misc')= label
      button.admin-btn.admin-btn--primary(type='submit') + тег
    p.admin-hint После создания откроется страница тега — там описание и остальные поля.

  .admin-section
    h2.admin-title ВСЕ ТЕГИ (#{rows.length})
    if !rows.length
      p.admin-hint Тегов пока нет.
    else
      table.admin-table
        thead
          tr
            th.admin-table-sortable(data-type='text') Метка
            th.admin-table-sortable(data-type='text') Slug
            th.admin-table-sortable(data-type='text') Тип
            th.admin-table-sortable(data-type='number') Фото
            th.admin-table-sortable(data-type='number') Съёмки
            th Публичная
            th
        tbody
          each r in rows
            tr
              td(data-value=r.label)
                a(href=`/admin/tags/${r.slug}`)
                  b= r.label
                if r.label_en
                  .admin-hint(style='margin:0')= r.label_en
              td(data-value=r.slug)
                span.admin-photo-id= r.slug
              td(data-value=r.type)
                span.admin-badge= typeLabels[r.type] || r.type
              td(data-value=r.photos)= r.photos
              td(data-value=r.shoots)= r.shoots
              td
                .admin-table-actions
                  a.admin-link(href=`/tag/${r.slug}` target='_blank' rel='noopener') RU ↗
                  a.admin-link(href=`/en/tag/${r.slug}` target='_blank' rel='noopener') EN ↗
              td
                a.admin-link(href=`/admin/tags/${r.slug}`) редактировать
block scripts
  script(src='/javascripts/photo/admin-table-sort.js')
