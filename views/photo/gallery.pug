extends layout
include mixins

block head
  -
    var _mapEligible = isShoot || (activeCountry && activeSeries)
    var _mapLp = lang === 'en' ? '/en' : ''
    var _mapPoints = _mapEligible ? (photos || []).filter(function(p) { return p.coords; }).map(function(p) {
      return {
        lat: p.coords.lat,
        lng: p.coords.lng,
        title: p.title,
        href: isShoot ? (_mapLp + '/shoot/' + shootSlug + '/' + p.id) : (_mapLp + '/' + p.countryKey + '/' + p.seriesKey + '/' + p.id),
      }
    }) : []
  if _mapPoints.length
    link(rel='stylesheet' href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css' integrity='sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H' crossorigin='anonymous')
    script(src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js' integrity='sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH' crossorigin='anonymous')
  if ogUrl && photos && photos.length
    -
      var _lp = lang === 'en' ? '/en' : ''
      var _base = 'https://photo.dimazvali.com'
      var _galleryLd = {
        '@context': 'https://schema.org',
        '@type': 'ImageGallery',
        name: title,
        description: desc,
        url: ogUrl,
        numberOfItems: photos.length,
        image: photos.slice(0, 60).map(function(p) {
          var src = p.urls ? (p.urls.full || p.urls.preview) : null
          if (!src) return null
          var pageUrl = isShoot
            ? _base + _lp + '/shoot/' + shootSlug + '/' + p.id
            : _base + _lp + '/' + p.countryKey + '/' + p.seriesKey + '/' + p.id
          return { '@type': 'ImageObject', contentUrl: src, name: p.title, url: pageUrl }
        }).filter(Boolean),
      }
    script#ld-gallery(type='application/ld+json')!= JSON.stringify(_galleryLd)

block content
  - var LP = lang === 'en' ? '/en' : ''
  if isShoot
    .shoot-crumb

  .gallery-header.gallery-header--sticky
    if isShoot
      .gallery-header-left
        a.gallery-back(href=`${LP}/shoot`) ← #{ui.allShoots}
        span.gallery-label #{shootLabel.toUpperCase()} · #{photos.length} #{ui.photosSuffix}
      .gallery-header-right
        a.gallery-download(href=`${LP}/shoot/${shootSlug}/download`)= ui.download
        button.gallery-shuffle(onclick='shuffleMasonry()')= ui.shuffle
        button.gallery-shuffle(onclick='startPresentation()')= ui.present
        if _mapPoints.length
          button.gallery-shuffle.gallery-map-trigger(type='button')= ui.mapToggle
    else if activeCountry && activeSeries
      - const country = data[activeCountry]
      - const series = country.series[activeSeries]
      span.gallery-label #{country.label.toUpperCase()} · #{series.label.toUpperCase()} · #{photos.length} #{ui.photosSuffix}
      .gallery-header-right
        button.gallery-shuffle(onclick='shuffleMasonry()')= ui.shuffle
        button.gallery-shuffle(onclick='startPresentation()')= ui.present
        if _mapPoints.length
          button.gallery-shuffle.gallery-map-trigger(type='button')= ui.mapToggle
        if isAdmin
          a.admin-bar-btn(href=`/admin/${activeCountry}/${activeSeries}/upload`)= ui.addPhoto
          a.admin-bar-btn(href=`/admin/${activeCountry}/${activeSeries}/edit`)= ui.editSeries
    else if activeCountry
      - const country = data[activeCountry]
      span.gallery-label #{country.label.toUpperCase()} · #{photos.length} #{ui.photosSuffix}
      .gallery-header-right
        button.gallery-shuffle(onclick='shuffleMasonry()')= ui.shuffle
    else
      span.gallery-label #{ui.allWorks} · #{photos.length} #{ui.photosSuffix}
  if _mapPoints.length
    #gallery-map-panel.gallery-map-panel(style='display:none')
      #gallery-map.gallery-map-canvas
    script#gallery-map-data(type='application/json')!= JSON.stringify(_mapPoints)
  if isShoot && peopleGroups && peopleGroups.length
    .faces-widget#faces-widget
      each g in peopleGroups
        - var rf = g.faces[0]
        - var dw = 100 / rf.boundingBox.Width
        - var dh = 100 / rf.boundingBox.Height
        - var lp = -(rf.boundingBox.Left / rf.boundingBox.Width) * 100
        - var tp = -(rf.boundingBox.Top / rf.boundingBox.Height) * 100
        button.faces-widget-item(type='button' data-person-key=g.key)
          .faces-widget-avatar
            img(src=rf.thumb alt=g.name||'' title=g.name||undefined style=`width:${dw}%;height:${dh}%;left:${lp}%;top:${tp}%;`)
          if g.name
            span.faces-widget-name= g.name
      button.faces-widget-reset(type='button')= ui.allFaces
  if isShoot
    .shoot-collections#shoot-collections(style='display:none')
      span.gallery-label= ui.yourSelections
      .shoot-collections-list#shoot-collections-list
  -
    var _types = photos.reduce(function(s,p){ s.add(p.type||'copter'); return s; }, new Set());
    var _showFilter = _types.size > 1;
    var _photoUserSubscribed = typeof photoUser !== 'undefined' && photoUser && photoUser.subscribed
    // Feed action-card (map-view / subscribe tile) — disabled for now pending a
    // design pass; logic and markup stay in place, just force it off.
    var _actionCardEnabled = false
    var _actionCardType = _actionCardEnabled ? (_mapPoints.length ? 'map' : (!_photoUserSubscribed ? 'subscribe' : null)) : null
    var _faceKeyByFaceId = {};
    if (isShoot && peopleGroups) {
      peopleGroups.forEach(function(g) {
        g.faces.forEach(function(f) { _faceKeyByFaceId[f.faceId] = g.key; });
      });
    }
  if !isShoot && activeTags && activeTags.length
    .gallery-tags
      each tag in activeTags
        a.gallery-tag(href=`${LP}/tag/${tag.key}`) #{tag.label.toUpperCase()}
  if _showFilter
    .type-filter
      each t in ['copter','camera','mobile']
        if _types.has(t)
          button.type-filter-btn(data-type=t title=t)
            +typeIcon(t)
  .masonry
    - var _igCardAt = !isShoot ? Math.floor(Math.random() * (photos.length + 1)) : -1
    - var _actionCardAt = _actionCardType ? Math.floor(Math.random() * (photos.length + 1)) : -1
    each photo, _pi in photos
      if _pi === _igCardAt
        +instagramCard()
      if _pi === _actionCardAt
        +actionCard(_actionCardType)
      a.photo-card(
        href=isShoot ? `${LP}/shoot/${shootSlug}/${photo.id}` : `${LP}/${photo.countryKey}/${photo.seriesKey}/${photo.id}`
        data-type=photo.type||'copter'
        data-photo-id=photo.id
        data-full=photo.urls ? (photo.urls.full || photo.urls.preview) : undefined
        data-person-keys=(isShoot && photo.faces && photo.faces.length) ? Array.from(new Set(photo.faces.map(function(f) { return _faceKeyByFaceId[f.faceId]; }).filter(Boolean))).join(',') : undefined
        data-curator-hidden=photo._curatorExtra ? '' : undefined
      )
        if isShoot
          span.photo-select
            span.photo-select-box
        img(
          src=photo.urls ? photo.urls.preview : `/images/photo/${photo.countryKey}/${photo.seriesKey}/${photo.file}`
          srcset=photo.urls ? `${photo.urls.thumb || photo.urls.preview} 400w, ${photo.urls.preview} 800w` : undefined
          sizes=photo.urls ? '(max-width: 640px) calc(50vw - 12px), 400px' : undefined
          alt=photo.title
          title=photo.desc||photo.title
          width=photo.width||undefined
          height=photo.height||undefined
          loading='lazy'
          style=photo.width && photo.height ? `aspect-ratio:${photo.width}/${photo.height}` : undefined
          onerror="this.style.background='#1e1e1e';this.removeAttribute('src')"
        )
        .photo-overlay
          span.photo-title= photo.title
          if photo.date
            span.photo-date= photo.date
    if _igCardAt === photos.length
      +instagramCard()
    if _actionCardAt === photos.length
      +actionCard(_actionCardType)

  if isShoot || (activeCountry && activeSeries)
    .presentation-overlay#presentation-overlay
      button.presentation-close#presentation-close(type='button' aria-label=ui.cancel) ×
      img.presentation-img#presentation-img(alt='')

  if curatorSelectionActive
    button.curator-show-all#curator-show-all(type='button')= ui.showAllPhotos
    script.
      (function() {
        var btn = document.getElementById('curator-show-all');
        if (!btn) return;
        btn.addEventListener('click', function() {
          document.querySelectorAll('.photo-card[data-curator-hidden]').forEach(function(c) { c.removeAttribute('data-curator-hidden'); });
          btn.remove();
        });
      }());

  if isShoot && otherShoots && otherShoots.length
    .gallery-header
      span.gallery-label= otherShootsAreRelated ? ui.relatedShoots : ui.otherShoots
    .shoot-related
      each other in otherShoots
        - var cover = other.photos[0]
        a.shoot-related-card(href=`${LP}/shoot/${other.key}`)
          if cover
            img(
              src=cover.urls ? cover.urls.preview : undefined
              srcset=cover.urls ? `${cover.urls.thumb || cover.urls.preview} 400w, ${cover.urls.preview} 800w` : undefined
              sizes='(max-width: 640px) calc(50vw - 12px), 240px'
              alt=other.label
              title=other.label
              loading='lazy'
              onerror="this.style.background='#1e1e1e';this.removeAttribute('src')"
            )
          .photo-overlay
            span.photo-title= other.label.toUpperCase()
            span.photo-date= `${other.photos.length} ${ui.photosSuffix}`

  if isShoot
    .selection-popup#intro-popup
      .selection-popup-inner
        p.intro-popup-text= ui.introText
        .selection-popup-actions
          button#intro-popup-close(type='button')= ui.introClose

    .selection-bar#selection-bar
      span#selection-count
      .selection-bar-actions
        button#selection-download(type='button')= ui.download
        button#selection-clear(type='button')= ui.selectionClear
        button#selection-save(type='button')= ui.selectionSave

    .selection-popup#selection-popup
      .selection-popup-inner
        .selection-popup-form#selection-popup-form
          span.selection-popup-title= ui.selectionPopupTitle
          input#selection-name-input(type='text' placeholder=ui.namePlaceholderCollection maxlength='200')
          p#selection-popup-msg
          .selection-popup-actions
            button#selection-popup-cancel(type='button')= ui.cancel
            button#selection-popup-submit(type='button')= ui.save
        .selection-popup-success#selection-popup-success(style='display:none')
          p.selection-popup-success-text= ui.successText
          .selection-popup-actions
            button#selection-popup-close(type='button')= ui.ok

  if promo
    .selection-popup#promo-popup
      .selection-popup-inner.promo-popup-inner
        button.promo-popup-close#promo-popup-close(type='button' aria-label=ui.cancel) ×
        p.promo-popup-title= ui.promoTitle
        p.promo-popup-subtitle= ui.promoSubtitle
        form.inquiry-form#promo-form
          input.inquiry-input(type='text' name='name' placeholder=ui.nameCaps required autocomplete='name')
          input.inquiry-input(type='text' name='contact' placeholder=ui.promoContactPlaceholder required)
          textarea.inquiry-input.inquiry-textarea(name='message' placeholder=ui.messageOptional rows='3')
          p.inquiry-error#promo-form-msg(style='display:none')
          button.inquiry-submit(type='submit')= ui.promoSubmit
        .promo-popup-success#promo-popup-success(style='display:none')
          p.inquiry-success= ui.promoSuccessText
        .promo-contacts
          span.promo-contacts-label= ui.promoOrContact
          .promo-contacts-links
            a(href='https://telegram.me/dimazvali' target='_blank' rel='noopener') Telegram
            a(href='https://instagram.com/dimazvali2' target='_blank' rel='noopener') Instagram
            a(href='https://wa.me/995555542110' target='_blank' rel='noopener') WhatsApp

    button.promo-footer-bar#promo-footer-bar(type='button')= ui.promoFooterCta

    script.
      (function() {
        var popup = document.getElementById('promo-popup');
        if (!popup) return;
        var seenKey = 'photoPromoPopupSeen';
        var closeBtn = document.getElementById('promo-popup-close');
        var footerBar = document.getElementById('promo-footer-bar');
        var form = document.getElementById('promo-form');
        var msgEl = document.getElementById('promo-form-msg');
        var successView = document.getElementById('promo-popup-success');
        var submitBtn = form.querySelector('.inquiry-submit');
        var autoShown = false;

        try { autoShown = !!sessionStorage.getItem(seenKey); } catch (e) {}

        function showPopup() { popup.classList.add('is-open'); }

        function autoOpen() {
          if (autoShown) return;
          autoShown = true;
          try { sessionStorage.setItem(seenKey, '1'); } catch (e) {}
          showPopup();
          window.removeEventListener('scroll', onScroll);
          clearTimeout(timer);
        }

        function closePopup() { popup.classList.remove('is-open'); }

        function onScroll() {
          if (window.scrollY > window.innerHeight) autoOpen();
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        var timer = setTimeout(autoOpen, 5000);

        if (footerBar) footerBar.addEventListener('click', showPopup);
        if (closeBtn) closeBtn.addEventListener('click', closePopup);
        popup.addEventListener('click', function(e) { if (e.target === popup) closePopup(); });

        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var name = form.name.value.trim();
          var contact = form.contact.value.trim();
          if (!name || !contact) { msgEl.textContent = !{JSON.stringify(ui.promoError)}; msgEl.style.display = ''; return; }

          submitBtn.disabled = true;
          msgEl.style.display = 'none';
          fetch('/shoot-request', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
              name: name,
              contact: contact,
              message: form.message.value.trim(),
              source: window.location.pathname,
            }),
          })
            .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
            .then(function(res) {
              submitBtn.disabled = false;
              if (!res.ok) { msgEl.textContent = !{JSON.stringify(ui.networkError)}; msgEl.style.display = ''; return; }
              form.style.display = 'none';
              successView.style.display = '';
            })
            .catch(function() {
              submitBtn.disabled = false;
              msgEl.textContent = !{JSON.stringify(ui.networkError)};
              msgEl.style.display = '';
            });
        });
      }());

  if isShoot
    script.
      (function() {
        var introKey = 'photoShootIntroSeen';
        var introPopup = document.getElementById('intro-popup');
        var introClose = document.getElementById('intro-popup-close');
        if (introPopup) {
          var seen = true;
          try { seen = !!localStorage.getItem(introKey); } catch (e) {}
          if (!seen) introPopup.classList.add('is-open');
          function dismissIntro() {
            introPopup.classList.remove('is-open');
            try { localStorage.setItem(introKey, '1'); } catch (e) {}
          }
          if (introClose) introClose.addEventListener('click', dismissIntro);
          introPopup.addEventListener('click', function(e) { if (e.target === introPopup) dismissIntro(); });
        }
      }());

  if isShoot
    script.
      (function() {
        var saveUrl = '/shoot/' + !{JSON.stringify(shootSlug)} + '/collections';
        var storageKey = 'shootSelection:' + !{JSON.stringify(shootSlug)};
        var savedKey = 'shootCollections:' + !{JSON.stringify(shootSlug)};
        var selected = {};

        function loadSavedCollections() {
          try {
            var raw = localStorage.getItem(savedKey);
            return raw ? JSON.parse(raw) : [];
          } catch (e) { return []; }
        }
        function saveSavedCollections(list) {
          try { localStorage.setItem(savedKey, JSON.stringify(list.slice(-20))); } catch (e) {}
        }

        function loadStored() {
          try {
            var raw = sessionStorage.getItem(storageKey);
            return raw ? JSON.parse(raw) : {};
          } catch (e) { return {}; }
        }
        function saveStored() {
          try { sessionStorage.setItem(storageKey, JSON.stringify(selected)); } catch (e) {}
        }

        var bar      = document.getElementById('selection-bar');
        var countEl  = document.getElementById('selection-count');
        var popup    = document.getElementById('selection-popup');
        var formView = document.getElementById('selection-popup-form');
        var successView = document.getElementById('selection-popup-success');
        var nameInput = document.getElementById('selection-name-input');
        var msgEl    = document.getElementById('selection-popup-msg');
        var saveBtn  = document.getElementById('selection-save');
        var downloadBtn = document.getElementById('selection-download');
        var clearBtn = document.getElementById('selection-clear');
        var cancelBtn = document.getElementById('selection-popup-cancel');
        var submitBtn = document.getElementById('selection-popup-submit');
        var closeBtn = document.getElementById('selection-popup-close');

        function closePopup() {
          popup.classList.remove('is-open');
          formView.style.display = '';
          successView.style.display = 'none';
        }

        function selectedIds() {
          return Object.keys(selected).filter(function(id) { return selected[id]; });
        }

        function updateBar() {
          var ids = selectedIds();
          if (bar) bar.classList.toggle('is-open', ids.length > 0);
          if (countEl) countEl.textContent = !{JSON.stringify(ui.selectionCount)} + ' ' + ids.length;
        }

        function clearSelection() {
          selected = {};
          saveStored();
          document.querySelectorAll('.photo-select.is-checked').forEach(function(el) { el.classList.remove('is-checked'); });
          document.querySelectorAll('.photo-card.is-selected').forEach(function(el) { el.classList.remove('is-selected'); });
          updateBar();
        }

        function applySelection(ids) {
          clearSelection();
          document.querySelectorAll('.photo-card[data-photo-id]').forEach(function(card) {
            var id = card.dataset.photoId;
            if (ids.indexOf(id) === -1) return;
            selected[id] = true;
            card.classList.add('is-selected');
            var box = card.querySelector('.photo-select');
            if (box) box.classList.add('is-checked');
          });
          saveStored();
          updateBar();
        }

        var collectionsWrap = document.getElementById('shoot-collections');
        var collectionsList = document.getElementById('shoot-collections-list');

        function renderSavedCollections() {
          if (!collectionsWrap || !collectionsList) return;
          var list = loadSavedCollections();
          if (!list.length) { collectionsWrap.style.display = 'none'; return; }
          collectionsList.innerHTML = '';
          list.forEach(function(c) {
            var chip = document.createElement('button');
            chip.type = 'button';
            chip.className = 'shoot-collection-chip';
            chip.textContent = c.name + ' · ' + c.count + ' ' + !{JSON.stringify(ui.photosSuffix)};
            chip.addEventListener('click', function() { applySelection(c.photoIds || []); });
            collectionsList.appendChild(chip);
          });
          collectionsWrap.style.display = '';
        }
        renderSavedCollections();

        document.querySelectorAll('.photo-select').forEach(function(el) {
          el.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var card = el.closest('.photo-card');
            var id = card.dataset.photoId;
            selected[id] = !selected[id];
            el.classList.toggle('is-checked', !!selected[id]);
            card.classList.toggle('is-selected', !!selected[id]);
            saveStored();
            updateBar();
          });
        });

        // restore selection saved before navigating away (e.g. to a photo detail page)
        (function restore() {
          var stored = loadStored();
          var restored = false;
          document.querySelectorAll('.photo-card[data-photo-id]').forEach(function(card) {
            var id = card.dataset.photoId;
            if (!stored[id]) return;
            selected[id] = true;
            restored = true;
            card.classList.add('is-selected');
            var box = card.querySelector('.photo-select');
            if (box) box.classList.add('is-checked');
          });
          if (restored) { saveStored(); updateBar(); }
        }());

        if (downloadBtn) downloadBtn.addEventListener('click', function() {
          var ids = selectedIds();
          if (!ids.length) return;
          window.location.href = saveUrl.replace(/\/collections$/, '/download') + '?ids=' + encodeURIComponent(ids.join(','));
        });

        if (clearBtn) clearBtn.addEventListener('click', clearSelection);

        if (saveBtn) saveBtn.addEventListener('click', function() {
          nameInput.value = '';
          msgEl.textContent = '';
          formView.style.display = '';
          successView.style.display = 'none';
          popup.classList.add('is-open');
          nameInput.focus();
        });

        if (cancelBtn) cancelBtn.addEventListener('click', closePopup);
        if (closeBtn) closeBtn.addEventListener('click', closePopup);
        if (popup) popup.addEventListener('click', function(e) { if (e.target === popup) closePopup(); });

        if (submitBtn) submitBtn.addEventListener('click', function() {
          var name = nameInput.value.trim();
          if (!name) { msgEl.textContent = !{JSON.stringify(ui.enterNameError)}; return; }
          var ids = selectedIds();
          if (!ids.length) { popup.classList.remove('is-open'); return; }

          submitBtn.disabled = true;
          msgEl.textContent = '';
          fetch(saveUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name, photoIds: ids }),
          })
            .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
            .then(function(res) {
              submitBtn.disabled = false;
              if (!res.ok) { msgEl.textContent = (res.data && res.data.error) || !{JSON.stringify(ui.saveError)}; return; }
              var savedList = loadSavedCollections();
              savedList.push({ id: res.data.id, name: name, count: ids.length, photoIds: ids, createdAt: Date.now() });
              saveSavedCollections(savedList);
              renderSavedCollections();
              clearSelection();
              formView.style.display = 'none';
              successView.style.display = '';
            })
            .catch(function() {
              submitBtn.disabled = false;
              msgEl.textContent = !{JSON.stringify(ui.networkError)};
            });
        });
      }());

  if _showFilter
    script.
      (function() {
        var btns = document.querySelectorAll('.type-filter-btn');
        var cards = document.querySelectorAll('.photo-card[data-type]');
        var active = null;
        btns.forEach(function(btn) {
          btn.addEventListener('click', function() {
            var t = btn.dataset.type;
            if (active === t) {
              active = null;
              btns.forEach(function(b){ b.classList.remove('active'); });
              cards.forEach(function(c){ c.removeAttribute('data-hidden'); });
            } else {
              active = t;
              btns.forEach(function(b){ b.classList.toggle('active', b.dataset.type === t); });
              cards.forEach(function(c){ c.toggleAttribute('data-hidden', c.dataset.type !== t); });
            }
          });
        });
      }());

  if isShoot && peopleGroups && peopleGroups.length
    script.
      (function() {
        var widget = document.getElementById('faces-widget');
        if (!widget) return;
        var items = widget.querySelectorAll('.faces-widget-item');
        var resetBtn = widget.querySelector('.faces-widget-reset');
        var cards = document.querySelectorAll('.photo-card[data-person-keys]');
        var active = null;

        function applyFilter(key) {
          active = key;
          if (key) {
            widget.setAttribute('data-active', '');
            items.forEach(function(el) { el.classList.toggle('is-active', el.dataset.personKey === key); });
          } else {
            widget.removeAttribute('data-active');
            items.forEach(function(el) { el.classList.remove('is-active'); });
          }
          cards.forEach(function(c) {
            var keys = (c.dataset.personKeys || '').split(',');
            c.toggleAttribute('data-hidden', !!key && keys.indexOf(key) === -1);
          });
        }

        items.forEach(function(el) {
          el.addEventListener('click', function() {
            var key = el.dataset.personKey;
            var next = active === key ? null : key;
            applyFilter(next);
            var url = new URL(window.location.href);
            if (next) { url.searchParams.set('person', next); } else { url.searchParams.delete('person'); }
            history.pushState({}, '', url);
          });
        });

        if (resetBtn) {
          resetBtn.addEventListener('click', function() {
            applyFilter(null);
            var url = new URL(window.location.href);
            url.searchParams.delete('person');
            history.pushState({}, '', url);
          });
        }

        var initial = new URLSearchParams(window.location.search).get('person');
        if (initial) applyFilter(initial);
      }());
