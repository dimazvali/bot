mixin typeIcon(type)
  if type === 'camera'
    svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round')
      path(d='M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z')
      circle(cx='12' cy='13' r='4')
  else if type === 'mobile'
    svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round')
      rect(x='5' y='2' width='14' height='20' rx='2' ry='2')
      circle(cx='12' cy='17' r='1' fill='currentColor' stroke='none')
  else
    svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round')
      rect(x='9' y='9' width='6' height='6' rx='1')
      line(x1='9' y1='9' x2='4' y2='4')
      line(x1='15' y1='9' x2='20' y2='4')
      line(x1='9' y1='15' x2='4' y2='20')
      line(x1='15' y1='15' x2='20' y2='20')
      circle(cx='3' cy='3' r='2')
      circle(cx='21' cy='3' r='2')
      circle(cx='3' cy='21' r='2')
      circle(cx='21' cy='21' r='2')

mixin instagramCard()
  .photo-card.photo-card--promo
    a.photo-card-promo-link(href='https://www.instagram.com/dimazvali2' target='_blank' rel='noopener')
      img.photo-card-promo-img(
        src='https://storage.googleapis.com/photo-dimazvalimisc/images/ks-05065-1780908582473-800.webp'
        alt=ui.igAlt
        title=ui.igAlt
        loading='lazy'
        onerror="this.style.background='#1e1e1e';this.removeAttribute('src')"
      )
      .photo-card-promo-icon
        svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round')
          rect(x='2' y='2' width='20' height='20' rx='5' ry='5')
          path(d='M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z')
          line(x1='17.5' y1='6.5' x2='17.51' y2='6.5')
      .photo-overlay
        span.photo-title= ui.igOverlay
    button.photo-card-promo-close(type='button' aria-label=ui.cancel) ×

mixin actionCard(kind)
  if kind === 'map'
    button.photo-card.action-card.gallery-map-trigger(type='button')
      .action-card-icon
        svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round')
          path(d='M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2z')
          path(d='M9 4v14')
          path(d='M15 6v14')
      span.action-card-text= ui.mapToggle
  else if kind === 'subscribe'
    .photo-card.action-card
      .action-card-icon
        svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round')
          path(d='M4 4h16v16H4z')
          path(d='M4 6l8 7 8-7')
      span.action-card-text= ui.subscribeBtn
      .action-card-actions
        button.subscribe-email-btn(type='button')= ui.byEmail
        a(href='https://telegram.me/dimazvalibot?start=photo_sub' target='_blank' rel='noopener')= ui.byTelegram
