doctype html
- var LP = lang === 'en' ? '/en' : ''
- var ALT_LP = lang === 'en' ? '' : '/en'
html(data-theme='dark' lang=lang || 'ru')
  head
    title= title
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    - var _desc = desc || (lang === 'en' ? 'Aerial photography — Dmitry Shestakov' : 'Аэрофотосъёмка — Дмитрий Шестаков')
    meta(name='description' content=_desc)
    if noindex
      meta(name='robots' content='noindex,nofollow')
    if keywords
      meta(name='keywords' content=keywords)
    meta(property='og:title' content=title)
    meta(property='og:description' content=_desc)
    meta(property='og:type' content='website')
    meta(property='og:site_name' content='photo.dimazvali.com')
    if ogImage
      meta(property='og:image' content=ogImage)
    if ogUrl
      meta(property='og:url' content=ogUrl)
      link(rel='canonical' href=ogUrl)
      -
        // Built structurally from currentPath (the clean, unprefixed path — set
        // server-side from req.path after the /en prefix is stripped), not by
        // string-replacing ogUrl: a substring replace would silently mangle the
        // URL for any future country/series/tag whose key happens to start with
        // "en" (e.g. "england"), since '/en' has no path-boundary awareness.
        var _ruUrl = 'https://photo.dimazvali.com' + (currentPath || '')
        var _enUrl = 'https://photo.dimazvali.com/en' + (currentPath || '')
      link(rel='alternate' hreflang='ru' href=_ruUrl)
      link(rel='alternate' hreflang='en' href=_enUrl)
      link(rel='alternate' hreflang='x-default' href=_ruUrl)
    meta(name='twitter:card' content='summary_large_image')
    if breadcrumbs && breadcrumbs.length
      - var _ldItems = [{"@type":"ListItem","position":1,"name":(lang === 'en' ? 'Home' : 'Главная'),"item":"https://photo.dimazvali.com" + LP + "/"}].concat(breadcrumbs.map(function(b,i){return{"@type":"ListItem","position":i+2,"name":b.name,"item":b.url};}))
      script(type='application/ld+json')!= JSON.stringify({"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":_ldItems})
    if googleClientId
      meta(name='google-client-id' content=googleClientId)
    block head
    link(rel='icon' href='/images/photo/ds_georgian.ico')
    link(rel='stylesheet' href='/stylesheets/photo/style.css')
    script(async src='https://www.googletagmanager.com/gtag/js?id=G-LDMN4XFB42')
    script.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LDMN4XFB42');
  body(data-series-url=seriesUrl || '')
    header.mobile-header
      button.burger#burger ☰
      a.mobile-logo(href='https://dimazvali.com') dimazvali.com
      a.lang-switch(href=ALT_LP + (currentPath || '')) #{ui.langSwitch}
      button.theme-toggle(onclick='toggleTheme()' title=ui.theme) ◐
    .mobile-colors
      each family, key in colorFamilies
        a.color-dot(
          href=`${LP}/color/${key}`
          title=family.label
          style=`background:${family.hex}`
          class=activeColorFamily===key?'active':''
        )
    .site
      aside.sidebar#sidebar
        .sidebar-logo
          a(href='https://dimazvali.com') dimazvali.com
          span Дмитрий Шестаков
        nav.sidebar-nav
          each country, countryKey in data
            if !country.archived
              - var seriesOrder = country.seriesOrder || Object.keys(country.series)
              a.nav-country(
                href=`${LP}/${countryKey}`
                class=activeCountry === countryKey ? 'open' : ''
              )
                span.arrow= activeCountry === countryKey ? '▾' : '▸'
                | &nbsp;
                = country.label.toUpperCase()
              if activeCountry === countryKey
                each seriesKey in seriesOrder
                  - var series = country.series[seriesKey]
                  if series && !series.archived
                    a.nav-series(
                      href=`${LP}/${countryKey}/${seriesKey}`
                      class=activeSeries === seriesKey ? 'active' : ''
                    ) #{series.label}
        .sidebar-colors
          each family, key in colorFamilies
            a.color-dot(
              href=`${LP}/color/${key}`
              title=family.label
              style=`background:${family.hex}`
              class=activeColorFamily===key?'active':''
            )
        .sidebar-footer
          .sidebar-contacts
            a(href='mailto:dimazvali@gmail.com') dimazvali@gmail.com
            a(href='https://telegram.me/dimazvali' target='_blank' rel='noopener') @dimazvali
            a(href='https://instagram.com/dimazvali2' target='_blank' rel='noopener') @dimazvali2
          if photoUser && photoUser.subscribed
            p.subscribe-msg= ui.subscribed
            button.subscribe-unsub#unsubscribe-google-btn(type='button')= ui.unsubscribeBtn
          else
            .subscribe-wrap
              p.subscribe-msg#subscribe-msg(style='display:none')
              button.subscribe-toggle#subscribe-toggle(type='button')= ui.subscribeBtn
              .subscribe-popup#subscribe-popup(style='display:none')
                button.subscribe-option#subscribe-email-btn(type='button')= ui.byEmail
                a.subscribe-option(href='https://telegram.me/dimazvalibot?start=photo_sub' target='_blank' rel='noopener')= ui.byTelegram
          .sidebar-footer-bottom
            //- a(href='/about') О СЕБЕ
            a.lang-switch(href=ALT_LP + (currentPath || '')) #{ui.langSwitch}
            button.theme-toggle(onclick='toggleTheme()' title=ui.theme) ◐
      .sidebar-overlay#sidebar-overlay
      main.main
        block content
    script(src='/javascripts/photo/i18n.js')
    script(src='/javascripts/photo/main.js')
    if googleClientId
      script(src='https://accounts.google.com/gsi/client' async defer)
      script(src='/javascripts/photo/subscribe.js' defer)
